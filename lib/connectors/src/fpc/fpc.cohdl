pub part CONN_FPC24_0P5: FPC24_0P5 {
    primary { mfr: "HRS", mpn: "FH12-24S-0.5SH(55)", footprint: FP_FPC24_0P5 }
}

#[doc("docs/README.md")]
pub part CONN_IPEX_MHF4: IPEX_MHF4 {
    primary { mfr: "Linx", mpn: "CONMHF4-SMD-G-T", footprint: FP_IPEX_MHF4 }
}

#[doc("docs/README.md")]
pub part CONN_BAT_2P: BAT_CONN_2P {
    primary { mfr: "JST", mpn: "S2B-XH-A(LF)(SN)", footprint: FP_BAT_2P_2P5 }
}

#[doc("docs/README.md")]
pub part CONN_MAG_4P: MAG_CONN_4P {
    primary { mfr: "Xinyangze", mpn: "YZP0048-20048-04025-03", footprint: FP_MAG_4P }
}

#[doc("docs/README.md")]
pub part CONN_MIC_2P: MIC_CONN_2P {
    primary { mfr: "Generic", mpn: "MEMS MIC 2P", footprint: FP_MIC_2P }
}

#[doc("docs/README.md")]
pub part CONN_DEBUG_10P: DEBUG_CONN_10P {
    primary { mfr: "HRS", mpn: "FH12-10S-0.5SH(55)", footprint: FP_FPC10_0P5 }
}

#[doc("docs/README.md")]
pub part CONN_SPK_2P: SPK_2P {
    primary { mfr: "Generic", mpn: "SPK 2P 1.25mm", footprint: FP_SPK_2P }
}

// 10-pin 0.5mm FPC land (HRS FH12-10S-0.5SH) — 0.3 x 0.7 mm pads at
// 0.5 mm pitch, two rows (contacts 1-10) per FH12 series.
pub pad P_FPC10_0P5_PAD {
    shape: rect
    size: (0.3mm, 0.7mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_FPC10_0P5 {
    pad 1: P_FPC10_0P5_PAD at (-2.25mm, 0mm)
    pad 2: P_FPC10_0P5_PAD at (-1.75mm, 0mm)
    pad 3: P_FPC10_0P5_PAD at (-1.25mm, 0mm)
    pad 4: P_FPC10_0P5_PAD at (-0.75mm, 0mm)
    pad 5: P_FPC10_0P5_PAD at (-0.25mm, 0mm)
    pad 6: P_FPC10_0P5_PAD at (0.25mm, 0mm)
    pad 7: P_FPC10_0P5_PAD at (0.75mm, 0mm)
    pad 8: P_FPC10_0P5_PAD at (1.25mm, 0mm)
    pad 9: P_FPC10_0P5_PAD at (1.75mm, 0mm)
    pad 10: P_FPC10_0P5_PAD at (2.25mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (6mm, 2.4mm) }
    silkscreen_ref { at: (0mm, -1.8mm) }
}

// 0.5mm-pitch FPC land: narrow SMD pad per contact.
pub pad P_FPC24_0P5_PAD {
    shape: rect
    size: (0.3mm, 0.7mm)
    layer: top_copper
    plating: smd
}

// IPEX MHF4 center contact: single circular SMD pad.
pub pad P_IPEX_MHF4_RF {
    shape: circle
    size: (1.0mm)
    layer: top_copper
    plating: smd
}

// Battery spring clip land: larger current-carrying SMD pad.
pub pad P_BAT_2P_PAD {
    shape: rect
    size: (1.2mm, 1.6mm)
    layer: top_copper
    plating: smd
}

// Magnetic pogo land: circular SMD pad.
pub pad P_MAG_4P_PAD {
    shape: circle
    size: (1.2mm)
    layer: top_copper
    plating: smd
}

// MEMS mic module land: rectangular SMD pad.
pub pad P_MIC_2P_PAD {
    shape: rect
    size: (0.8mm, 1.1mm)
    layer: top_copper
    plating: smd
}

// Debug/test-point land: rectangular SMD pad.
pub pad P_DEBUG_4P_PAD {
    shape: rect
    size: (0.9mm, 1.2mm)
    layer: top_copper
    plating: smd
}

// Speaker terminal land: slightly larger than the battery land for solder
// strain relief on the speaker wire.
pub pad P_SPK_2P_PAD {
    shape: rect
    size: (1.4mm, 1.6mm)
    layer: top_copper
    plating: smd
}

// 24 contacts on one side, 0.5mm pitch, centered on the origin:
// x = -5.75 + i*0.5 for pins 1-24.
pub footprint FP_FPC24_0P5 {
    pad 1: P_FPC24_0P5_PAD at (-5.75mm, 0mm)
    pad 2: P_FPC24_0P5_PAD at (-5.25mm, 0mm)
    pad 3: P_FPC24_0P5_PAD at (-4.75mm, 0mm)
    pad 4: P_FPC24_0P5_PAD at (-4.25mm, 0mm)
    pad 5: P_FPC24_0P5_PAD at (-3.75mm, 0mm)
    pad 6: P_FPC24_0P5_PAD at (-3.25mm, 0mm)
    pad 7: P_FPC24_0P5_PAD at (-2.75mm, 0mm)
    pad 8: P_FPC24_0P5_PAD at (-2.25mm, 0mm)
    pad 9: P_FPC24_0P5_PAD at (-1.75mm, 0mm)
    pad 10: P_FPC24_0P5_PAD at (-1.25mm, 0mm)
    pad 11: P_FPC24_0P5_PAD at (-0.75mm, 0mm)
    pad 12: P_FPC24_0P5_PAD at (-0.25mm, 0mm)
    pad 13: P_FPC24_0P5_PAD at (0.25mm, 0mm)
    pad 14: P_FPC24_0P5_PAD at (0.75mm, 0mm)
    pad 15: P_FPC24_0P5_PAD at (1.25mm, 0mm)
    pad 16: P_FPC24_0P5_PAD at (1.75mm, 0mm)
    pad 17: P_FPC24_0P5_PAD at (2.25mm, 0mm)
    pad 18: P_FPC24_0P5_PAD at (2.75mm, 0mm)
    pad 19: P_FPC24_0P5_PAD at (3.25mm, 0mm)
    pad 20: P_FPC24_0P5_PAD at (3.75mm, 0mm)
    pad 21: P_FPC24_0P5_PAD at (4.25mm, 0mm)
    pad 22: P_FPC24_0P5_PAD at (4.75mm, 0mm)
    pad 23: P_FPC24_0P5_PAD at (5.25mm, 0mm)
    pad 24: P_FPC24_0P5_PAD at (5.75mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (12.8mm, 2.8mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}

