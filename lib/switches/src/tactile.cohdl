pub trait Switch {
    designator_prefix: "SW"
}

#[doc("docs/xunpu-ts-1088r-02026.pdf")]
pub device TactileSwitchSPST {
    pins {
        required P1: 1 [passive]
        required P2: 2 [passive]
    }
}
impl Switch for TactileSwitchSPST {}

#[doc("docs/xunpu-ts-1088r-02026.pdf")]
pub part SW_XUNPU_TS_1088R_02026: TactileSwitchSPST {
    primary { mfr: "XUNPU", mpn: "TS-1088R-02026", footprint: FP_XUNPU_TS_1088R }
}

// Manufacturer PCB welding drawing: 5.50 mm outer span, 3.40 mm inner gap
// and 2.00 mm land height. Each land is therefore 1.05 x 2.00 mm, with
// centres 4.45 mm apart.
pub pad P_XUNPU_TS_1088R {
    shape: rect
    size: (1.05mm, 2.0mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_XUNPU_TS_1088R {
    pad 1: P_XUNPU_TS_1088R at (-2.225mm, 0mm)
    pad 2: P_XUNPU_TS_1088R at (2.225mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.0mm, 4.0mm) }
    silkscreen_ref { at: (0mm, -2.5mm) }
}
