    pad F11: P_BGA_Outer_H at (2.5mm, 0mm)
    pad G1: P_BGA_Outer_H at (-2.5mm, 0.5mm)
    pad G2: P_BGA_Inner at (-2mm, 0.5mm)
    pad G4: P_BGA_Inner at (-1mm, 0.5mm)
    pad G5: P_BGA_Inner at (-0.5mm, 0.5mm)
    pad G6: P_BGA_Inner at (0mm, 0.5mm)
