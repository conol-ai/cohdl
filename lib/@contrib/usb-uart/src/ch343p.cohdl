// WCH CH343: USB-to-UART bridge chip, USB 2.0 full-speed, up to 6Mbps
// (datasheet V1.6). QFN16_3X3 (CH343P). Pinout p2 (QFN column).

#[doc("docs/ch343.pdf")]
pub device CH343P {
    pins {
        required VIO: 1 [power_in] // I/O port power, decouple (p2)
        required GND: 2 [power_in] // required ground (p2)
        required VDD5: 3 [power_in] // regulator input, decouple (p2)
        optional TXD: 4 [output] // UART transmit, idle high (p2)
        optional RXD: 5 [input] // UART receive, internal pull-up (p2)
        optional V3: 6 [power_out] // internal regulator out; tie VDD5 if <3.6V (p2)
        optional UDP: 7 [bidirectional] // USB D+, direct connect (p2)
        optional UDN: 8 [bidirectional] // USB D-, direct connect (p2)
        optional VBUS: 9 [input] // USB VBUS detect, internal pull-down (p2)
        optional ACTN: 10 [output] // USB config-done indicator, active-low (p2)
        optional DCD: 11 [input] // modem data-carrier-detect, active-low
        optional DTR_TNOW: 12 [output] // DTR, or transmit-in-progress output
        optional RTS: 13 [output] // modem request-to-send, active-low
        optional DSR: 14 [input] // modem data-set-ready, active-low
        optional CTS: 15 [input] // modem clear-to-send input, active-low
        optional RI: 16 [input] // modem ring-indicator, active-low
        optional EPAD: 0 [power_in] // optional, recommended exposed-pad ground
    }
}

impl IC for CH343P {}

// No part declaration: WCH's official QFN16 package drawing specifies a 3 mm
// body, 0.5 mm pitch, 0.25 x 0.4 mm terminals, and a 1.8 mm exposed pad, but
// neither it nor the device datasheet publishes a recommended PCB land/paste
// pattern with enough tolerance data for an IPC derivation. Keep the verified
// pinout without presenting the old inferred 1.7 mm-EP footprint as safe.
