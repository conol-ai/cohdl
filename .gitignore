/target
Cargo.lock.orig
*.orig
.DS_Store
/out
harness/runs/

# Local code-review artifacts (not part of the compiler)
.co/

# Rendered mdBook output and ad-hoc compile byproducts under tests/fixtures
docs/book/
tests/fixtures/*/out/

# On-demand build artifacts (not default `cohdl build` goldens): the IPC-2581
# document (--emit ipc2581), the tools/ visualizers' output, and KiCad session
# files created when a generated .kicad_pcb is opened in pcbnew.
examples/*/out/*.xml
examples/*/out/*.enet
examples/*/out/*.html
examples/*/out/*.svg
examples/*/out/*.kicad_pcb
examples/*/out/*.kicad_pro
examples/*/out/*.lck
examples/*/out/.history/

# KiCad session state. This is per-machine UI state (visible layers, last
# dialog positions), written whenever pcbnew opens a board -- it is never a
# source of truth for a board and must not reach a commit, wherever the
# .kicad_pcb happens to sit.
*.kicad_prl

# Frame-board preview archives. The package next to them is what we review; the
# zip is a convenience wrapper around it, so it is a build artifact, not an
# input.
tools/frame_boards/*/*.zip
/registry/node_modules
/registry/dist
/site/node_modules
/ref/

# wrangler files (bot-added; covers registry/.wrangler too)
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Python bytecode from running tools/
__pycache__/

# KiCad's per-user project state (open layers, selection filter); never part of a design
*.kicad_prl
