// JAE SF72S006 nano-SIM (4FF) push-push connector with card detect.

#[doc("docs/jae-sf72s006.evidence.md")]
pub device JAE_SF72S006 {
    pins {
        required VCC: C1 [power_in]
        required RST: C2 [input]
        required CLK: C3 [input]
        required GND: C5 [power_in]
        optional VPP: C6 [bidirectional]
        required IO: C7 [bidirectional]
        required DSW: DSW [passive]
        required CSW: CSW [passive]
        required SH: SH [power_in]
    }
}

impl Connector for JAE_SF72S006 {}

#[doc("docs/jae-sf72s006.evidence.md")]
pub part CON_JAE_SF72S006VBA_R2500: JAE_SF72S006 {
    primary { mfr: "JAE", mpn: "SF72S006VBA(R2500)", footprint: FP_JAE_SF72S006 }
}

