// Texas Instruments TPS59650 datasheet SLUSAV7 and RSL package drawings
// 4209046/4207841:
// https://www.ti.com/lit/ds/symlink/tps59650.pdf
//
// The official land pattern has 48 perimeter lands at 0.40mm pitch,
// 0.85x0.20mm lands, 6.80mm overall span, and a 4.05x3.60mm PowerPAD.
// Drawing +Y is negated for CoHDL/KiCad. CoHDL emits one exposed copper pad;
// the official 16-via array and segmented paste stencil remain layout actions.
pub pad P_QFN48N40P600X600_LEAD_H {
    shape: rect
    size: (0.85mm, 0.2mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN48N40P600X600_LEAD_V {
    shape: rect
    size: (0.2mm, 0.85mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN48N40P600X600_EP405X360 {
    shape: rect
    size: (4.05mm, 3.6mm)
    layer: top_copper
    plating: smd
}

