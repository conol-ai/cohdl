// Tergy ULC0511C: ultra-low capacitance (0.35pF) bidirectional TVS diode
// for ESD protection, 5V, DFN1006DN (0402-size, 2 terminals) (datasheet
// rev 01.06.2014). Protects USB 2.0 / SIM / Ethernet lines.

#[doc("docs/ulc0511c.pdf")]
pub device ULC0511C {
    pins {
        required A: 1 [passive] // I/O line (bidirectional)
        required B: 2 [passive] // I/O line / ground reference
    }
}

impl TwoTerminal for ULC0511C {}

#[doc("docs/ulc0511c.pdf")]
pub part ESD_ULC0511C: ULC0511C {
    primary { mfr: "Tergy", mpn: "ULC0511C", footprint: QFN2N65P60X100 }
}

// IPC-7351 nominal-density land derived from the complete DFN1006DN package
// dimensions on datasheet page 3. See docs/footprint-derivations.md for the
// explicit land goals, tolerance checks, and arithmetic.
pub pad P_ULC0511C_DFN1006DN_TERMINAL {
    shape: rect
    size: (0.65mm, 0.5mm)
    layer: top_copper
    plating: smd
}

// The datasheet bottom view places terminal 1 at the notched lower end. A
// board-top land view preserves that row assignment; the device is electrically
// bidirectional, but the physical pin numbering remains exact.
pub footprint QFN2N65P60X100 {
    pad 1: P_ULC0511C_DFN1006DN_TERMINAL at (0mm, 0.325mm)
    pad 2: P_ULC0511C_DFN1006DN_TERMINAL at (0mm, -0.325mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.2mm, 1.7mm) }
    silkscreen_ref { at: (0mm, -1.15mm) }
}
