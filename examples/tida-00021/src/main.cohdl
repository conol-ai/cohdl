// TIDA-00021 — a representative single CPU Vcore phase built around the TI
// TPS59650 (std) SVID D-CAP+ multiphase controller, distilled from TI reference
// design TIDA-00021 (Intel IMVP-7 3rd-gen Core i7 mobile power). The full board
// runs 3 CPU + 2 GPU phases; this example wires ONE synchronous buck phase (HS +
// LS FET, inductor, output caps, DCR current sense, D-CAP+ feedback) plus the
// controller's full supply/decoupling/SVID/enable/status seam to a header. The
// unused CPU phases 2/3 and the entire GPU channel are left nc.
//
// Demo-grade: the input caps are shown at the std 10V/0603 part (a real 9-20V
// Vbatt rail wants 25V+ bulk); TIDA-00021 uses 5x6mm NexFET power blocks, here
// stood in by discrete PowerPAK SO-8 FETs.

design Tida00021Phase {
    // ---- controller + phase-1 power stage ----
    inst ctrl: CTRL_TPS59650
    inst q1: FET_NEXFET // high-side
    inst q2: FET_NEXFET // low-side
    inst l1: IND_VCORE
    inst j1: J_IFACE

    // ---- supply decoupling / reference / compensation / bootstrap ----
    inst c_v5: MLCC_1uF_10V_0402
    inst c_v3r3: MLCC_1uF_10V_0402
    inst c_v5drv: MLCC_1uF_10V_0402
    inst c_vref: MLCC_100nF_16V_0402
    inst c_ccomp: MLCC_100nF_16V_0402
    inst c_bst: MLCC_100nF_16V_0402
    inst c_sns: MLCC_1uF_10V_0402

    // ---- input + output bulk ----
    inst c_in1: MLCC_10uF_10V_0603
    inst c_in2: MLCC_10uF_10V_0603
    inst c_out1: MLCC_10uF_10V_0603
    inst c_out2: MLCC_10uF_10V_0603

    // ---- set / pull-up / sense resistors ----
    inst r_vbat: RES_10K_0402
    inst r_cocp: RES_10K_0402
    inst r_cfimax: RES_10K_0402
    inst r_slew: RES_10K_0402
    inst r_cpgood: RES_10K_0402
    inst r_alert: RES_10K_0402
    inst r_vrhot: RES_10K_0402
    inst r_sns: RES_5K1_0402

    // ---- power rails (from the interface header / board supply) ----
    net VBAT: j1.VBAT, q1.D, r_vbat.A, c_in1.A, c_in2.A
    net V5: j1.V5, ctrl.V5, c_v5.A
    net V3R3: j1.V3R3, ctrl.V3R3, c_v3r3.A, r_cpgood.A, r_alert.A, r_vrhot.A
    net V5DRV: j1.V5DRV, ctrl.V5DRV, c_v5drv.A
    net GND: j1.GND, ctrl.PGND, ctrl.EP, ctrl.CGFB, q2.S, c_v5.B, c_v3r3.B, c_v5drv.B, c_vref.B,
             c_ccomp.B, c_in1.B, c_in2.B, c_out1.B, c_out2.B, r_cocp.B, r_cfimax.B, r_slew.B

    // ---- phase 1: synchronous buck power stage ----
    net HSG: ctrl.CDH1, q1.G
    net SW1: ctrl.CSW1, q1.S, q2.D, l1.A, c_bst.B, r_sns.A
    net BST1: ctrl.CBST1, c_bst.A
    net LSG: ctrl.CDL1, q2.G
    net VCORE: l1.B, j1.VCORE, c_out1.A, c_out2.A, ctrl.CVFB, ctrl.CCSN1, c_sns.B
    // inductor-DCR current sense (CCSP1 across R_sns/C_sns, CCSN1 at Vout)
    net SNS: ctrl.CCSP1, r_sns.B, c_sns.A
    // Vbatt sense for the D-CAP+ on-time generator
    net VBAT_SNS: ctrl.VBAT, r_vbat.B

    // ---- controller configuration ----
    net COCP: ctrl.COCP_R, r_cocp.A
    net CFIMAX: ctrl.CF_IMAX, r_cfimax.A
    net SLEW: ctrl.SLEWA, r_slew.A
    net CCOMP: ctrl.CCOMP, c_ccomp.A
    net VREF: ctrl.VREF, c_vref.A

    // ---- SVID bus + enable + status (to the CPU/PCH via the header) ----
    net VR_ON: ctrl.VR_ON, j1.VR_ON
    net VCLK: ctrl.VCLK, j1.VCLK
    net VDIO: ctrl.VDIO, j1.VDIO
    net ALERT: ctrl.ALERT, j1.ALERT, r_alert.B
    net CPGOOD: ctrl.CPGOOD, j1.CPGOOD, r_cpgood.B
    net VR_HOT: ctrl.VR_HOT, j1.VR_HOT, r_vrhot.B

    // ---- unused: CPU phases 2/3 and the whole GPU channel ----
    nc: ctrl.CTHERM, ctrl.CCSN2, ctrl.CCSP2, ctrl.CCSP3, ctrl.CCSN3, ctrl.CDH2, ctrl.CBST2,
        ctrl.CSW2, ctrl.CDL2, ctrl.CPWM3, ctrl.GOCP_R, ctrl.GF_IMAX, ctrl.GGFB, ctrl.GVFB,
        ctrl.GCOMP, ctrl.GCSN1, ctrl.GCSP1, ctrl.GCSP2, ctrl.GCSN2, ctrl.GTHERM, ctrl.GSKIP,
        ctrl.GPWM1, ctrl.GPWM2, ctrl.GPGOOD

    // ---- layout: controller + phase-1 power stage placed; passives staged ----
    layout {
        net_class Switching { SW1, HSG, LSG, BST1 }
        board_outline: "mechanical/tida-00021-outline.dxf"
        place ctrl at (-11mm, 0mm)
        place q1 at (0mm, -7mm)
        place q2 at (0mm, 0mm)
        place l1 at (9mm, -3.5mm)
        place j1 at (0mm, 18mm)
    }
}
