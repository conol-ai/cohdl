// was: "Connector_USB:USB_Micro-B_Wuerth_614105150721_HandSoldering"
// Through-hole micro-USB: 5 staggered signal pins (drill 0.44mm) and 4
// shield/mounting posts (drill 1.35mm), positions from KiCad's real Würth
// 614105150721 land pattern (signal pins re-centered on x).
pub footprint FP_USB_Micro_B_Wuerth_614105150721_HandSoldering {
    pad 1: P_USB_TH_Signal at (-1.3mm, 0mm)
    pad 2: P_USB_TH_Signal at (-0.65mm, 1mm)
    pad 3: P_USB_TH_Signal at (0mm, 0mm)
    pad 4: P_USB_TH_Signal at (0.65mm, 1mm)
    pad 5: P_USB_TH_Signal at (1.3mm, 0mm)
    pad 6: P_USB_TH_Mount at (-3.575mm, 1mm)
    pad 7: P_USB_TH_Mount at (3.575mm, 1mm)
    pad 8: P_USB_TH_Mount at (-3.575mm, -2mm)
    pad 9: P_USB_TH_Mount at (3.575mm, -2mm)
    courtyard { shape: rect, at: (0mm, -0.4mm), size: (8.6mm, 6.4mm) }
    silkscreen_ref { at: (0mm, -3.4mm) }
}

// was: "Connector:Pico_Castellated_40"
// Pico 2.54mm castellations along the two long (51mm) board edges: pins
// 1-20 on the bottom edge, 21-40 on the top. No courtyard — the pads sit
// at the edges and the board interior stays free for placement (the header
// is a board-edge component, pre-placed via `place` in the design).
