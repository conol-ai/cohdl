// std/traits — Core electrical behavior contracts.

pub trait TwoTerminal {
    designator_prefix: "U"
    pins { A: Pin, B: Pin }
}

pub trait Resistor: TwoTerminal {
    designator_prefix: "R"
    spec {
        resistance: Ohms
    }
}

pub trait Capacitor: TwoTerminal {
    designator_prefix: "C"
    spec {
        capacitance: Farads,
        voltage_rating: Voltage
    }

    rule voltage_exceed(level: Error) {
        assert net_voltage(self.A, self.B) <= self.spec.voltage_rating
        message: "Capacitor voltage {net_voltage(self.A, self.B)}V exceeds voltage_rating {self.spec.voltage_rating}V"
    }

    rule voltage_derating(level: Warning) {
        assert net_voltage(self.A, self.B) <= self.spec.voltage_rating * 0.8
        message: "Capacitor voltage exceeds 80% derating ({net_voltage(self.A, self.B)}V > {self.spec.voltage_rating * 0.8}V)"
    }
}

pub trait Inductor: TwoTerminal {
    designator_prefix: "L"
    spec {
        inductance: Henries,
        current_rating: Amps
    }
}

pub trait Polarized: TwoTerminal {
    // A = anode (+), B = cathode (-)
    rule polarity_mismatch(level: Error) {
        assert net_voltage(self.A, self.B) >= 0
        message: "Polarized component has A (anode) at lower potential than B (cathode)"
    }
}

pub trait Crystal: TwoTerminal {
    designator_prefix: "X"
    spec {
        frequency: Hertz,
        load_cap: Farads
    }
}
