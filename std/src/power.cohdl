// std/power — Power sub-circuit functions.
//
// Re-usable sub-circuits for power distribution. Everything expressed as
// `fn` with `inst` + `net`.

use passive::{MLCC, Tantalum, Resistor, FerriteBead, BypassCap, BulkCap}
use traits::{Capacitor, Polarized}

// Single decoupling cap on a supply rail
pub fn decoupling(vdd: Net, gnd: Net, cap: impl Capacitor) {
    inst c: cap
    net vdd: c.A
    net gnd: c.B
}

// Convenience: specify capacitance + package directly
pub fn decoupling_val<C: Farads, V: Voltage, pkg: Package>(
    vdd: Net,
    gnd: Net
) {
    inst c: MLCC<C: C, V: V, pkg: pkg>
    net vdd: c.A
    net gnd: c.B
}

// Bulk + bypass pair on a supply rail (common MCU pattern)
pub fn decoupling_pair(vdd: Net, gnd: Net) {
    inst c_bulk:   BulkCap
    inst c_bypass: BypassCap
    net vdd: c_bulk.A, c_bypass.A
    net gnd: c_bulk.B, c_bypass.B
}

// Ferrite bead EMI filter between two rails
pub fn ferrite_filter<Z: Ohms, I: Amps>(
    vin:  Net,
    vout: Net,
    gnd:  Net
) {
    inst fb: FerriteBead<Z: Z, I: I>
    inst c:  BypassCap
    net vin:  fb.A
    net vout: fb.B, c.A
    net gnd:  c.B
}

// Resistor-based voltage divider
pub fn voltage_divider<R1: Ohms, R2: Ohms>(
    vin:  Net,
    vout: Net,
    gnd:  Net
) {
    inst r_top: Resistor<R: R1>
    inst r_bot: Resistor<R: R2>
    net vin:  r_top.A
    net vout: r_top.B, r_bot.A
    net gnd:  r_bot.B
}

// Pull-up resistor to a supply
pub fn pull_up<R: Ohms>(sig: Net, vdd: Net) {
    inst r: Resistor<R: R>
    net vdd: r.A
    net sig: r.B
}

// Pull-down resistor to ground
pub fn pull_down<R: Ohms>(sig: Net, gnd: Net) {
    inst r: Resistor<R: R>
    net sig: r.A
    net gnd: r.B
}

// Current-limiting resistor for LED
// Calculates R = (Vsupply - Vf) / If
pub fn led_series_resistor<Vsupply: Voltage, Vf: Voltage, If: Amps>(
    vdd: Net,
    led_anode: Net
) {
    inst r: Resistor<R: (Vsupply - Vf) / If>
    net vdd:       r.A
    net led_anode: r.B
}

// Crystal oscillator load capacitors
// Places two load caps on XIN/XOUT, each = 2 * CL (series equivalent)
pub fn crystal_load_caps<CL: Farads>(
    xin:  Net,
    xout: Net,
    gnd:  Net
) {
    inst c_xin:  MLCC<C: CL * 2, V: 10V, pkg: "C0402">
    inst c_xout: MLCC<C: CL * 2, V: 10V, pkg: "C0402">
    net xin:  c_xin.A
    net xout: c_xout.A
    net gnd:  c_xin.B, c_xout.B
}
