use std::passive::{Resistor, MLCC}
use std::traits::Capacitor
use stm32::STM32F103

module stm32

fn decoupling<P: impl Capacitor>(vdd: Net, gnd: Net) {
    inst c: P
    net vdd: c.A
    net gnd: c.B
}

// Top-level board design
design MainBoard {
    inst mcu: STM32F103<pkg: "LQFP48">

    // power decoupling
    decoupling<MLCC<C: 10nF, pkg: "C0603">>(vdd: mcu.VDD, gnd: mcu.VSS)
    decoupling<MLCC<C: 10nF, pkg: "C0603">>(vdd: mcu.VDD, gnd: mcu.VSS)
    decoupling<MLCC<C: 10nF, pkg: "C0603">>(vdd: mcu.VDD, gnd: mcu.VSS)
    decoupling<MLCC<C: 10nF, pkg: "C0603">>(vdd: mcu.VDDA, gnd: mcu.VSSA)

    // reset circuit
    inst r_rst: Resistor<pkg: "R0603", R: "10K">
    inst c_rst: MLCC<pkg: "C0603", C: "100nF">
    net GND: mcu.VSS, mcu.VSSA, c_rst.B
    net VCC_3V3: mcu.VDD, mcu.VDDA, r_rst.A
    net NRST: mcu.NRST, r_rst.B, c_rst.A
}
