// Winbond W25Q32RV Rev E section 10.3:
// https://www.winbond.com/resource-files/w25q32rv%20rev.e%2005152024%20plus.pdf
//
// The official XH XSON package drawing confirms 0.50mm-pitch terminals,
// nominal 0.25x0.45mm, and a nominal 0.20x1.60mm non-connected center metal,
// but Winbond publishes no recommended PCB land pattern. This deliberately
// retains KiCad's generic DFN-8 2x3mm P0.5 EP0.61x2.2mm land pattern
// (KiCad 10.0.4, format 20260206, inspected source SHA-256
// f09e0b5e84a7a0b54e90f4c3c5fec7d10f53e44f65d62e56c5a2fcddbdf46fd9):
// https://gitlab.com/kicad/libraries/kicad-footprints/-/blob/master/Package_DFN_QFN.pretty/DFN-8-1EP_2x3mm_P0.5mm.kicad_mod
//
// This is a generic, non-Winbond recommendation and requires assembly
// validation. The center land is not an electrical/thermal die pad.
pub pad P_QFN8N50P200X300_LEAD {
    shape: rect
    size: (0.87mm, 0.25mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN8N50P200X300_CENTER61X220 {
    shape: rect
    size: (0.61mm, 2.2mm)
    layer: top_copper
    plating: smd
}

pub footprint QFN8N50P200X300_1EP61X220 {
    pad 1: P_QFN8N50P200X300_LEAD at (-0.94mm, -0.75mm)
    pad 2: P_QFN8N50P200X300_LEAD at (-0.94mm, -0.25mm)
    pad 3: P_QFN8N50P200X300_LEAD at (-0.94mm, 0.25mm)
    pad 4: P_QFN8N50P200X300_LEAD at (-0.94mm, 0.75mm)
    pad 5: P_QFN8N50P200X300_LEAD at (0.94mm, 0.75mm)
    pad 6: P_QFN8N50P200X300_LEAD at (0.94mm, 0.25mm)
    pad 7: P_QFN8N50P200X300_LEAD at (0.94mm, -0.25mm)
    pad 8: P_QFN8N50P200X300_LEAD at (0.94mm, -0.75mm)
    pad 9: P_QFN8N50P200X300_CENTER61X220 at (0mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.3mm, 3.5mm) }
    silkscreen_ref { at: (0mm, -1.9mm) }
}
