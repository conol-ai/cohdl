// Tergy ULC0511C: ultra-low capacitance (0.35pF) bidirectional TVS diode
// for ESD protection, 5V, DFN1006DN (0402-size, 2 terminals) (datasheet
// rev 01.06.2014). Protects USB 2.0 / SIM / Ethernet lines.

#[doc("docs/ulc0511c.pdf")]
pub device ULC0511C {
    pins {
        required A: 1 [passive] // I/O line (bidirectional)
        required B: 2 [passive] // I/O line / ground reference
    }
}

impl TwoTerminal for ULC0511C {}
#[doc("docs/ulc0511c.pdf")]
pub part ESD_ULC0511C: ULC0511C {
    primary { mfr: "Tergy", mpn: "ULC0511C", footprint: FP_DFN1006_0402 }
}

// DFN1006DN = 0402 land (1.0 x 0.6 mm body, pads 0.5 x 0.6 mm).
pub pad P_DFN1006_PAD {
    shape: rect
    size: (0.5mm, 0.6mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_DFN1006_0402 {
    pad 1: P_DFN1006_PAD at (-0.45mm, 0mm)
    pad 2: P_DFN1006_PAD at (0.45mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.6mm, 1.2mm) }
    silkscreen_ref { at: (0mm, -0.9mm) }
}
