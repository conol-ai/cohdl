// SOT-23 bipolar transistors of the B1 snapshot (library plan W4, item 3d).
//
// GENERATED by tools/gen_sot23.py from tools/discrete_data/sot23_bjt_mos.json
// — do not hand-edit. Each pin assignment is the one the part's own sheet
// prints on its numbered SOT-23 diagram; the sheets and their checksums are
// in docs/sot23.evidence.md. Every part sits on sot::SOT3P190X290X130N, the
// audited SOT-23-3 land on the assembler's frame (pin 1 lower right, pins 1
// and 2 the +x column, pin 3 alone at -x). No part carries a supplier
// binding yet: a polarized part is bound only with its own preview reading.

// NPN bipolar transistor, SOT-23: pin 1 base, 2 emitter, 3 collector. VCEO, IC and PD are the sheet's absolute maximum ratings.
#[doc("docs/sot23.evidence.md")]
pub device NPN_SOT23<VCEO: Voltage, IC: Current, PD: Power> {
    pins {
        required B: 1 [input]
        required E: 2 [passive]
        required C: 3 [passive]
    }
}

impl BipolarTransistor for NPN_SOT23 {}

// PNP bipolar transistor, SOT-23: pin 1 base, 2 emitter, 3 collector. VCEO, IC and PD are the magnitudes of the sheet's absolute maximum ratings.
#[doc("docs/sot23.evidence.md")]
pub device PNP_SOT23<VCEO: Voltage, IC: Current, PD: Power> {
    pins {
        required B: 1 [input]
        required E: 2 [passive]
        required C: 3 [passive]
    }
}

impl BipolarTransistor for PNP_SOT23 {}

