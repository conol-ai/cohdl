// Kailh Choc V2 low-profile keyswitch land (Work Louder WL-LP-SW-55G;
// MX-compatible cross stem). STEM-CENTERED: origin = central pole, so placing
// the switch on a grid cell centers its keycap on the grid.
//
// Geometry from the Kailh PG1353 datasheet (P/N CPG135301D01), "Recommended PCB
// Layout (Pattern Side)". That drawing is a BOTTOM view drawn 90° from the
// orientation used here; mapping it to this top view is T(x,y) = (y,-x), which
// reproduces the contacts exactly and preserves every relative angle (verified
// rotation-invariantly, so it is not mirrored):
//   pad 1,2      = the two non-polar contacts, Ø1.2 holes, NORTH (0,-5.9) & (5,-3.8);
//   mount_hole 1 = the Ø5.00 central pole hole;
//   mount_hole 2 = the locating peg at (-5,+5.15).
// The SK6812MINI-E reverse-mount LED goes in the SOUTH window ~4.7mm away
// (placed separately) — the datasheet's own in-switch LED position, (0,+4.93)
// under the same mapping, is unused because we drive discrete RGB LEDs.
//
// The peg hole is the datasheet's 2.00 x 1.50 rectangular mounting leg, now
// expressible exactly thanks to RFC-023's `shape:`/`size:` extension to
// mount_hole (this switch is RFC-023's own motivating part, per DR-029). Note
// the axes SWAP under the T(x,y) = (y,-x) mapping above: the datasheet's 2.00
// along ITS x becomes 2.00 along our y, so the hole is size: (1.5mm, 2mm) here,
// not (2mm, 1.5mm). Both holes are non_plated mount_holes — mechanical, no net,
// numbered disjoint from the pads.
pub footprint FP_SW_Choc_V2 {
    pad 1: P_Choc_Contact at (0mm, -5.9mm)
    pad 2: P_Choc_Contact at (5mm, -3.8mm)
    mount_hole 1: non_plated at (0mm, 0mm) diameter 5mm
    mount_hole 2: non_plated shape: rect at (-5mm, 5.15mm) size: (1.5mm, 2mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (15.5mm, 15.5mm) }
}

// 1N4148W small-signal diode, SOD-123 (KiCad Diode_SMD:D_SOD-123).
// Pad 1 = cathode (band), pad 2 = anode.
pub footprint FP_D_SOD_123 {
    pad 1: P_SOD123_Term at (-1.65mm, 0mm)
    pad 2: P_SOD123_Term at (1.65mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.2mm, 1.6mm) }
    silkscreen_ref { at: (0mm, -1.3mm) }
}

// SOT-23-6 (KiCad Package_TO_SOT_SMD:SOT-23-6) — USBLC6-2SC6 ESD array.
pub footprint FP_SOT_23_6 {
    pad 1: P_SOT23_6_Lead at (-1.1375mm, -0.95mm)
    pad 2: P_SOT23_6_Lead at (-1.1375mm, 0mm)
    pad 3: P_SOT23_6_Lead at (-1.1375mm, 0.95mm)
    pad 4: P_SOT23_6_Lead at (1.1375mm, 0.95mm)
    pad 5: P_SOT23_6_Lead at (1.1375mm, 0mm)
    pad 6: P_SOT23_6_Lead at (1.1375mm, -0.95mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.6mm, 3.2mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}

// SK6812MINI-E reverse-mount RGB LED (KiCad
// LED_SMD:LED_SK6812MINI-E_3.2x2.8mm_P1.5mm_ReverseMount). Pads:
// 1=VDD 2=DOUT 3=GND 4=DIN.
pub footprint FP_LED_SK6812MINI_E {
    pad 1: P_SK6812_Pad at (-2.725mm, 0.75mm)
    pad 2: P_SK6812_Pad at (-2.725mm, -0.75mm)
    pad 3: P_SK6812_Pad at (2.725mm, -0.75mm)
    pad 4: P_SK6812_Pad at (2.725mm, 0.75mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.6mm, 3.2mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}

// Panasonic EVQ-P7A side-actuated SMD light-touch switch (datasheet
// ATK0000CE20). Two electrical terminals, each spanning BOTH columns of one
// ROW (not one column): terminal A = pads 1,2 (top row, y=-0.72); terminal B
// = pads 3,4 (bottom row, y=+0.72). Column pitch 3.6mm, row pitch 1.44mm.
// Grouping by column instead would short A to B, disabling the switch.
pub footprint FP_SW_Reset {
    pad 1: P_ResetSw at (-1.8mm, -0.72mm)
    pad 2: P_ResetSw at (1.8mm, -0.72mm)
    pad 3: P_ResetSw at (-1.8mm, 0.72mm)
    pad 4: P_ResetSw at (1.8mm, 0.72mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (5.5mm, 4.1mm) }
    silkscreen_ref { at: (0mm, -2.5mm) }
}

// 1x4 2.54mm pin header (SWD debug: SWDIO/SWCLK/GND/3V3).
pub footprint FP_Header_1x4 {
    pad 1: P_Header254 at (-3.81mm, 0mm)
    pad 2: P_Header254 at (-1.27mm, 0mm)
    pad 3: P_Header254 at (1.27mm, 0mm)
    pad 4: P_Header254 at (3.81mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (10.9mm, 2.6mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}

// Capacitive-touch sense pad — a bare copper area sensed by the STM32.
pub footprint FP_TouchPad {
    pad 1: P_TouchPad at (0mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (9.4mm, 9.4mm) }
}

// M2 mounting hole — one plated pad (the barrel).
pub footprint FP_MountingHole_M2 {
    pad 1: P_MountHole_M2 at (0mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.4mm, 4.4mm) }
}

// Alps EC11E rotary encoder w/ push switch, vertical (KiCad
// Rotary_Encoder:RotaryEncoder_Alps_EC11E-Switch_Vertical_H20mm). Pads:
// 1=A 2=C(common/GND) 3=B (encoder, 2.5mm pitch), 4/5 = push switch, 6/7 =
// mounting posts.
pub footprint FP_Encoder_EC11 {
    pad 1: P_EC11_Pin at (0mm, 0mm)
    pad 2: P_EC11_Pin at (0mm, 2.5mm)
    pad 3: P_EC11_Pin at (0mm, 5mm)
    pad 4: P_EC11_Pin at (14.5mm, 5mm)
    pad 5: P_EC11_Pin at (14.5mm, 0mm)
    pad 6: P_EC11_MP at (7.5mm, -3.1mm)
    pad 7: P_EC11_MP at (7.5mm, 8.1mm)
    courtyard { shape: rect, at: (7mm, 2.5mm), size: (16mm, 14mm) }
    silkscreen_ref { at: (7mm, -5mm) }
}

// Alps RKJXV122400R analog ThumbPointer (dual 10k pot + center-push switch),
// through-hole. Demo-grade land approximated from the datasheet: the two pots'
// terminals are PERPENDICULAR — the X pot a horizontal row, the Y pot a
// vertical column, each at 2.5mm pitch, clustered around the central boss (not
// one collinear row). The central boss holes (4.0mm, 3.5mm) and four mounting
// legs (1.5mm) are non-electrical mechanical holes added at fab (CoHDL has no
// non-plated plating). Wiper = the center terminal of each pot. Pins:
// 1=X_END_A 2=X_WIPER 3=X_END_B 4=Y_END_A 5=Y_WIPER 6=Y_END_B 7=SW_A 8=SW_B.
pub footprint FP_Joystick_RKJXV {
    pad 1: P_Header254 at (-2.5mm, 0mm)
    pad 2: P_Header254 at (0mm, 0mm)
    pad 3: P_Header254 at (2.5mm, 0mm)
    pad 4: P_Header254 at (5mm, -2.5mm)
    pad 5: P_Header254 at (5mm, 0mm)
    pad 6: P_Header254 at (5mm, 2.5mm)
    pad 7: P_Header254 at (0mm, 6mm)
    pad 8: P_Header254 at (2.5mm, 6mm)
    courtyard { shape: rect, at: (1.25mm, 0mm), size: (18.2mm, 21.7mm) }
    silkscreen_ref { at: (1.25mm, -11.5mm) }
}
