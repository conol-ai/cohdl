// NXP PTN5110 Rev. 1.6: Tables 1-4, pp5-9. EP uses library pad number 17.
#[doc("docs/ptn5110-application.md")]
#[doc("docs/nxp-ptn5110.pdf")]
pub device PTN5110_HX2QFN16 {
    pins {
        optional FRS_EN: 1 [output]
        optional EN_SNK1: 2 [output]
        required VDD: 3 [power_in]
        required BYPASS: 4 [power_out]
        optional SLV_ADDR: 5 [input]
        optional ILIM_5V_VBUS: 6 [bidirectional]
        required I2C_SDA: 7 [bidirectional]
        required I2C_SCL: 8 [input]
        optional DBG_ACC: 9 [output]
        optional ALERT_N: 10 [output]
        required FAULT_N: 11 [input]
        required VCONN_IN: 12 [power_in]
        required CC1: 13 [bidirectional]
        required CC2: 14 [bidirectional]
        required VBUS: 15 [power_in]
        optional EN_SRC: 16 [output]
        required GND: 17 [power_in]
    }
}

impl IC for PTN5110_HX2QFN16 {}

#[intent("USB PD TCPC 1.0 v1.1; POR role DRP, starts as sink; requires external TCPM; not a proven passive sniffer; source land drawing UNRELEASED")]
#[doc("docs/ptn5110-application.md")]
#[doc("docs/nxp-ptn5110.pdf")]
pub part TCPC_PTN5110HQZ: PTN5110_HX2QFN16 {
    primary { mfr: "NXP", mpn: "PTN5110HQZ", footprint: HX2QFN16_SOT1883_1 }
}

