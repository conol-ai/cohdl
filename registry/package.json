{
  "name": "cohdl-registry",
  "private": true,
  "version": "0.1.0",
  "description": "registry.cohdl.org — the CoHDL package registry (RFC-030)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute cohdl-registry --file=./schema.sql"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plus": "^0.2.6",
    "vitest": "^3.2.0",
    "wrangler": "^4.114.0"
  }
}
