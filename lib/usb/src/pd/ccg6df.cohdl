    pad L10: P_BGA_Outer_V at (2mm, 2.5mm)
    pad L11: P_BGA_Outer_Corner at (2.5mm, 2.5mm)
    silkscreen {
        pin_1_marker near pad A1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.5mm, 6.5mm) }
    silkscreen_ref { at: (0mm, -3.5mm) }
}
