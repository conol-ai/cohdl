// imvp7-vcore example pads — the external driver, power FETs, inductor, header.
// The controller lands are std (P_QFN040_*, P_TPS59650_EP).

// TPS51601A driver, VSON-8 3x3mm P0.65 lead (KiCad VSON-8-1EP_3x3mm_P0.65mm).
pub pad P_VSON8_Lead {
    shape: rect
    size: (0.85mm, 0.35mm)
    layer: top_copper
    plating: smd
}

// TPS51601A exposed thermal pad (1.65 x 2.40mm), tie to GND.
pub pad P_VSON8_EP {
    shape: rect
    size: (1.65mm, 2.4mm)
    layer: top_copper
    plating: smd
}

// Power SO-8 (PowerPAK SO-8) N-FET lead.
pub pad P_SOIC_Lead {
    shape: rect
    size: (1.55mm, 0.6mm)
    layer: top_copper
    plating: smd
}

// Shielded power-inductor terminal (~5x5mm part).
pub pad P_Ind_Pwr {
    shape: rect
    size: (1.6mm, 4.6mm)
    layer: top_copper
    plating: smd
}

// 2.54mm interface-header hole.
pub pad P_Hdr254 {
    shape: circle
    size: (1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: 1mm
}
