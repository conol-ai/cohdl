// Chipone CO5300: AMOLED display driver IC (DDIC), QSPI / MIPI-DSI,
// COF package (chip 7.64 x 1.67 mm, datasheet V0.00 2023). Pin
// description p11-18.
//
// This models the FPC-exposed pins only (power, host interface, control).
// The 240 OLED source outputs (S1..S240), gate/GOA routing pins
// (SDMY/VSR/SW), and charge-pump capacitor pins (C*P/C*N) are panel-bond
// pads on the COF tape — they connect to the OLED glass, never to the
// PCB, so they are out of scope for a board-level library. The datasheet
// identifies these die pads by signal name, not by sequential package pin;
// those source names are therefore used as the nonphysical interface IDs.

#[doc("docs/co5300.pdf")]
pub device CO5300 {
    pins {
        // Power (p11)
        required VCIC: VCIC [power_in] // DCDC supply 2.7-3.6V (p11)
        required VCIA: VCIA [power_in] // analog DDIC supply 2.7-3.6V (p11)
        required VCIR: VCIR [power_in] // LDO DDIC supply 2.7-3.6V (p11)
        required VDDI: VDDI [power_in] // I/O supply 1.65-3.3V (p11)
        required VCC: VCC [power_in] // DVDD regulator supply (p11)
        required VSSC: VSSC [power_in] // DC/DC ground (p11)
        required VSSA: VSSA [power_in] // analog ground (p11)
        required HVSSAM: HVSSAM [power_in] // MIPI ground (p11)
        required VSSI: VSSI [power_in] // I/O ground (p11)
        required VSSD: VSSD [power_in] // digital ground (p11)
        optional MTP_PWR: MTPPWR [passive] // MTP prog 8.25V, open normal (p11)
        // QSPI interface (p12)
        optional CSX: CSX [input] // chip select, active-low (p12)
        optional WRX_SCL: WRXSCL [input] // QSPI clock (p12)
        optional DCX: DCX [input] // data/command select (p12)
        optional SDI_RDX: SDIRDX [bidirectional] // serial data in / data out (p12)
        optional SDO: SDO [output] // serial data out (p12)
        // MIPI-DSI interface (p13)
        optional HSSI_CLK_P: HSSICLKP [input] // MIPI clock+ (p13)
        optional HSSI_CLK_N: HSSICLKN [input] // MIPI clock- (p13)
        optional HSSI_D0_P: HSSID0P [bidirectional] // MIPI D0+ (p13)
        optional HSSI_D0_N: HSSID0N [bidirectional] // MIPI D0- (p13)
        optional HSSI_D1_P: HSSID1P [bidirectional] // MIPI D1+ (p13)
        optional HSSI_D1_N: HSSID1N [bidirectional] // MIPI D1- (p13)
        // Control (p14)
        optional RESX: RESX [input] // reset, active-low, no internal pull (p14)
        optional IM0: IM0 [input] // interface select bit 0 (p14)
        optional IM1: IM1 [input] // interface select bit 1 (p14)
        optional BSTM: BSTM [input] // boost mode select (p14)
        optional TE: TE [output] // tearing effect sync (p14)
        optional TE1: TE1 [output] // tearing effect 2 (p14)
        optional SWIRE: SWIRE [output] // Swire protocol to power IC (p14)
    }
}

impl IC for CO5300 {}

// No part/footprint: CO5300 is a COF-bonded driver IC (chip-on-film),
// never mounted directly on a PCB. It lives inside AMOLED modules
// (e.g. H0216F002AM); board designers instantiate the module, not the
// bare DDIC.
