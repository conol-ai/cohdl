// SiFli SF32LB52X: ultra-low-power dual-core Arm Cortex-M33 AIoT MCU
// (HCPU 192MHz + LCPU 24MHz, 576KB SRAM, BT/BLE 5.3, ePicasso 2.5D),
// QFN68L 7x7x0.85mm 0.35 pitch + EPAD (DS0052-SF32LB52X-CN V0.1,
// 2024: pin layout Fig. 5-1, pin tables Table 5-2/5-3, package Fig. 5-2,
// ordering Table 5-7). The current DS5202 V0.2.5 pinout and official
// SiliconSchema were cross-checked on 2026-08-05. Pin 1 is upper-left in top
// view and numbering proceeds counter-clockwise.

#[doc("docs/ds0052-sf32lb52x-cn.pdf")]
pub device SF32LB52X {
    pins {
        optional PA32: 1 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA31: 2 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA30: 3 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA29: 4 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA28: 5 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA27: 6 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA26: 7 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA25: 8 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA24: 9 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA23: 10 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA22: 11 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        required VDD_RTC: 12 [power_out] // RTC LDO output (Table 5-3) — decoupling required
        required VDD_RET: 13 [power_out] // RET LDO output (Table 5-3) — decoupling required
        required AVDD33: 14 [power_in] // analog supply input (Table 5-3)
        // SiliconSchema commit 1c17be0 accidentally omits pins 15 and 16 from
        // its variant map. DS5202 Fig. 5-1 and the hardware guide power table
        // independently establish both pins and their output roles.
        required VDD_VOUT2: 15 [power_out] // LPSYS internal LDO output; add 4.7 uF to ground
        required VDD_VOUT1: 16 [power_out] // HPSYS internal LDO output; add 4.7 uF to ground
        required BUCK_FB: 17 [power_out] // BUCK output (Table 5-3)
        required BUCK_LX: 18 [bidirectional] // BUCK inductor switch node, A I/O (Table 5-3)
        required PVDD: 19 [power_in] // system power input (Table 5-3)
        optional VBATS: 20 [input] // VBAT voltage sense input, A I (Table 5-3)
        required VDDIOA: 21 [power_in] // GPIO supply input (Table 5-3)
        optional NC: 22 [passive] // SiliconSchema NC22: no internal connection; leave unconnected
        // Variant-dependent SiP supply node: external input on B/D variants,
        // internal-LDO output on E/G/J variants. Required passive avoids a
        // false direction on the family-wide device while preserving the
        // mandatory external decoupling connection.
        required VDD_SIP: 23 [passive]
        optional PA21: 24 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA20: 25 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA19: 26 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA18: 27 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA17: 28 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA16: 29 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA15: 30 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA14: 31 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA13: 32 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA12: 33 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA11: 34 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA10: 35 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional DACN: 36 [output] // audio DAC output, A O (Table 5-3)
        optional DACP: 37 [output] // audio DAC output, A O (Table 5-3)
        required AVDD33_AUD: 38 [power_in] // audio supply input (Table 5-3)
        optional AUD_VREF: 39 [input] // audio reference voltage input, A I (Table 5-3)
        optional MIC_BIAS: 40 [power_out] // microphone bias supply output (Table 5-3)
        optional ADCP: 41 [input] // audio ADC input, A I (Table 5-3)
        optional PA09: 42 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA08: 43 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA07: 44 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA06: 45 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA05: 46 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA04: 47 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA03: 48 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA02: 49 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA01: 50 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA00: 51 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        required AVDD_BRF: 52 [power_in] // RF supply input (Table 5-3)
        optional BRF_ANT: 53 [bidirectional] // antenna interface, A I/O (Table 5-3)
        required XTAL48M_XO: 54 [output] // 48MHz crystal interface, A O (Table 5-3)
        required XTAL48M_XI: 55 [input] // 48MHz crystal interface, A I (Table 5-3)
        optional PA44: 56 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA43: 57 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA42: 58 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA41: 59 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA40: 60 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA39: 61 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA38: 62 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA37: 63 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA36: 64 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA35: 65 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA34: 66 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional PA33: 67 [bidirectional] // Table 5-2: big-core-domain GPIO (I/O)
        optional GPADC_VREF: 68 [input] // GPADC VREF input, A I (Table 5-3)
        required EPAD: 69 [power_in] // SiliconSchema GND / datasheet GND PAD; must connect
    }
}

impl IC for SF32LB52X {}

#[doc("docs/ds0052-sf32lb52x-cn.pdf")]
pub part MCU_SF32LB52EUB6: SF32LB52X {
    primary { mfr: "SiFli Technologies", mpn: "SF32LB52EUB6",
              footprint: FP_SiFli_SF32LB52X_QFN68L_7X7 }
}

// SiFli Figure 5-2 package envelope and the pinned official KiCad generator
// define the exact package land. Perimeter copper is 0.55 x 0.25mm on 0.35mm pitch, with
// 0.05mm local mask expansion and 0.0625mm round-rectangle corner radius.
pub pad P_SF32LB52X_QFN68_LEAD {
    shape: rect
    size: (0.55mm, 0.25mm)
    layer: top_copper
    plating: smd
    corner_radius: 0.0625mm
    mask_expansion: 0.05mm
}

// The exposed pad's copper is continuous but its stencil is segmented.
pub pad P_SF32LB52X_EP_TOP {
    shape: rect
    size: (5.49mm, 5.49mm)
    layer: top_copper
    plating: smd
    paste: none
}

// These same-net auxiliary lands lie wholly inside the continuous EP copper.
// Their copper/mask union therefore changes nothing, while their default paste
// creates the official nine 1.42mm round-rectangle stencil apertures.
pub pad P_SF32LB52X_EP_PASTE_WINDOW {
    shape: rect
    size: (1.42mm, 1.42mm)
    layer: top_copper
    plating: smd
    corner_radius: 0.25mm
}

pub pad P_SF32LB52X_EP_VIA {
    shape: circle
    size: (0.5mm)
    layer: through_all
    plating: plated_through_hole
    drill: 0.2mm
}

pub pad P_SF32LB52X_EP_BOTTOM {
    shape: rect
    size: (5.49mm, 5.49mm)
    layer: bottom_copper
    plating: smd
    paste: none
}

pub footprint FP_SiFli_SF32LB52X_QFN68L_7X7 {
    // Left side, top to bottom.
    pad 1: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -2.8mm)
    pad 2: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -2.45mm)
    pad 3: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -2.1mm)
    pad 4: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -1.75mm)
    pad 5: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -1.4mm)
    pad 6: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -1.05mm)
    pad 7: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -0.7mm)
    pad 8: P_SF32LB52X_QFN68_LEAD at (-3.3mm, -0.35mm)
    pad 9: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 0mm)
    pad 10: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 0.35mm)
    pad 11: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 0.7mm)
    pad 12: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 1.05mm)
    pad 13: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 1.4mm)
    pad 14: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 1.75mm)
    pad 15: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 2.1mm)
    pad 16: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 2.45mm)
    pad 17: P_SF32LB52X_QFN68_LEAD at (-3.3mm, 2.8mm)

    // Bottom side, left to right.
    pad 18: P_SF32LB52X_QFN68_LEAD at (-2.8mm, 3.3mm) rotate 90
    pad 19: P_SF32LB52X_QFN68_LEAD at (-2.45mm, 3.3mm) rotate 90
    pad 20: P_SF32LB52X_QFN68_LEAD at (-2.1mm, 3.3mm) rotate 90
    pad 21: P_SF32LB52X_QFN68_LEAD at (-1.75mm, 3.3mm) rotate 90
    pad 22: P_SF32LB52X_QFN68_LEAD at (-1.4mm, 3.3mm) rotate 90
    pad 23: P_SF32LB52X_QFN68_LEAD at (-1.05mm, 3.3mm) rotate 90
    pad 24: P_SF32LB52X_QFN68_LEAD at (-0.7mm, 3.3mm) rotate 90
    pad 25: P_SF32LB52X_QFN68_LEAD at (-0.35mm, 3.3mm) rotate 90
    pad 26: P_SF32LB52X_QFN68_LEAD at (0mm, 3.3mm) rotate 90
    pad 27: P_SF32LB52X_QFN68_LEAD at (0.35mm, 3.3mm) rotate 90
    pad 28: P_SF32LB52X_QFN68_LEAD at (0.7mm, 3.3mm) rotate 90
    pad 29: P_SF32LB52X_QFN68_LEAD at (1.05mm, 3.3mm) rotate 90
    pad 30: P_SF32LB52X_QFN68_LEAD at (1.4mm, 3.3mm) rotate 90
    pad 31: P_SF32LB52X_QFN68_LEAD at (1.75mm, 3.3mm) rotate 90
    pad 32: P_SF32LB52X_QFN68_LEAD at (2.1mm, 3.3mm) rotate 90
    pad 33: P_SF32LB52X_QFN68_LEAD at (2.45mm, 3.3mm) rotate 90
    pad 34: P_SF32LB52X_QFN68_LEAD at (2.8mm, 3.3mm) rotate 90

    // Right side, bottom to top.
    pad 35: P_SF32LB52X_QFN68_LEAD at (3.3mm, 2.8mm)
    pad 36: P_SF32LB52X_QFN68_LEAD at (3.3mm, 2.45mm)
    pad 37: P_SF32LB52X_QFN68_LEAD at (3.3mm, 2.1mm)
    pad 38: P_SF32LB52X_QFN68_LEAD at (3.3mm, 1.75mm)
    pad 39: P_SF32LB52X_QFN68_LEAD at (3.3mm, 1.4mm)
    pad 40: P_SF32LB52X_QFN68_LEAD at (3.3mm, 1.05mm)
    pad 41: P_SF32LB52X_QFN68_LEAD at (3.3mm, 0.7mm)
    pad 42: P_SF32LB52X_QFN68_LEAD at (3.3mm, 0.35mm)
    pad 43: P_SF32LB52X_QFN68_LEAD at (3.3mm, 0mm)
    pad 44: P_SF32LB52X_QFN68_LEAD at (3.3mm, -0.35mm)
    pad 45: P_SF32LB52X_QFN68_LEAD at (3.3mm, -0.7mm)
    pad 46: P_SF32LB52X_QFN68_LEAD at (3.3mm, -1.05mm)
    pad 47: P_SF32LB52X_QFN68_LEAD at (3.3mm, -1.4mm)
    pad 48: P_SF32LB52X_QFN68_LEAD at (3.3mm, -1.75mm)
    pad 49: P_SF32LB52X_QFN68_LEAD at (3.3mm, -2.1mm)
    pad 50: P_SF32LB52X_QFN68_LEAD at (3.3mm, -2.45mm)
    pad 51: P_SF32LB52X_QFN68_LEAD at (3.3mm, -2.8mm)

    // Top side, right to left.
    pad 52: P_SF32LB52X_QFN68_LEAD at (2.8mm, -3.3mm) rotate 90
    pad 53: P_SF32LB52X_QFN68_LEAD at (2.45mm, -3.3mm) rotate 90
    pad 54: P_SF32LB52X_QFN68_LEAD at (2.1mm, -3.3mm) rotate 90
    pad 55: P_SF32LB52X_QFN68_LEAD at (1.75mm, -3.3mm) rotate 90
    pad 56: P_SF32LB52X_QFN68_LEAD at (1.4mm, -3.3mm) rotate 90
    pad 57: P_SF32LB52X_QFN68_LEAD at (1.05mm, -3.3mm) rotate 90
    pad 58: P_SF32LB52X_QFN68_LEAD at (0.7mm, -3.3mm) rotate 90
    pad 59: P_SF32LB52X_QFN68_LEAD at (0.35mm, -3.3mm) rotate 90
    pad 60: P_SF32LB52X_QFN68_LEAD at (0mm, -3.3mm) rotate 90
    pad 61: P_SF32LB52X_QFN68_LEAD at (-0.35mm, -3.3mm) rotate 90
    pad 62: P_SF32LB52X_QFN68_LEAD at (-0.7mm, -3.3mm) rotate 90
    pad 63: P_SF32LB52X_QFN68_LEAD at (-1.05mm, -3.3mm) rotate 90
