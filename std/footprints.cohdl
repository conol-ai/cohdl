// Footprint declarations, one per KiCad footprint the std library's
// parts previously named as a string. Each `was:` comment records the
// original KiCad footprint id. RFC-018 stage-two migration is underway:
// footprints with authored pad geometry (from std/pads.cohdl) get the
// full build-time pad-consistency check (E807) and project into
// .kicad_mod / IPC-2581; the rest are still RFC-017 stage-one
// placeholders (empty body = resolvable name only, exempt from E807)
// pending real datasheet-derived authoring.
//
// Filled (stage two): the chip passives (CHIP_0402/CHIP_0603 — under RFC-021
// the footprint's own identifier IS its IPC-7351 name, so the former
// R_0402/C_0402 lands collapse into the one CHIP_0402), LED 0603, SOT-23-5
// (SOT5P95X290X160N).
// Still stage-one placeholders: the large multi-pad modules/connectors
// (ESP32-S3-WROOM-1, InvenSense ICS-43434, USB-C receptacle) — not used by
// any current example board, so their real land patterns are deferred until
// a board needs them.

// was: "Resistor_SMD:R_0402_1005Metric" / "Capacitor_SMD:C_0402_1005Metric"
// IPC-7351 name (RFC-021): the two-terminal 0402 chip land. Resistors and
// capacitors share the one nominal CHIP-0402 land, so the former R_0402 and
// C_0402 footprints collapse into this single named land (resistor geometry,
// the more generous of the two).
pub footprint CHIP_0402 {
    pad 1: P_Chip_R0402 at (-0.51mm, 0mm)
    pad 2: P_Chip_R0402 at (0.51mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.06mm, 1.14mm) }
    silkscreen_ref { at: (0mm, -1.17mm) }
}

// was: "Capacitor_SMD:C_0603_1608Metric"
// IPC-7351 name (RFC-021): the two-terminal 0603 chip land.
pub footprint CHIP_0603 {
    pad 1: P_Chip_0603 at (-0.775mm, 0mm)
    pad 2: P_Chip_0603 at (0.775mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2mm, 0.95mm) }
    silkscreen_ref { at: (0mm, -1.2mm) }
}

// was: "RF_Module:ESP32-S3-WROOM-1"
pub footprint FP_ESP32_S3_WROOM_1 {}

// was: "Sensor_Audio:InvenSense_ICS-43434-6_3.5x2.65mm"
pub footprint FP_InvenSense_ICS_43434_6_3_5x2_65mm {}

// was: "LED_SMD:LED_0603_1608Metric"
pub footprint FP_LED_0603_1608Metric {
    pad 1: P_Chip_LED0603 at (-0.7875mm, 0mm)
    pad 2: P_Chip_LED0603 at (0.7875mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.0125mm, 0.95mm) }
    silkscreen_ref { at: (0mm, -1.2mm) }
}

// was: "Package_TO_SOT_SMD:SOT-23-5"
// IPC-7351 name (RFC-021): 5 leads, 0.95mm pitch, 2.90x1.60mm body, density N.
pub footprint SOT5P95X290X160N {
    pad 1: P_SOT23_Lead at (-1.1375mm, -0.95mm)
    pad 2: P_SOT23_Lead at (-1.1375mm, 0mm)
    pad 3: P_SOT23_Lead at (-1.1375mm, 0.95mm)
    pad 4: P_SOT23_Lead at (1.1375mm, 0.95mm)
    pad 5: P_SOT23_Lead at (1.1375mm, -0.95mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.6mm, 3.1mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}

// USB Type-C receptacle, USB-2.0-only (HRO TYPE-C-31-M-12). Land pattern from
// KiCad Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12: 16 SMD contacts in
// one row at y=-4.045 (top-row A* and bottom-row B* contacts merged at the same
// X where their nets are common), plus four plated shield/mounting tabs. The two
// non-plated locating holes at (+/-2.89, -2.6) are mechanical only and omitted
// (RFC-018 has no non-plated plating). KiCad names all four shield tabs `SH`;
// CoHDL requires unique pad numbers (E806), so they are SH1..SH4 here. Pad
// names are the device pin numbers.
pub footprint FP_USB_C_Receptacle_HRO_TYPE_C_31_M_12 {
    pad A1: P_USBC_Sig_L at (-3.25mm, -4.045mm)
    pad A4: P_USBC_Sig_L at (-2.45mm, -4.045mm)
    pad A5: P_USBC_Sig_S at (-1.25mm, -4.045mm)
    pad A6: P_USBC_Sig_S at (-0.25mm, -4.045mm)
    pad A7: P_USBC_Sig_S at (0.25mm, -4.045mm)
    pad A8: P_USBC_Sig_S at (1.25mm, -4.045mm)
    pad A9: P_USBC_Sig_L at (2.45mm, -4.045mm)
    pad A12: P_USBC_Sig_L at (3.25mm, -4.045mm)
    pad B1: P_USBC_Sig_L at (3.25mm, -4.045mm)
    pad B4: P_USBC_Sig_L at (2.45mm, -4.045mm)
    pad B5: P_USBC_Sig_S at (1.75mm, -4.045mm)
    pad B6: P_USBC_Sig_S at (0.75mm, -4.045mm)
    pad B7: P_USBC_Sig_S at (-0.75mm, -4.045mm)
    pad B8: P_USBC_Sig_S at (-1.75mm, -4.045mm)
    pad B9: P_USBC_Sig_L at (-2.45mm, -4.045mm)
    pad B12: P_USBC_Sig_L at (-3.25mm, -4.045mm)
    pad SH1: P_USBC_Shield_T at (-4.32mm, -3.13mm)
    pad SH2: P_USBC_Shield_T at (4.32mm, -3.13mm)
    pad SH3: P_USBC_Shield_B at (-4.32mm, 1.05mm)
    pad SH4: P_USBC_Shield_B at (4.32mm, 1.05mm)
    courtyard { shape: rect, at: (0mm, -1.55mm), size: (10.64mm, 9.42mm) }
    silkscreen_ref { at: (0mm, 2.5mm) }
}

