// ccg6sf-typec example parts — the discrete VBUS power path + interface header
// around the std::CCG6SF USB Type-C port controller and the std USB-C receptacle.

pub trait Transistor {
    designator_prefix: "Q"
}
pub trait CurrentSense {
    designator_prefix: "R"
}

// External VBUS consumer-path N-FET (gate driven by CCG6SF VBUS_C_CTRL / NGDO),
// PowerPAK SO-8 (1-3 Source, 4 Gate, 5-8 Drain).
pub device NFET_SO8 {
    pins {
        required S: 1, 2, 3 [passive]
        required G: 4 [input]
        required D: 5, 6, 7, 8 [passive]
    }
}
impl Transistor for NFET_SO8 {}
pub part FET_CONSUMER: NFET_SO8 {
    primary { mfr: "Infineon", mpn: "BSC0902NSI", footprint: SOIC8P127X600X175N }
}

// 5-mOhm VBUS current-sense resistor (2512) for the CCG6SF CSP/CSN inputs.
pub device SenseResistor {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
    }
}
impl CurrentSense for SenseResistor {}
pub part R_SENSE_5M: SenseResistor {
    primary { mfr: "Bourns", mpn: "CSS2H-2512R-L500F", footprint: FP_R2512 }
}

// 1x16 interface header: VBUS provider/system rails, VSYS, V5V, GND, EC + SoC
// I2C, interrupt, DP/DM/HPD to the host, SWD, reset.
pub device IfaceHeader {
    pins {
        required VBUS_IN: 1 [passive]
        required VBUS_SYS: 2 [passive]
        required VSYS: 3 [passive]
        required V5V: 4 [passive]
        required GND: 5 [passive]
        required EC_SCL: 6 [passive]
        required EC_SDA: 7 [passive]
        required INT_EC: 8 [passive]
        required SOC_SCL: 9 [passive]
        required SOC_SDA: 10 [passive]
        required HPD: 11 [passive]
        required DP_SYS: 12 [passive]
        required DM_SYS: 13 [passive]
        required SWDIO: 14 [passive]
        required SWDCLK: 15 [passive]
        required XRES: 16 [passive]
    }
}
impl Connector for IfaceHeader {}
pub part J_IFACE: IfaceHeader {
    primary { mfr: "Generic", mpn: "HDR-1x16-2.54", footprint: FP_Header_1x16 }
}
