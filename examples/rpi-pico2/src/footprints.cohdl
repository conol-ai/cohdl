// Board-local Raspberry Pi Pico 2 land patterns. Reusable component
// footprints live with their catalog packages.

// Pico 2.54mm castellations along the two long (51mm) board edges, matching the
// real Pico 2 pinout: pin 1 (GP0) and pin 40 (VBUS) flank the USB end; pin 20
// (GP15) and pin 21 (GP16) flank the DEBUG end.
pub footprint FP_Pico_Castellated_40 {
    pad 1: P_Castellated at (-24.13mm, 8.89mm)
    pad 2: P_Castellated at (-21.59mm, 8.89mm)
    pad 3: P_Castellated at (-19.05mm, 8.89mm)
    pad 4: P_Castellated at (-16.51mm, 8.89mm)
    pad 5: P_Castellated at (-13.97mm, 8.89mm)
    pad 6: P_Castellated at (-11.43mm, 8.89mm)
    pad 7: P_Castellated at (-8.89mm, 8.89mm)
    pad 8: P_Castellated at (-6.35mm, 8.89mm)
    pad 9: P_Castellated at (-3.81mm, 8.89mm)
    pad 10: P_Castellated at (-1.27mm, 8.89mm)
    pad 11: P_Castellated at (1.27mm, 8.89mm)
    pad 12: P_Castellated at (3.81mm, 8.89mm)
    pad 13: P_Castellated at (6.35mm, 8.89mm)
    pad 14: P_Castellated at (8.89mm, 8.89mm)
    pad 15: P_Castellated at (11.43mm, 8.89mm)
    pad 16: P_Castellated at (13.97mm, 8.89mm)
    pad 17: P_Castellated at (16.51mm, 8.89mm)
    pad 18: P_Castellated at (19.05mm, 8.89mm)
    pad 19: P_Castellated at (21.59mm, 8.89mm)
    pad 20: P_Castellated at (24.13mm, 8.89mm)
    pad 21: P_Castellated at (24.13mm, -8.89mm)
    pad 22: P_Castellated at (21.59mm, -8.89mm)
    pad 23: P_Castellated at (19.05mm, -8.89mm)
    pad 24: P_Castellated at (16.51mm, -8.89mm)
    pad 25: P_Castellated at (13.97mm, -8.89mm)
    pad 26: P_Castellated at (11.43mm, -8.89mm)
    pad 27: P_Castellated at (8.89mm, -8.89mm)
    pad 28: P_Castellated at (6.35mm, -8.89mm)
    pad 29: P_Castellated at (3.81mm, -8.89mm)
    pad 30: P_Castellated at (1.27mm, -8.89mm)
    pad 31: P_Castellated at (-1.27mm, -8.89mm)
    pad 32: P_Castellated at (-3.81mm, -8.89mm)
    pad 33: P_Castellated at (-6.35mm, -8.89mm)
    pad 34: P_Castellated at (-8.89mm, -8.89mm)
    pad 35: P_Castellated at (-11.43mm, -8.89mm)
    pad 36: P_Castellated at (-13.97mm, -8.89mm)
    pad 37: P_Castellated at (-16.51mm, -8.89mm)
    pad 38: P_Castellated at (-19.05mm, -8.89mm)
    pad 39: P_Castellated at (-21.59mm, -8.89mm)
    pad 40: P_Castellated at (-24.13mm, -8.89mm)
}

// TP-1221U-K9K5325 (XKB) BOOTSEL button. Terminal A = pads 1/2;
// terminal B = pads 3/4.
pub footprint FP_SW_SPST_TP1221U {
    pad 1: P_Switch_SMD_Tact at (-2.625mm, -0.85mm)
    pad 2: P_Switch_SMD_Tact at (-2.625mm, 0.85mm)
    pad 3: P_Switch_SMD_Tact at (2.625mm, -0.85mm)
    pad 4: P_Switch_SMD_Tact at (2.625mm, 0.85mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.9mm, 3.7mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}
