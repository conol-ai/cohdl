// Awinic AW21009: 9-channel constant-current LED driver, I2C, 2.7-5.5V
// (datasheet V1.1, July 2021). QFN20+EP 3x3mm 0.4 pitch (p31).
// Pin definition p3.

#[doc("docs/aw21009.pdf")]
pub device AW21009 {
    pins {
        optional NC1: 1 [passive] // not connected (p3)
        optional LED1: 2 [output] // constant current sink, LED cathode (p3)
        optional LED2: 3 [output]
        optional LED3: 4 [output]
        optional LED4: 5 [output]
        optional LED5: 6 [output]
        optional LED6: 7 [output]
        optional LED7: 8 [output]
        optional LED8: 9 [output]
        optional LED9: 10 [output]
        optional NC11: 11 [passive]
        optional NC12: 12 [passive]
        optional NC13: 13 [passive]
        required AD0: 14 [input] // I2C address strap — tie GND or VCC (p3)
        required AD1: 15 [input]
        required VCC: 16 [power_in] // 2.7-5.5V (p3)
        optional SDA: 17 [bidirectional] // I2C data (p3)
        optional SCL: 18 [input] // I2C clock (p3)
        required EN: 19 [input] // shutdown when LOW (p3)
        required ISET: 20 [passive] // external REXT to GND sets global current (p3)
        required GND: 21 [power_in] // exposed pad ground (p3, p31 EP)
    }
}

impl IC for AW21009 {}

#[doc("docs/aw21009.pdf")]
pub part LEDDRV_AW21009: AW21009 {
    primary { mfr: "Awinic", mpn: "AW21009QNR", footprint: QFN20N40P300X300_1EP170X170 }
}

// Awinic land-pattern data (p32): 0.50 x 0.20 mm perimeter copper,
// 0.40 mm pitch, 3.20 mm outside copper span (row centres +/-1.35 mm),
// and a 1.70 mm square exposed-pad land.
pub pad P_AW21009_QFN20_LEAD_H {
    shape: rect
    size: (0.5mm, 0.2mm)
    layer: top_copper
    plating: smd
}

pub pad P_AW21009_QFN20_LEAD_V {
    shape: rect
    size: (0.2mm, 0.5mm)
    layer: top_copper
    plating: smd
}

pub pad P_AW21009_QFN20_EP170 {
    shape: rect
    size: (1.7mm, 1.7mm)
    layer: top_copper
    plating: smd
}

pub footprint QFN20N40P300X300_1EP170X170 {
    pad 1: P_AW21009_QFN20_LEAD_H at (-1.35mm, -0.8mm)
    pad 2: P_AW21009_QFN20_LEAD_H at (-1.35mm, -0.4mm)
    pad 3: P_AW21009_QFN20_LEAD_H at (-1.35mm, 0mm)
    pad 4: P_AW21009_QFN20_LEAD_H at (-1.35mm, 0.4mm)
    pad 5: P_AW21009_QFN20_LEAD_H at (-1.35mm, 0.8mm)
    pad 6: P_AW21009_QFN20_LEAD_V at (-0.8mm, 1.35mm)
    pad 7: P_AW21009_QFN20_LEAD_V at (-0.4mm, 1.35mm)
    pad 8: P_AW21009_QFN20_LEAD_V at (0mm, 1.35mm)
    pad 9: P_AW21009_QFN20_LEAD_V at (0.4mm, 1.35mm)
    pad 10: P_AW21009_QFN20_LEAD_V at (0.8mm, 1.35mm)
    pad 11: P_AW21009_QFN20_LEAD_H at (1.35mm, 0.8mm)
    pad 12: P_AW21009_QFN20_LEAD_H at (1.35mm, 0.4mm)
    pad 13: P_AW21009_QFN20_LEAD_H at (1.35mm, 0mm)
    pad 14: P_AW21009_QFN20_LEAD_H at (1.35mm, -0.4mm)
    pad 15: P_AW21009_QFN20_LEAD_H at (1.35mm, -0.8mm)
    pad 16: P_AW21009_QFN20_LEAD_V at (0.8mm, -1.35mm)
    pad 17: P_AW21009_QFN20_LEAD_V at (0.4mm, -1.35mm)
    pad 18: P_AW21009_QFN20_LEAD_V at (0mm, -1.35mm)
    pad 19: P_AW21009_QFN20_LEAD_V at (-0.4mm, -1.35mm)
    pad 20: P_AW21009_QFN20_LEAD_V at (-0.8mm, -1.35mm)
    pad 21: P_AW21009_QFN20_EP170 at (0mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.8mm, 3.8mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}
