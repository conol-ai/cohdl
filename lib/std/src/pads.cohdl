// SOD-123W / SOD-123F flat-lead diode terminal (Nexperia CFP3; pads at
// ±1.4mm, 1.2x1.2mm — KiCad Diode_SMD:Nexperia_CFP3_SOD-123W).
pub pad P_SOD123W_Term {
    shape: rect
    size: (1.2mm, 1.2mm)
    layer: top_copper
    plating: smd
}

// SMD tactile-switch terminal (Panasonic EVQPU-class land, 1.55x1.0mm).
pub pad P_Switch_SMD_Tact {
    shape: rect
    size: (1.55mm, 1.0mm)
    layer: top_copper
    plating: smd
}

// Micro-USB Type-B SMD land (Molex 105017-0001, KiCad
// Connector_USB:USB_Micro-B_Molex-105017-0001). The five signal pads are
// NARROW and TALL (0.4 wide x 1.35 long, 0.65mm pitch) — reaching toward the
// connector mouth, not sideways.
pub pad P_USB_uB_Sig {
    shape: rect
    size: (0.4mm, 1.35mm)
    layer: top_copper
    plating: smd
}

// Micro-USB shell tab — large SMD ground pad (the two inner shell tabs).
pub pad P_USB_uB_TabL {
    shape: rect
    size: (1.5mm, 1.9mm)
    layer: top_copper
    plating: smd
}

// Micro-USB shell tab — smaller SMD ground pad (the two outer shell tabs).
pub pad P_USB_uB_TabS {
    shape: rect
    size: (1.2mm, 1.9mm)
    layer: top_copper
    plating: smd
}

// Micro-USB corner shell anchor — a plated slotted hole in the real part
// (0.6x1.3mm oval drill); CoHDL drills are round, so approximated as a 0.9mm
// plated through-hole under the 1.2x1.9mm oval pad (demo-grade mechanical).
pub pad P_USB_uB_Slot {
    shape: oval
    size: (1.2mm, 1.9mm)
    layer: through_all
    plating: plated_through_hole
    drill: 0.9mm
}

// Micro-USB through-hole mounting peg (0.85mm plated hole, 1.45mm round pad).
pub pad P_USB_uB_Peg {
    shape: circle
    size: (1.45mm)
    layer: through_all
    plating: plated_through_hole
    drill: 0.85mm
}

// USB Type-C (HRO TYPE-C-31-M-12) power/ground contact land — the 0.6mm-wide
// SMD pads (A1/A4/A9/A12/B1/B4/B9/B12), from KiCad
// Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12.
pub pad P_USBC_Sig_L {
    shape: rect
    size: (0.6mm, 1.45mm)
    layer: top_copper
    plating: smd
}

// USB Type-C signal contact land — the 0.3mm-wide SMD pads
// (CC1/CC2/DP/DN/SBU1/SBU2: A5/A6/A7/A8/B5/B6/B7/B8).
pub pad P_USBC_Sig_S {
    shape: rect
    size: (0.3mm, 1.45mm)
    layer: top_copper
    plating: smd
}

// USB Type-C shield mounting tab — upper pair. The receptacle's shield legs
// are flat stampings, so the hole is a plated SLOT, not a round drill: a round
// hole large enough to clear the leg's long axis would eat the annular ring,
// and one sized to its width will not accept the leg at all.
//
// HRO TYPE-C-31-M-12 "RECOMMEND P.C.B LAYOUT (COMPONENT SIDE)", sheet 1 of 1:
// hole 0.60 wide (`4-0.60`) x 1.70 long, in a 0.90 x 2.00 copper oval — the
// 0.60/0.90 pair dimensioned at the lower left is hole width vs copper width,
// leaving a 0.15mm annular ring all round. Layout tolerance ±0.05.
pub pad P_USBC_Shield_T {
    shape: oval
    size: (0.9mm, 2mm)
    layer: through_all
    plating: plated_through_hole
    drill: (0.6mm, 1.7mm)
}

// USB Type-C shield mounting tab — lower pair. Same 0.60 slot width and the
// same 0.15mm ring; only the length differs (1.40 hole in a 1.70 copper oval).
pub pad P_USBC_Shield_B {
    shape: oval
    size: (0.9mm, 1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: (0.6mm, 1.4mm)
}

// Pico 2.54mm castellation — a plated HALF-through-hole at the board edge
// (drilled, plated, then castellated on depanel). Modeled as a plated
// through-hole, matching KiCad's RaspberryPi_Pico_Common_THT (drill 1.0mm).
pub pad P_Castellated {
    shape: circle
    size: (1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: 1mm
}

// 0.4mm-pitch QFN lead land (TI RSL0048 / TPS59650): 0.85mm radial x 0.20mm,
// NSMD. Left/right sides (long axis horizontal).
pub pad P_QFN040_Lead_H {
    shape: rect
    size: (0.85mm, 0.2mm)
    layer: top_copper
    plating: smd
}

// 0.4mm-pitch QFN lead land, top/bottom sides (long axis vertical).
pub pad P_QFN040_Lead_V {
    shape: rect
    size: (0.2mm, 0.85mm)
    layer: top_copper
    plating: smd
}

// TPS59650 exposed thermal PowerPAD land (4.05 x 3.60mm), TI drawing 4207841.
pub pad P_TPS59650_EP {
    shape: rect
    size: (4.05mm, 3.6mm)
    layer: top_copper
    plating: smd
}

// Infineon CCG6DF 96-ball BGA solder-ball land (Ø0.30mm ball, NSMD ~0.27mm).
pub pad P_BGA_Ball {
    shape: circle
    size: (0.27mm)
    layer: top_copper
    plating: smd
}
