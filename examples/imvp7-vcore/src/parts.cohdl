// imvp7-vcore example parts — the external driver, power FETs, inductor, NTC
// thermistors, and interface header around the std::TPS59650 controller.

pub trait Transistor {
    designator_prefix: "Q"
}
pub trait Inductor {
    designator_prefix: "L"
}
pub trait Thermistor {
    designator_prefix: "RT"
}

// TI TPS51601A — dual (HS+LS) synchronous-buck MOSFET driver with integrated
// bootstrap boost switch (no external boot diode), 8-pin VSON-8. Drives the
// TPS59650's PWM-output phases (CPU phase 3, GPU phases 1/2).
pub device TPS51601A {
    pins {
        required BST: 1 [input] // high-side bootstrap (cap to SW)
        required SKIP: 2 [input] // zero-cross / FCCM select
        required PWM: 3 [input] // PWM from the controller
        required GND: 4 [power_in]
        required DRVL: 5 [output] // low-side gate drive
        required VDD: 6 [power_in] // 5V supply
        required SW: 7 [bidirectional] // switch node / HS gate return
        required DRVH: 8 [output] // high-side gate drive
        required EP: 9 [passive] // thermal pad -> GND
    }
}
impl IC for TPS51601A {}
pub part DRV_TPS51601A: TPS51601A {
    primary { mfr: "Texas Instruments", mpn: "TPS51601ADRB", footprint: QFN8N65P300X300_1EP165X240 }
}

// N-channel power MOSFET, PowerPAK SO-8 (1-3 Source, 4 Gate, 5-8 Drain).
// Demo-grade stand-in for TIDA-00021's CSD87350Q5D NexFET power blocks.
pub device NFET_SO8 {
    pins {
        required S: 1, 2, 3 [passive]
        required G: 4 [input]
        required D: 5, 6, 7, 8 [passive]
    }
}
impl Transistor for NFET_SO8 {}
pub part FET_NEXFET: NFET_SO8 {
    primary { mfr: "Infineon", mpn: "IRF7413", footprint: SOIC8P127X600X175N }
}

// Vcore output inductor (~0.36uH class, TIDA-00021 FCUL1040-H-R36M).
pub device PowerInductor {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
    }
}
impl Inductor for PowerInductor {}
pub part IND_VCORE: PowerInductor {
    primary { mfr: "Toko", mpn: "FCUL1040-H-R36M", footprint: FP_Ind_Pwr_5040 }
}

// 100k NTC thermistor (0603) for the controller CTHERM/GTHERM VR-thermal inputs.
pub device NTC_100k {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
    }
}
impl Thermistor for NTC_100k {}
pub part NTC_MURATA: NTC_100k {
    primary { mfr: "Murata", mpn: "NCP18WF104J03RB", footprint: CHIP_0603 }
}

// 1x14 interface header: supplies + SVID + enable + status + both Vcore rails.
pub device VcoreHeader {
    pins {
        required VBAT: 1 [passive]
        required V5: 2 [passive]
        required V3R3: 3 [passive]
        required V5DRV: 4 [passive]
        required GND: 5 [passive]
        required VR_ON: 6 [passive]
        required VCLK: 7 [passive]
        required VDIO: 8 [passive]
        required ALERT: 9 [passive]
        required CPGOOD: 10 [passive]
        required VR_HOT: 11 [passive]
        required GPGOOD: 12 [passive]
        required VCC_CPU: 13 [passive]
        required VCC_GFX: 14 [passive]
    }
}
impl Connector for VcoreHeader {}
pub part J_IFACE: VcoreHeader {
    primary { mfr: "Generic", mpn: "HDR-1x14-2.54", footprint: FP_Header_1x14 }
}
