pub pad P_HIROSE_FH12_CONTACT {
    shape: rect
    size: (0.3mm, 1.3mm)
    layer: top_copper
    plating: smd
}

pub pad P_HIROSE_FH12_HOLD_DOWN {
    shape: rect
    size: (1.8mm, 2.2mm)
    layer: top_copper
    plating: smd
}

// Hirose FH12 0.5mm bottom-contact land (FH12 catalogue p.11): contacts
// 0.3 x 1.3, hold-downs 1.8 x 2.2 centred at x = +/-(B + C) / 4 with B = 10.1,
// C = 6.5. Origin between the hold-downs; contacts towards -y. Courtyard
// matches KiCad's Hirose_FH12-10S-0.5SH footprint and contains the body.
pub footprint FP_FPC10_0P5 {
    pad 1: P_HIROSE_FH12_CONTACT at (-2.25mm, -1.85mm)
    pad 2: P_HIROSE_FH12_CONTACT at (-1.75mm, -1.85mm)
    pad 3: P_HIROSE_FH12_CONTACT at (-1.25mm, -1.85mm)
    pad 4: P_HIROSE_FH12_CONTACT at (-0.75mm, -1.85mm)
    pad 5: P_HIROSE_FH12_CONTACT at (-0.25mm, -1.85mm)
    pad 6: P_HIROSE_FH12_CONTACT at (0.25mm, -1.85mm)
    pad 7: P_HIROSE_FH12_CONTACT at (0.75mm, -1.85mm)
    pad 8: P_HIROSE_FH12_CONTACT at (1.25mm, -1.85mm)
    pad 9: P_HIROSE_FH12_CONTACT at (1.75mm, -1.85mm)
    pad 10: P_HIROSE_FH12_CONTACT at (2.25mm, -1.85mm)
    pad MP: P_HIROSE_FH12_HOLD_DOWN at (-4.15mm, 1.4mm)
    pad MP: P_HIROSE_FH12_HOLD_DOWN at (4.15mm, 1.4mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0.95mm), size: (11.12mm, 7.9mm) }
    silkscreen_ref { at: (0mm, -3.7mm) }
}

