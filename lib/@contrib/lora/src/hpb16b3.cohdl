// HPB16B3: 12-pin LoRa module used by LilyGO's T-Display-SF32 V1.0.
// The official host-board schematic (p2, U3) establishes this exact symbol
// identity and pin order. SX1262 bare-die support is in @contrib/lora, but the
// schematic alone does not establish the module's internal implementation.
//
// HPB16B3 is not the 16-pin HPD16A. No HPB16B3 module drawing, recommended
// land pattern, or standalone electrical specification is published in the
// official board repository, so the part remains quarantined.

#[doc("docs/hpb16b3-provenance.txt")]
pub device HPB16B3 {
    pins {
        required VCC: 1 [power_in] // module supply; voltage is not specified by the schematic
        required GND2: 2 [power_in]
        optional NRESET: 3 [input] // module reset, active-low
        optional BUSY: 4 [output] // busy status
        optional DIO1: 5 [bidirectional] // digital I/O / interrupt
        optional DIO3: 6 [bidirectional] // digital I/O
        optional MISO: 7 [output] // SPI data out
        optional MOSI: 8 [input] // SPI data in
        optional SCK: 9 [input] // SPI clock
        optional NSS: 10 [input] // SPI chip select, active-low
        required GND11: 11 [power_in]
        optional ANT: 12 [passive] // RF antenna
    }
}

impl IC for HPB16B3 {}

// No part declaration: module mechanical outline is unpublished, so the
// footprint cannot be authored for fabrication (omit-never-assert).
// When the manufacturer publishes the HPB16B3 dimension drawing, add:
//   pub part LORA_HPB16B3: HPB16B3 {
//       primary { mfr: "LilyGO", mpn: "HPB16B3", footprint: <FP_HPB16B3> }
//   }
