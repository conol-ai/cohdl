// QFN, DFN, and SON land patterns.
//
// This 7x7mm, 0.40mm-pitch geometry comes from Espressif's official
// ESP32-S3 PADS source:
// https://www.espressif.com/sites/default/files/chips-dxf/ESP32-S3_Footprint.asc
// Retrieved 2026-07-30; SHA-256
// 2f0e059f9ecef4350413068280a14e6f1f3e3792f512116b27138d4a6810fb5c.
//
// The CAD coordinates were checked against the package and recommended-land-
// pattern drawings in the ESP32-S3 Series Datasheet v2.2.

// QFN56 perimeter lead land: 0.22mm tangential x 0.65mm radial, 0.40mm
// pitch. Left/right placements use this orientation directly; top/bottom
// placements rotate it by 90 degrees.
pub pad P_QFN56N40P700X700_LEAD {
    shape: rect
    size: (0.65mm, 0.22mm)
    layer: top_copper
    plating: smd
}

// The source uses its same-size oval-finger pad stack at the two leads
// flanking the pin-1 package corner (pins 1 and 56).
pub pad P_QFN56N40P700X700_LEAD_CORNER {
    shape: oval
    size: (0.65mm, 0.22mm)
    layer: top_copper
    plating: smd
}

// The PADS source composes EP pin 57 from a 3x3 grid of 1.0x1.0mm copper
// regions on 1.5mm centres (4.0x4.0mm overall), with thermal vias and segmented
// paste. CoHDL cannot repeat pad number 57 or express independent paste/mask
// apertures, so this pad preserves the official full copper envelope. Segment
// the paste into the official 3x3 grid and add the thermal vias during layout.
pub pad P_QFN56N40P700X700_EP400X400 {
    shape: rect
    size: (4mm, 4mm)
    layer: top_copper
    plating: smd
}

// QFN56, 7x7mm body, 0.40mm pitch, 4x4mm exposed pad. Origin is package
// centre; numbering follows the top view counter-clockwise from pin 1 at the
// upper left. Espressif's ASC is Cartesian +Y-up, so Y is negated for
// CoHDL/KiCad.
pub footprint QFN56N40P700X700_1EP400X400 {
    pad 1: P_QFN56N40P700X700_LEAD_CORNER at (-3.425mm, -2.6mm)
    pad 2: P_QFN56N40P700X700_LEAD at (-3.425mm, -2.2mm)
    pad 3: P_QFN56N40P700X700_LEAD at (-3.425mm, -1.8mm)
    pad 4: P_QFN56N40P700X700_LEAD at (-3.425mm, -1.4mm)
    pad 5: P_QFN56N40P700X700_LEAD at (-3.425mm, -1mm)
    pad 6: P_QFN56N40P700X700_LEAD at (-3.425mm, -0.6mm)
    pad 7: P_QFN56N40P700X700_LEAD at (-3.425mm, -0.2mm)
    pad 8: P_QFN56N40P700X700_LEAD at (-3.425mm, 0.2mm)
    pad 9: P_QFN56N40P700X700_LEAD at (-3.425mm, 0.6mm)
    pad 10: P_QFN56N40P700X700_LEAD at (-3.425mm, 1mm)
    pad 11: P_QFN56N40P700X700_LEAD at (-3.425mm, 1.4mm)
    pad 12: P_QFN56N40P700X700_LEAD at (-3.425mm, 1.8mm)
    pad 13: P_QFN56N40P700X700_LEAD at (-3.425mm, 2.2mm)
    pad 14: P_QFN56N40P700X700_LEAD at (-3.425mm, 2.6mm)
    pad 15: P_QFN56N40P700X700_LEAD at (-2.6mm, 3.425mm) rotate 90
    pad 16: P_QFN56N40P700X700_LEAD at (-2.2mm, 3.425mm) rotate 90
    pad 17: P_QFN56N40P700X700_LEAD at (-1.8mm, 3.425mm) rotate 90
    pad 18: P_QFN56N40P700X700_LEAD at (-1.4mm, 3.425mm) rotate 90
    pad 19: P_QFN56N40P700X700_LEAD at (-1mm, 3.425mm) rotate 90
    pad 20: P_QFN56N40P700X700_LEAD at (-0.6mm, 3.425mm) rotate 90
    pad 21: P_QFN56N40P700X700_LEAD at (-0.2mm, 3.425mm) rotate 90
    pad 22: P_QFN56N40P700X700_LEAD at (0.2mm, 3.425mm) rotate 90
    pad 23: P_QFN56N40P700X700_LEAD at (0.6mm, 3.425mm) rotate 90
    pad 24: P_QFN56N40P700X700_LEAD at (1mm, 3.425mm) rotate 90
    pad 25: P_QFN56N40P700X700_LEAD at (1.4mm, 3.425mm) rotate 90
    pad 26: P_QFN56N40P700X700_LEAD at (1.8mm, 3.425mm) rotate 90
    pad 27: P_QFN56N40P700X700_LEAD at (2.2mm, 3.425mm) rotate 90
    pad 28: P_QFN56N40P700X700_LEAD at (2.6mm, 3.425mm) rotate 90
    pad 29: P_QFN56N40P700X700_LEAD at (3.425mm, 2.6mm)
    pad 30: P_QFN56N40P700X700_LEAD at (3.425mm, 2.2mm)
    pad 31: P_QFN56N40P700X700_LEAD at (3.425mm, 1.8mm)
    pad 32: P_QFN56N40P700X700_LEAD at (3.425mm, 1.4mm)
    pad 33: P_QFN56N40P700X700_LEAD at (3.425mm, 1mm)
    pad 34: P_QFN56N40P700X700_LEAD at (3.425mm, 0.6mm)
    pad 35: P_QFN56N40P700X700_LEAD at (3.425mm, 0.2mm)
    pad 36: P_QFN56N40P700X700_LEAD at (3.425mm, -0.2mm)
    pad 37: P_QFN56N40P700X700_LEAD at (3.425mm, -0.6mm)
    pad 38: P_QFN56N40P700X700_LEAD at (3.425mm, -1mm)
    pad 39: P_QFN56N40P700X700_LEAD at (3.425mm, -1.4mm)
    pad 40: P_QFN56N40P700X700_LEAD at (3.425mm, -1.8mm)
    pad 41: P_QFN56N40P700X700_LEAD at (3.425mm, -2.2mm)
    pad 42: P_QFN56N40P700X700_LEAD at (3.425mm, -2.6mm)
    pad 43: P_QFN56N40P700X700_LEAD at (2.6mm, -3.425mm) rotate 90
    pad 44: P_QFN56N40P700X700_LEAD at (2.2mm, -3.425mm) rotate 90
    pad 45: P_QFN56N40P700X700_LEAD at (1.8mm, -3.425mm) rotate 90
    pad 46: P_QFN56N40P700X700_LEAD at (1.4mm, -3.425mm) rotate 90
    pad 47: P_QFN56N40P700X700_LEAD at (1mm, -3.425mm) rotate 90
    pad 48: P_QFN56N40P700X700_LEAD at (0.6mm, -3.425mm) rotate 90
    pad 49: P_QFN56N40P700X700_LEAD at (0.2mm, -3.425mm) rotate 90
    pad 50: P_QFN56N40P700X700_LEAD at (-0.2mm, -3.425mm) rotate 90
    pad 51: P_QFN56N40P700X700_LEAD at (-0.6mm, -3.425mm) rotate 90
    pad 52: P_QFN56N40P700X700_LEAD at (-1mm, -3.425mm) rotate 90
    pad 53: P_QFN56N40P700X700_LEAD at (-1.4mm, -3.425mm) rotate 90
    pad 54: P_QFN56N40P700X700_LEAD at (-1.8mm, -3.425mm) rotate 90
    pad 55: P_QFN56N40P700X700_LEAD at (-2.2mm, -3.425mm) rotate 90
    pad 56: P_QFN56N40P700X700_LEAD_CORNER at (-2.6mm, -3.425mm) rotate 90
    pad 57: P_QFN56N40P700X700_EP400X400 at (0mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (7.7mm, 7.7mm) }
    silkscreen_ref { at: (0mm, -4.4mm) }
}

// Raspberry Pi RP2350 datasheet build 2025-07-29, Figure 144:
// https://datasheets.raspberrypi.com/rp2350/rp2350-datasheet.pdf
//
// The official land pattern has 60 perimeter lands at 0.40mm pitch,
// 0.875x0.20mm lands, 7.75mm overall land span, and a 3.40x3.40mm
// exposed pad. Datasheet +Y is negated for CoHDL/KiCad. CoHDL represents
// the exposed copper as one pad; paste segmentation and thermal vias remain
// board-manufacturing decisions.
pub pad P_QFN60N40P700X700_LEAD_H {
    shape: rect
    size: (0.875mm, 0.2mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN60N40P700X700_LEAD_V {
    shape: rect
    size: (0.2mm, 0.875mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN60N40P700X700_EP340X340 {
    shape: rect
    size: (3.4mm, 3.4mm)
    layer: top_copper
    plating: smd
}

pub footprint QFN60N40P700X700_1EP340X340 {
