    pad 69: P_SF32LB52X_EP_PASTE_WINDOW at (0mm, 1.83mm)
    pad 69: P_SF32LB52X_EP_PASTE_WINDOW at (1.83mm, 1.83mm)
    pad 69: P_SF32LB52X_EP_VIA at (-2.495mm, -2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (-0.831667mm, -2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (0.831667mm, -2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (2.495mm, -2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (-2.495mm, -0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (-0.831667mm, -0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (0.831667mm, -0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (2.495mm, -0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (-2.495mm, 0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (-0.831667mm, 0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (0.831667mm, 0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (2.495mm, 0.831667mm)
    pad 69: P_SF32LB52X_EP_VIA at (-2.495mm, 2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (-0.831667mm, 2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (0.831667mm, 2.495mm)
    pad 69: P_SF32LB52X_EP_VIA at (2.495mm, 2.495mm)
    pad 69: P_SF32LB52X_EP_BOTTOM at (0mm, 0mm)

    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (7.65mm, 7.65mm) }
    silkscreen_ref { at: (0mm, -4.1mm) }
}
