    net GND [gnd]: m.GND2, m.GND9, m.GND16
    net ANT: m.ANT
    net SCKN: m.SCK
    net MOSIN: m.MOSI
    net MISON: m.MISO
    net NSSN: m.NSS
    net RSTN: m.NRESET
    net BUSYN: m.BUSY
    net D1: m.DIO1
    net D3: m.DIO3
    nc: m.NC4, m.NC6, m.NC15
}
