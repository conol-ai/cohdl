    pad K6: P_BGA_Inner at (0mm, 2mm)
    pad K7: P_BGA_Inner at (0.5mm, 2mm)
    pad K8: P_BGA_Inner at (1mm, 2mm)
    pad K9: P_BGA_Inner at (1.5mm, 2mm)
    pad K10: P_BGA_Inner at (2mm, 2mm)
    pad K11: P_BGA_Outer_H at (2.5mm, 2mm)
    pad L1: P_BGA_Outer_Corner at (-2.5mm, 2.5mm)
    pad L2: P_BGA_Outer_V at (-2mm, 2.5mm)
    pad L3: P_BGA_Outer_V at (-1.5mm, 2.5mm)
