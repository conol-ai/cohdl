// Mounting holes are mechanical features, not ICs: give them an "M"
// designator prefix instead of the default "U".
pub trait Mounting_Hole {
    designator_prefix: "M"
}

// Test points are probe-access features, not ICs: give them a "TP"
// designator prefix instead of the default "U".
pub trait Test_Point {
    designator_prefix: "TP"
}

#[doc("docs/README.md")]
pub device TestPoint {
    pins {
        required SIGNAL: 1 [passive]
    }
}

impl Test_Point for TestPoint {}

#[doc("docs/README.md")]
pub device MechanicalMountingHole {
}

impl Mounting_Hole for MechanicalMountingHole {}

#[doc("docs/README.md")]
pub device PlatedMountingHole {
    pins {
        required PAD: 1 [passive]
    }
}

impl Mounting_Hole for PlatedMountingHole {}

pad P_TEST_POINT_ROUND_1MM {
    shape: circle
    size: (1mm)
    layer: top_copper
    plating: smd
    paste: none
}

pad P_MOUNTING_HOLE_M2_PTH_2P2_4P0 {
    shape: circle
    size: (4mm)
    layer: through_all
    plating: plated_through_hole
    drill: 2.2mm
}

pub footprint FP_TEST_POINT_ROUND_1MM {
    pad 1: P_TEST_POINT_ROUND_1MM at (0mm, 0mm)
    courtyard { shape: circle, at: (0mm, 0mm), size: (1.5mm) }
}

pub footprint FP_MOUNTING_HOLE_M2_NPTH_2P2 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 2.2mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (4.4mm) }
}

pub footprint FP_MOUNTING_HOLE_M2_PTH_2P2_4P0 {
    pad 1: P_MOUNTING_HOLE_M2_PTH_2P2_4P0 at (0mm, 0mm)
    courtyard { shape: circle, at: (0mm, 0mm), size: (4.4mm) }
}

#[doc("docs/README.md")]
pub part TEST_POINT_ROUND_1MM: TestPoint {
    primary { mfr: "PCB Fabrication", mpn: "TESTPOINT-ROUND-1.0MM-SMD",
              footprint: FP_TEST_POINT_ROUND_1MM }
}

#[doc("docs/README.md")]
pub part MOUNTING_HOLE_M2_NPTH: MechanicalMountingHole {
    primary { mfr: "PCB Fabrication", mpn: "MOUNTING-HOLE-M2-NPTH-2.2MM",
              footprint: FP_MOUNTING_HOLE_M2_NPTH_2P2 }
    alt { mfr: "PCB Fabrication", mpn: "MOUNTING-HOLE-2.2-NPTH" }
    alt { mfr: "PCB Fabrication", mpn: "MOUNTING-HOLE-2P2-NPTH" }
}

#[doc("docs/README.md")]
pub part MOUNTING_HOLE_M2_PTH: PlatedMountingHole {
    primary { mfr: "PCB Fabrication", mpn: "MOUNTING-HOLE-M2-PTH-2.2MM-4.0MM",
              footprint: FP_MOUNTING_HOLE_M2_PTH_2P2_4P0 }
}

// Holes below are named by drill diameter rather than by the screw they happen
// to clear. A 3.2 mm hole is M3 clearance and a 1.7 mm hole is M1.6 clearance
// under the usual tables, but that is an inference about the fastener, not a
// property of the fabrication feature, and the M2 holes above keep their names
// only because renaming a published part would change a locked version.

pad P_TEST_POINT_ROUND_1P5MM {
    shape: circle
    size: (1.5mm)
    layer: top_copper
    plating: smd
    paste: none
}

pub footprint FP_TEST_POINT_ROUND_1P5MM {
    pad 1: P_TEST_POINT_ROUND_1P5MM at (0mm, 0mm)
    courtyard { shape: circle, at: (0mm, 0mm), size: (2mm) }
}

pub footprint FP_MOUNTING_HOLE_NPTH_1P0 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 1mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (2mm) }
}

pub footprint FP_MOUNTING_HOLE_NPTH_1P7 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 1.7mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (3.4mm) }
}

pub footprint FP_MOUNTING_HOLE_NPTH_2P0 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 2mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (4mm) }
}

pub footprint FP_MOUNTING_HOLE_NPTH_2P7 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 2.7mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (5.4mm) }
