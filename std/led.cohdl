// Status LED: red chip LED, 0603.
// Chip-LED convention: pad 1 = cathode, pad 2 = anode.

pub device ChipLED {
    pins {
        required Cathode: 1 [passive]
        required Anode: 2 [passive]
    }
}

impl Polarized for ChipLED {}
impl Diode for ChipLED {}

pub part LED_RED_0603: ChipLED {
    primary { mfr: "Lite-On", mpn: "LTST-C193KRKT-5A", footprint: "LED_SMD:LED_0603_1608Metric" }
}

// A status LED with its series resistor: signal → R → LED → GND.
pub fn status_led(signal: Pin, gnd: Pin) {
    inst r: RES_1K_0402
    inst led: LED_RED_0603
    net _: signal, r.A
    net _: r.B, led.Anode
    net _: led.Cathode, gnd
}
