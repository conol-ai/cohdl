// Reference implementation of the MVP demo board (hand-written; the AI
// harness generates its own equivalent from the same natural-language spec):
// an ESP32-S3 sensor node — USB-C power/data, one MEMS microphone, one
// status LED, a 3.3V LDO, standard decoupling.

design SensorNode {
    inst usb: USB_C_HRO_TYPE_C_31_M_12
    inst ldo: LDO_AP2112K_3V3
    inst esp: ESP32_S3_WROOM_1_N8
    inst mic: MIC_ICS43434
    inst r_cc1: RES_5K1_0402
    inst r_cc2: RES_5K1_0402
    inst r_en: RES_10K_0402
    inst c_ldo_in: MLCC_1uF_10V_0402
    inst c_ldo_out: MLCC_1uF_10V_0402

    // Power path: USB VBUS → LDO → 3.3V rail. EN tied to VIN.
    net VBUS [5V]: usb.VBUS, ldo.VIN, ldo.EN, c_ldo_in.A
    net VDD_3V3 [3.3V]: ldo.VOUT, esp.VDD, mic.VDD, c_ldo_out.A, r_en.A

    // ESP32-S3 chip-enable: 10k pull-up to 3.3V.
    net ESP_EN: r_en.B, esp.EN
    net GND [gnd]: usb.GND, usb.SHIELD, ldo.GND, esp.GND, mic.GND, mic.LR, r_cc1.B, r_cc2.B,
                   c_ldo_in.B, c_ldo_out.B

    // USB-C sink: 5.1k pull-downs on CC, data to the ESP32-S3's USB pins.
    net CC1: usb.CC1, r_cc1.A
    net CC2: usb.CC2, r_cc2.A
    net USB_DN: usb.DN, esp.IO19
    net USB_DP: usb.DP, esp.IO20

    // I2S microphone.
    net MIC_WS: esp.IO5, mic.WS
    net MIC_SCK: esp.IO6, mic.SCK
    net MIC_SD: esp.IO7, mic.SD

    // Status LED on IO48, sub-circuit from std.
    status_led(esp.IO48, esp.GND)

    // Standard decoupling: bulk on the rail + 100nF at each consumer.
    bulk_10u(ldo.VOUT, ldo.GND)
    decoupling_100n(esp.VDD, esp.GND)
    decoupling_100n(mic.VDD, mic.GND)
}
