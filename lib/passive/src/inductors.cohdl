pub trait Inductor {
    designator_prefix: "L"
}

#[doc("docs/murata_dfe201612e_detailed_specification.pdf")]
#[doc("docs/murata_lqh2mcn_detailed_specification.pdf")]
pub device ChipInductor<L: Inductance> {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
    }
    spec {
        inductance: L
    }
}

impl Inductor for ChipInductor {}

#[doc("docs/murata_dfe201612e_detailed_specification.pdf")]
pub part IND_2U2: ChipInductor<2.2uH> {
    primary { mfr: "Murata", mpn: "DFE201612E-2R2M=P2", footprint: FP_L_0806_2016Metric }
}

#[doc("docs/murata_lqh2mcn_detailed_specification.pdf")]
pub part IND_3U3: ChipInductor<3.3uH> {
    primary { mfr: "Murata", mpn: "LQH2MCN3R3M52L", footprint: FP_L_LQH2MCN_2016Metric }
}

// SiFli's SF32LB52 reference design selects this 4.7uH inductor for the
// controller's internal buck converter. Its 1.30A minimum saturation current
// and 0.288ohm maximum DCR exceed the SF32 hardware guide's 0.45A / 0.4ohm
// requirements.
#[doc("docs/sunlord_wpn_series.pdf")]
pub part IND_4U7_WPN201610U: ChipInductor<4.7uH> {
    primary { mfr: "Sunlord", mpn: "WPN201610U4R7MT", footprint: FP_L_WPN201610U_2016Metric }
}

// Coilcraft 0402DC high-Q wirewound inductors. The J suffix selects +/-5%
// tolerance, R the RoHS matte-tin termination and W the 7-inch reel.
#[doc("docs/coilcraft_0402dc.evidence.md")]
pub part IND_2N0_COILCRAFT_0402DC: ChipInductor<2nH> {
    primary { mfr: "Coilcraft", mpn: "0402DC-2N0XJRW", footprint: FP_COILCRAFT_0402DC }
}

#[doc("docs/coilcraft_0402dc.evidence.md")]
pub part IND_3N0_COILCRAFT_0402DC: ChipInductor<3nH> {
    primary { mfr: "Coilcraft", mpn: "0402DC-3N0XJRW", footprint: FP_COILCRAFT_0402DC }
}

// DFE201612E body: 2.0 +/-0.2 x 1.6 +/-0.2mm, terminal length
// 0.5 +0.3/-0mm. IPC-7351 nominal land, checked against the official package
// drawing in J(E)TE243A-0006D-01.
pub pad P_Ind_0806 {
    shape: rect
    size: (1mm, 1.75mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_L_0806_2016Metric {
    pad 1: P_Ind_0806 at (-0.95mm, 0mm)
    pad 2: P_Ind_0806 at (0.95mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.9mm, 1.75mm) }
    silkscreen_ref { at: (0mm, -1.75mm) }
}

// LQH2MCN_52 official reflow land (JELF243A-0060P section 11.1):
// 2.6mm copper span, 0.8mm inner gap, and 1.0mm land width. Therefore each
// land is 0.9 x 1.0mm and its centre is 0.85mm from the package origin.
pub pad P_LQH2MCN_0806 {
    shape: rect
    size: (0.9mm, 1mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_L_LQH2MCN_2016Metric {
    pad 1: P_LQH2MCN_0806 at (-0.85mm, 0mm)
    pad 2: P_LQH2MCN_0806 at (0.85mm, 0mm)
    // Body maximum 2.2 x 1.8mm plus a 0.25mm component courtyard excess.
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.7mm, 2.3mm) }
    silkscreen_ref { at: (0mm, -1.85mm) }
}

// Sunlord WPN series page 164 gives the WPN201610U recommended land as a
// 0.7mm inner gap (a), 0.7mm land length (b), and 1.7mm land width (c).
// That is two 0.7 x 1.7mm lands with centres at x = +/-0.7mm.
pub pad P_WPN201610U_2016Metric {
    shape: rect
    size: (0.7mm, 1.7mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_L_WPN201610U_2016Metric {
    pad 1: P_WPN201610U_2016Metric at (-0.7mm, 0mm)
    pad 2: P_WPN201610U_2016Metric at (0.7mm, 0mm)
    // Body maximum 2.2 x 1.8mm plus 0.25mm courtyard excess per side.
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.7mm, 2.3mm) }
    silkscreen_ref { at: (0mm, -1.85mm) }
}

// Coilcraft Document 1153 recommended land: F=0.36mm pad length,
// G=0.61mm inner gap and H=0.66mm pad width. Pad centres are therefore
// +/-0.485mm and the total copper span is 1.33mm.
pub pad P_COILCRAFT_0402DC {
    shape: rect
    size: (0.36mm, 0.66mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_COILCRAFT_0402DC {
    pad 1: P_COILCRAFT_0402DC at (-0.485mm, 0mm)
    pad 2: P_COILCRAFT_0402DC at (0.485mm, 0mm)
    // Maximum body 1.11 x 0.66mm plus 0.25mm courtyard excess per side.
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.61mm, 1.16mm) }
    silkscreen_ref { at: (0mm, -1.3mm) }
}
