// Texas Instruments TPS255x: 2.5-6.5V, up to 1.5A power-distribution
// switches with a resistor-programmed current limit. Datasheet SLVS841G,
// November 2008, revised October 2026 (docs/tps255x.pdf). Pin configuration
// and Table 5-1 on p4; device comparison on p3; recommended operating
// conditions on p5; DBV0006A drawing 4214840/G on pp36-37.
//
// Family model: one device per pin table. The DBV (SOT-23-6) members share
// pin numbers, and they differ in the function of pin 3:
//   TPS2553 and TPS2553-1: EN, logic high turns the switch on.
//   TPS2552 and TPS2552-1: EN (overbar), logic low turns the switch on.
// That is a different pin function, so TPS2552 is its own device with pin 3
// named EN_N. The "-1" members latch off on overcurrent where the plain
// members limit at constant current and auto-retry (p3, p14); the pin table
// is the same, so a "-1" member is a second part on the same device.
// docs/README.md ("TPS255x family") lists the members carried and the ones
// left out.
//
// All parts use this package's FP_TI_DBV0006A (tps22918.cohdl), which is the
// same TI drawing 4214840/G printed in this datasheet.

#[doc("docs/tps255x.pdf")]
pub device TPS2553 {
    pins {
        // 2.5-6.5V (p5); 0.1uF or greater ceramic to GND close to the IC (p4)
        required IN: 1 [power_in]
        required GND: 2 [power_in]
        required EN: 3 [input] // logic high turns the switch on (p4)
        // Active-low open-drain flag: overcurrent, overtemperature or
        // reverse voltage (p4). Needs an external pull-up when used.
        optional FAULT_N: 4 [output]
        // Current-limit resistor to GND, 15k-232k recommended (p4, p5).
        // TI's table types this pin "O"; it is modelled passive because it
        // is a programming node and may also be tied to IN (p7).
        required ILIM: 5 [passive]
        required OUT: 6 [power_out]
    }
}

impl IC for TPS2553 {}

#[doc("docs/tps255x.pdf")]
pub device TPS2552 {
    pins {
        // 2.5-6.5V (p5); 0.1uF or greater ceramic to GND close to the IC (p4)
        required IN: 1 [power_in]
        required GND: 2 [power_in]
        required EN_N: 3 [input] // logic LOW turns the switch on (p4)
        // Active-low open-drain flag: overcurrent, overtemperature or
        // reverse voltage (p4). Needs an external pull-up when used.
        optional FAULT_N: 4 [output]
        // Current-limit resistor to GND, 15k-232k recommended (p4, p5).
        // TI's table types this pin "O"; it is modelled passive because it
        // is a programming node and may also be tied to IN (p7).
        required ILIM: 5 [passive]
        required OUT: 6 [power_out]
    }
}

impl IC for TPS2552 {}

// Active-high enable, constant-current limit with auto-retry (p3).
#[doc("docs/tps255x.pdf")]
pub part LOADSW_TPS2553DBVR: TPS2553 {
    primary { mfr: "Texas Instruments", mpn: "TPS2553DBVR", footprint: FP_TI_DBV0006A,
              supplier lcsc "C55266" }
}

// Active-high enable, latch-off on overcurrent (p3).
#[doc("docs/tps255x.pdf")]
pub part LOADSW_TPS2553DBVR_1: TPS2553 {
    primary { mfr: "Texas Instruments", mpn: "TPS2553DBVR-1", footprint: FP_TI_DBV0006A,
              supplier lcsc "C111738" }
}

// Active-low enable, constant-current limit with auto-retry (p3).
#[doc("docs/tps255x.pdf")]
pub part LOADSW_TPS2552DBVR: TPS2552 {
    primary { mfr: "Texas Instruments", mpn: "TPS2552DBVR", footprint: FP_TI_DBV0006A,
              supplier lcsc "C46506" }
}
