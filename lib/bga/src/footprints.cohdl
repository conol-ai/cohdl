// Verified BGA package land patterns.
//
// Both footprints are transcribed from STMicroelectronics DS9826 Rev 6:
// https://www.st.com/resource/en/datasheet/stm32f072cb.pdf
// Audited document SHA-256:
// 660bc16b5cf99b649da4ebcd2d1bb8d232edd3fb1dc275977b3c6389a85d2453.
//
// The official recommended PCB design rules specify a circular 0.280mm copper
// land for both 0.50mm-pitch UFBGA packages. Independent solder-mask and paste
// apertures are documented in docs/README.md because the current pad model
// cannot express them separately.

pub pad P_UFBGA_LAND_028 {
    shape: circle
    size: (0.28mm)
    layer: top_copper
    plating: smd
}

// UFBGA64, full 8x8 ball array, 5x5mm nominal body, 0.50mm pitch and
// 0.60mm maximum height. Figure 41's bottom view has column 1 on the right;
// this PCB top view mirrors it so A1 is upper-left, with columns increasing
// rightward and rows increasing downward in CoHDL/KiCad's +Y-down frame.
pub footprint BGA64C50P8X8_500X500X60N {
    pad A1: P_UFBGA_LAND_028 at (-1.75mm, -1.75mm)
    pad A2: P_UFBGA_LAND_028 at (-1.25mm, -1.75mm)
    pad A3: P_UFBGA_LAND_028 at (-0.75mm, -1.75mm)
