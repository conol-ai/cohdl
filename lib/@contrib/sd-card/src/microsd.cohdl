// Wurth Elektronik 693070010811: MicroSD (TransFlash) push-push card
// connector, 8-pin, surface-mount (datasheet rev 001, 2025). Pinout per
// MicroSD spec; land pattern from datasheet p1.

#[doc("docs/microsd-wurth.pdf")]
pub device MICROSD_SOCKET {
    pins {
        optional DAT2: 1 [bidirectional] // data 2 (p1)
        optional DAT3: 2 [bidirectional] // data 3 / CS (p1)
        optional CMD: 3 [bidirectional] // command / response (p1)
        required VDD: 4 [power_in] // supply (p1)
        optional CLK: 5 [input] // clock (p1)
        required GND: 6 [power_in] // ground (p1)
        optional DAT0: 7 [bidirectional] // data 0 (p1)
        optional DAT1: 8 [bidirectional] // data 1 (p1)
        // Shell / mechanical solder tabs (GND, not signal)
        required SHIELD1: G1 [passive]
        required SHIELD2: G2 [passive]
    }
}

impl Connector for MICROSD_SOCKET {}

#[doc("docs/microsd-wurth.pdf")]
pub part CONN_MICROSD: MICROSD_SOCKET {
    primary { mfr: "Wurth Elektronik", mpn: "693070010811",
              footprint: FP_MicroSD_Wurth_693070010811 }
}

// Würth page-1 recommended land pattern: eight 0.8 x 1.5 mm signal
// lands on 1.1 mm pitch, numbered 8 through 1 from left to right. The two
// shell lands are 3.1 x 1.5 mm, 6.06 mm apart, and 9.25 mm from the signal
// row. This connector has two shell lands, not four.
pub pad P_MICROSD_SIGNAL {
    shape: rect
    size: (0.8mm, 1.5mm)
    layer: top_copper
    plating: smd
}

pub pad P_MICROSD_SHELL {
    shape: rect
    size: (3.1mm, 1.5mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_MicroSD_Wurth_693070010811 {
    pad 8: P_MICROSD_SIGNAL at (-3.85mm, 0mm)
    pad 7: P_MICROSD_SIGNAL at (-2.75mm, 0mm)
    pad 6: P_MICROSD_SIGNAL at (-1.65mm, 0mm)
    pad 5: P_MICROSD_SIGNAL at (-0.55mm, 0mm)
    pad 4: P_MICROSD_SIGNAL at (0.55mm, 0mm)
    pad 3: P_MICROSD_SIGNAL at (1.65mm, 0mm)
    pad 2: P_MICROSD_SIGNAL at (2.75mm, 0mm)
    pad 1: P_MICROSD_SIGNAL at (3.85mm, 0mm)
    // Shell / mechanical solder tabs (GND)
    pad G1: P_MICROSD_SHELL at (-3.03mm, -9.25mm)
    pad G2: P_MICROSD_SHELL at (3.03mm, -9.25mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, -4.625mm), size: (12.7mm, 12.5mm) }
    silkscreen_ref { at: (0mm, -11.5mm) }
}
