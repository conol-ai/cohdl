// Raspberry Pi Pico 2 — board-specific devices and part bindings.
//
// Reusable silicon, protection, connectors, oscillators, and discretes live in
// catalog packages. This file keeps only the Pico-specific 40-pin board edge,
// BOOTSEL switch, bulk-capacitor binding, and small helper circuits.
//
// Pinouts and values transcribed from the Raspberry Pi Pico 2 datasheet
// (Appendix B, Figure 11 — the board schematic).

pub trait Switch {
    designator_prefix: "SW"
}

// ---- 40-pin castellated / 0.1" header (the user I/O edge) ----

pub device Castellated40 {
    pins {
        required GP0: 1 [passive]
        required GP1: 2 [passive]
        required GP2: 4 [passive]
        required GP3: 5 [passive]
        required GP4: 6 [passive]
        required GP5: 7 [passive]
        required GP6: 9 [passive]
        required GP7: 10 [passive]
        required GP8: 11 [passive]
        required GP9: 12 [passive]
        required GP10: 14 [passive]
        required GP11: 15 [passive]
        required GP12: 16 [passive]
        required GP13: 17 [passive]
        required GP14: 19 [passive]
        required GP15: 20 [passive]
        required GP16: 21 [passive]
        required GP17: 22 [passive]
        required GP18: 24 [passive]
        required GP19: 25 [passive]
        required GP20: 26 [passive]
        required GP21: 27 [passive]
        required GP22: 29 [passive]
        required GP26: 31 [passive]
        required GP27: 32 [passive]
        required GP28: 34 [passive]
        required RUN: 30 [passive]
        required V3V3_EN: 37 [passive]
        required V3V3: 36 [passive]
        required ADC_VREF: 35 [passive]
        required VSYS: 39 [passive]
        required VBUS: 40 [passive]
        required AGND: 33 [passive]
        required GND: 3, 8, 13, 18, 23, 28, 38 [passive]
    }
}

impl Connector for Castellated40 {}

pub part HEADER_40W: Castellated40 {
    primary { mfr: "Raspberry Pi", mpn: "CON_PICO_40W", footprint: FP_Pico_Castellated_40 }
}

// ---- BOOTSEL tactile switch (4-pad; {1,2} one side, {3,4} the other) ----

pub device Bootsel_Switch {
    pins {
        required A: 1, 2 [passive]
        required B: 3, 4 [passive]
    }
}

impl Switch for Bootsel_Switch {}

pub part BOOTSEL_SW: Bootsel_Switch {
    primary { mfr: "XKB", mpn: "TP-1221U-K9K5325", footprint: FP_SW_SPST_TP1221U }
}

// ---- Pico-specific part bindings ----

// 47uF 6.3V X5R 0603. Not in `passive`: Yageo's CC series stops short of
// 47uF in an 0603 X5R, so this one part is board-local, built on the
// library's own device and land rather than a private copy of either.
pub part C_47uF: passive::MLCC<47uF, 6.3V, 20%>[C0603] {
    primary { mfr: "Murata", mpn: "GRM188R60J476ME15", footprint: passive::CHIP_0603 }
}

// ---- reusable Pico sub-circuits ----

// 4.7uF bulk/rail capacitor across a supply pin pair.
pub fn bulk_4u7(vdd: Pin, gnd: Pin) {
    inst c: passive::C_4u7_6V3_X5R_0402
    net _: vdd, c.A
    net _: gnd, c.B
}

// 47uF bulk capacitor across a rail.
pub fn bulk_47u(vdd: Pin, gnd: Pin) {
    inst c: C_47uF
    net _: vdd, c.A
    net _: gnd, c.B
}
