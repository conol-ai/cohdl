// Bosch Sensortec BHI260AP: 9-axis smart IMU (Fuser2 core + BMI260 6-axis),
// LGA-44 3.6 x 4.1 x 0.83 mm (datasheet p2). Pin table: p19-21 Table 1.
// Datasheet: BST-BHI260AP-DS000-02 rev 1.1, 2021-04-15.

#[doc("docs/bst-bhi260ap-ds000.pdf")]
pub device BHI260AP {
    pins {
        // Supplies (p19-21). VDD is the analog sensor supply (p20 pad 28);
        // VDDIO powers digital IO and the Fuser2 core (pads 7/12/42).
        required VDD: 28 [power_in]
        required VDDIO: 7, 12, 42 [power_in]
        required GND: 25, 26, 27 [power_in] // analog sensor ground
        required GNDIO: 17, 36 [power_in] // digital IO / Fuser2 ground
        // Voltage regulator output, needs external capacitor (p21 Figure 2
        // "Ext Cap" on pad 6).
        required VREG: 6 [power_out]
        // System control (p19-20)
        required RESETN: 9 [input] // reset, active low
        required HOSTBOOT: 3 [input] // boot mode select (host / standalone)
        // Host interface (p19-20). SPI: HSCX=SCK HSDX=MOSI HSDO=MISO HCSB=CS.
        // I2C: HSCX=SCL HSDX=SDA, HSDO=address select strap, HCSB must be
        // held high (p20 pad 34 note).
        required HSCX: 33 [input]
        required HSDX: 11 [bidirectional]
        required HSDO: 32 [bidirectional]
        required HCSB: 34 [input]
        optional HIRQ: 10 [output] // host interrupt (p19: "Output")
        // Master interface 1 (internal use with BMI260 per p21 note 1 wiring;
        // still bonded out, p20-21)
        optional M1SCX: 29 [output] // SPI SCK / I2C SCL, reset: output low
        optional M1SDX: 44 [bidirectional] // SPI MOSI / I2C SDA, reset: output low
        optional M1SDI: 43 [input] // SPI MISO
        // Master interface 2 (p19-20)
        optional M2SCX: 13 [output]
        optional M2SDX: 35 [bidirectional]
        optional M2SDI: 37 [input]
        // Master interface 3, I2C only (p19)
        optional M3SCL: 2 [output]
        optional M3SDA: 1 [bidirectional]
        // External QSPI flash interface (p19-20)
        optional QSPI_CLK: 5 [output]
        optional QSPI_CSN: 14 [output]
        optional QSPI_D0: 4 [bidirectional]
        optional QSPI_D1: 15 [bidirectional]
        optional QSPI_D2: 20 [bidirectional]
        optional QSPI_D3: 8 [bidirectional]
        // Master chip selects / GPIO (p20)
        optional MCSB1: 38 [bidirectional]
        optional MCSB2: 18 [bidirectional]
        optional MCSB3: 16 [bidirectional]
        optional MCSB4: 19 [bidirectional]
        // Sensor auxiliary (OIS) interface (p20-21), reset Hi-Z
        optional ASCX: 22 [output] // OIS clock / I2C SCL
        optional ASDX: 30 [bidirectional] // OIS MOSI / I2C SDA
        optional OCSB: 21 [output] // OIS chip select
        optional OSDO: 39 [input] // OIS MISO
        // Fuser2 debug (p20)
        optional JTAG_CLK: 23 [input]
        optional JTAG_DIO: 24 [bidirectional]
        // Reserved, internal sensor<->Fuser2 connections; do not connect
        // (p21 Table 1 note 1). Leave unconnected in designs (`nc`).
        optional RESV1: 41 [input] // internal IMU interrupt
        optional RESV2: 40 [input] // internal IMU interrupt
        optional RESV3: 31 [output] // internal IMU chip select, reset: output high
    }
}

impl IC for BHI260AP {}

// Device-only: Figure 37 leaves the pad 4-5/18-19 centre gap undimensioned,
// and its mask-frame/chamfer requirements are not representable in CoHDL.
// Publish a part only when Bosch supplies an authoritative machine-readable
// land pattern or every required feature can be represented without inference.
