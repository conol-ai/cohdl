// RFC-018 pad library: reusable padstacks (shape, size, layer, plating),
// one per land-pattern role. Dimensions follow the KiCad official footprints
// named in each `was:` comment of std/footprints.cohdl and
// examples/rpi-pico2/src/footprints.cohdl (roundrect pads project to `rect` —
// the closed shape vocabulary has no rounded rectangle), or IPC-7351-nominal /
// datasheet land patterns where KiCad ships no footprint under the board's
// exact `was:` name.
//
// Reuse cuts both ways (RFC-018 Failure modes): a wrong dimension here
// propagates to every footprint that references the pad. Treat edits to
// this file as library-review work, not local tweaks.

// KiCad LED_0603_1608Metric pad.
pub pad P_Chip_LED0603 {
    shape: rect
    size: (0.875mm, 0.95mm)
    layer: top_copper
    plating: smd
}

// 0806 (2.0x1.6mm) chip-inductor land, IPC-7351 nominal.
pub pad P_Ind_0806 {
    shape: rect
    size: (1mm, 1.75mm)
    layer: top_copper
    plating: smd
}

// KiCad SOT-23-5 lead pad.
pub pad P_SOT23_Lead {
    shape: rect
    size: (1.325mm, 0.6mm)
    layer: top_copper
    plating: smd
}

// KiCad SOT-523 lead pad.
pub pad P_SOT523_Lead {
    shape: rect
    size: (0.51mm, 0.4mm)
    layer: top_copper
    plating: smd
}

// KiCad Crystal_SMD_3225-4Pin hand-solder pad.
pub pad P_Crystal3225 {
    shape: rect
    size: (2.1mm, 1.8mm)
    layer: top_copper
    plating: smd
}

// QFN P0.4mm lead, left/right sides (long axis horizontal).
pub pad P_QFN_P04_H {
    shape: rect
    size: (0.8mm, 0.2mm)
    layer: top_copper
    plating: smd
}

// QFN P0.4mm lead, top/bottom sides (long axis vertical).
pub pad P_QFN_P04_V {
    shape: rect
    size: (0.2mm, 0.8mm)
    layer: top_copper
    plating: smd
}

// QFN-60 exposed thermal pad (EP3.5x3.5mm).
pub pad P_QFN60_EP {
    shape: rect
    size: (3.5mm, 3.5mm)
    layer: top_copper
    plating: smd
}

