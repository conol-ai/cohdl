// Zhuhai Hongjiacheng bidirectional TVS diodes ("...CA") on the shared
// `do214` and `sod` lands. A bidirectional TVS has no polarity: the body
// carries no cathode band (SMCJ and SMF sheets, package-outline notes; the
// SMBJ sheet labels the band "for uni-directional products only") and the
// two terminals are interchangeable, so each device follows the package's
// two-terminal protector model (IO1 / IO2, as H5VL10B and TPD1E1B04).
//
// The LCSC bindings carry no rotation: on the 2026-11-08 probe preview the
// assembler's models for these part numbers were read by the body only,
// aligned and centred with zero correction. That is enough only because
// the parts are symmetric. See docs/README.md ("LCSC bindings").
//
// Ratings are for a 10/1000us pulse. Each sheet's note (3) doubles the IR
// limit for bidirectional devices with a VR of 10V and under; that applies
// to SMBJ6.0CA only.

// ---- SMBJ6.0CA: 6.0V 600W bidirectional TVS, SMB (DO-214AA) ----
// Datasheet "SMBJ SERIES" Rev 1.1. Page 1: PPPM 600W. Page 2, SMBJ6.0CA row
// (marking AG): VRWM 6.0V, VBR 6.67-7.37V at IT 10mA, VC 10.3V at IPP
// 58.25A, IR 800uA at VRWM (doubled for this bidirectional part, page 3
// note 3).
#[doc("docs/hongjiacheng-smbj6v0ca.evidence.md")]
pub device SMBJ6V0CA {
    pins {
        required IO1: 1 [bidirectional]
        required IO2: 2 [bidirectional]
    }
}

impl ESD_Protector for SMBJ6V0CA {}

#[doc("docs/hongjiacheng-smbj6v0ca.evidence.md")]
pub part TVS_SMBJ6V0CA: SMBJ6V0CA {
    primary { mfr: "Zhuhai Hongjiacheng Technology", mpn: "SMBJ6.0CA",
              footprint: do214::DIOM5336X265N, supplier lcsc "C19077561" }
}

