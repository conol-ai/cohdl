// Bosch Sensortec BHI260AP: 9-axis smart IMU (Fuser2 core + BMI260 6-axis),
// LGA-44 3.6 x 4.1 x 0.83 mm (datasheet p2). Pin table: p19-21 Table 1.
// Datasheet: BST-BHI260AP-DS000-02 rev 1.1, 2021-04-15.

#[doc("docs/bst-bhi260ap-ds000.pdf")]
pub device BHI260AP {
    pins {
        // Supplies (p19-21). VDD is the analog sensor supply (p20 pad 28);
        // VDDIO powers digital IO and the Fuser2 core (pads 7/12/42).
        required VDD: 28 [power_in]
        required VDDIO: 7, 12, 42 [power_in]
        required GND: 25, 26, 27 [power_in] // analog sensor ground
        required GNDIO: 17, 36 [power_in] // digital IO / Fuser2 ground
        // Voltage regulator output, needs external capacitor (p21 Figure 2
        // "Ext Cap" on pad 6).
        required VREG: 6 [power_out]
        // System control (p19-20)
        required RESETN: 9 [input] // reset, active low
        required HOSTBOOT: 3 [input] // boot mode select (host / standalone)
        // Host interface (p19-20). SPI: HSCX=SCK HSDX=MOSI HSDO=MISO HCSB=CS.
        // I2C: HSCX=SCL HSDX=SDA, HSDO=address select strap, HCSB must be
        // held high (p20 pad 34 note).
        required HSCX: 33 [input]
        required HSDX: 11 [bidirectional]
        required HSDO: 32 [bidirectional]
        required HCSB: 34 [input]
        optional HIRQ: 10 [output] // host interrupt (p19: "Output")
        // Master interface 1 (internal use with BMI260 per p21 note 1 wiring;
        // still bonded out, p20-21)
        optional M1SCX: 29 [output] // SPI SCK / I2C SCL, reset: output low
        optional M1SDX: 44 [bidirectional] // SPI MOSI / I2C SDA, reset: output low
        optional M1SDI: 43 [input] // SPI MISO
        // Master interface 2 (p19-20)
        optional M2SCX: 13 [output]
        optional M2SDX: 35 [bidirectional]
        optional M2SDI: 37 [input]
        // Master interface 3, I2C only (p19)
        optional M3SCL: 2 [output]
        optional M3SDA: 1 [bidirectional]
        // External QSPI flash interface (p19-20)
        optional QSPI_CLK: 5 [output]
        optional QSPI_CSN: 14 [output]
        optional QSPI_D0: 4 [bidirectional]
        optional QSPI_D1: 15 [bidirectional]
        optional QSPI_D2: 20 [bidirectional]
        optional QSPI_D3: 8 [bidirectional]
        // Master chip selects / GPIO (p20)
        optional MCSB1: 38 [bidirectional]
        optional MCSB2: 18 [bidirectional]
        optional MCSB3: 16 [bidirectional]
        optional MCSB4: 19 [bidirectional]
        // Sensor auxiliary (OIS) interface (p20-21), reset Hi-Z
        optional ASCX: 22 [output] // OIS clock / I2C SCL
        optional ASDX: 30 [bidirectional] // OIS MOSI / I2C SDA
        optional OCSB: 21 [output] // OIS chip select
        optional OSDO: 39 [input] // OIS MISO
        // Fuser2 debug (p20)
        optional JTAG_CLK: 23 [input]
        optional JTAG_DIO: 24 [bidirectional]
        // Reserved, internal sensor<->Fuser2 connections; do not connect
        // (p21 Table 1 note 1). Leave unconnected in designs (`nc`).
        optional RESV1: 41 [input] // internal IMU interrupt
        optional RESV2: 40 [input] // internal IMU interrupt
        optional RESV3: 31 [output] // internal IMU chip select, reset: output high
    }
}

impl IC for BHI260AP {}

#[doc("docs/bst-bhi260ap-ds000.pdf")]
pub part IMU_BHI260AP: BHI260AP {
    primary { mfr: "Bosch Sensortec", mpn: "BHI260AP", footprint: LGA44P40_360X410 }
}

// Bosch Figure 37 (p162) is a complete top-view land pattern. Perimeter land
// centres follow the stated 3.17 x 3.67mm centre spans; every other centre is
// on the stated 0.40mm grid. Horizontal lands are 0.45 x 0.35mm, vertical
// lands 0.35 x 0.45mm. Each land gets the specified 50um mask frame.
pub pad P_BHI260AP_H {
    shape: rect
    size: (0.45mm, 0.35mm)
    layer: top_copper
    plating: smd
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_V {
    shape: rect
    size: (0.35mm, 0.45mm)
    layer: top_copper
    plating: smd
    mask_expansion: 0.05mm
}

// Figure 37 uses eight paired 0.05 x 45-degree cuts at the four bends of the
// inner land ring. They are copper/mask geometry, not silkscreen approximations.
pub pad P_BHI260AP_H_BR {
    shape: rect
    size: (0.45mm, 0.35mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_right, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_H_BL {
    shape: rect
    size: (0.45mm, 0.35mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_left, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_H_TR {
    shape: rect
    size: (0.45mm, 0.35mm)
    layer: top_copper
    plating: smd
    chamfer: (top_right, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_H_TL {
    shape: rect
    size: (0.45mm, 0.35mm)
    layer: top_copper
    plating: smd
    chamfer: (top_left, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_V_BR {
    shape: rect
    size: (0.35mm, 0.45mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_right, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_V_BL {
    shape: rect
    size: (0.35mm, 0.45mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_left, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_V_TL {
    shape: rect
    size: (0.35mm, 0.45mm)
    layer: top_copper
    plating: smd
    chamfer: (top_left, 0.05mm)
    mask_expansion: 0.05mm
}

pub pad P_BHI260AP_V_TR {
    shape: rect
    size: (0.35mm, 0.45mm)
    layer: top_copper
    plating: smd
    chamfer: (top_right, 0.05mm)
    mask_expansion: 0.05mm
}

pub footprint LGA44P40_360X410 {
    // Left perimeter, top to bottom.
    pad 1: P_BHI260AP_H at (-1.585mm, -1.4mm)
    pad 2: P_BHI260AP_H at (-1.585mm, -1mm)
    pad 3: P_BHI260AP_H at (-1.585mm, -0.6mm)
    pad 4: P_BHI260AP_H at (-1.585mm, -0.2mm)
    pad 5: P_BHI260AP_H at (-1.585mm, 0.2mm)
    pad 6: P_BHI260AP_H at (-1.585mm, 0.6mm)
    pad 7: P_BHI260AP_H at (-1.585mm, 1mm)
    pad 8: P_BHI260AP_H at (-1.585mm, 1.4mm)

    // Bottom perimeter, left to right.
    pad 9: P_BHI260AP_V at (-1mm, 1.835mm)
    pad 10: P_BHI260AP_V at (-0.6mm, 1.835mm)
    pad 11: P_BHI260AP_V at (-0.2mm, 1.835mm)
    pad 12: P_BHI260AP_V at (0.2mm, 1.835mm)
    pad 13: P_BHI260AP_V at (0.6mm, 1.835mm)
    pad 14: P_BHI260AP_V at (1mm, 1.835mm)

    // Right perimeter, bottom to top.
    pad 15: P_BHI260AP_H at (1.585mm, 1.4mm)
    pad 16: P_BHI260AP_H at (1.585mm, 1mm)
    pad 17: P_BHI260AP_H at (1.585mm, 0.6mm)
    pad 18: P_BHI260AP_H at (1.585mm, 0.2mm)
    pad 19: P_BHI260AP_H at (1.585mm, -0.2mm)
    pad 20: P_BHI260AP_H at (1.585mm, -0.6mm)
    pad 21: P_BHI260AP_H at (1.585mm, -1mm)
    pad 22: P_BHI260AP_H at (1.585mm, -1.4mm)

    // Top perimeter, right to left.
    pad 23: P_BHI260AP_V at (1mm, -1.835mm)
    pad 24: P_BHI260AP_V at (0.6mm, -1.835mm)
    pad 25: P_BHI260AP_V at (0.2mm, -1.835mm)
    pad 26: P_BHI260AP_V at (-0.2mm, -1.835mm)
    pad 27: P_BHI260AP_V at (-0.6mm, -1.835mm)
    pad 28: P_BHI260AP_V at (-1mm, -1.835mm)

    // Inner 0.40mm grid, following the same top-view numbering.
    pad 29: P_BHI260AP_H_TR at (-0.8mm, -0.8mm)
    pad 30: P_BHI260AP_H at (-0.8mm, -0.4mm)
    pad 31: P_BHI260AP_H at (-0.8mm, 0mm)
    pad 32: P_BHI260AP_H at (-0.8mm, 0.4mm)
    pad 33: P_BHI260AP_H_BR at (-0.8mm, 0.8mm)
    pad 34: P_BHI260AP_V_TL at (-0.4mm, 1.2mm)
    pad 35: P_BHI260AP_V at (0mm, 1.2mm)
    pad 36: P_BHI260AP_V_TR at (0.4mm, 1.2mm)
    pad 37: P_BHI260AP_H_BL at (0.8mm, 0.8mm)
    pad 38: P_BHI260AP_H at (0.8mm, 0.4mm)
    pad 39: P_BHI260AP_H at (0.8mm, 0mm)
    pad 40: P_BHI260AP_H at (0.8mm, -0.4mm)
    pad 41: P_BHI260AP_H_TL at (0.8mm, -0.8mm)
    pad 42: P_BHI260AP_V_BR at (0.4mm, -1.2mm)
    pad 43: P_BHI260AP_V at (0mm, -1.2mm)
    pad 44: P_BHI260AP_V_BL at (-0.4mm, -1.2mm)

    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 4.6mm) }
    silkscreen_ref { at: (0mm, -2.7mm) }
}
