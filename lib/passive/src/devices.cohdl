// The two chip-passive devices, one variant per case size (RFC-008).
//
// GENERATED by tools/gen_passive.py — do not hand-edit.
// Regenerate after changing the value grid or a vendor's part-number rule.
//
// A variant is not decoration: it carries the size's own rated power, so
// `ChipResistor<10kohm, 1%>[R0402]` states 1/16 W and `[R1206]` states
// 1/4 W from the same declaration. Traits come from std — this library
// adds devices and parts, not a second set of trait definitions.

pub device ChipResistor<R: Resistance, T: Tolerance = 1%> {
    variants { R0201, R0402, R0603, R0805, R1206, R1210, R2010, R2512 }

    pins[R0201] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R0402] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R0603] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R0805] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R1206] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R1210] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R2010] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[R2512] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    spec {
        resistance: R
        tolerance: T
    }
    spec[R0201] {
        power_rating: 50mW
    }
    spec[R0402] {
        power_rating: 62.5mW
    }
    spec[R0603] {
        power_rating: 100mW
    }
    spec[R0805] {
        power_rating: 125mW
    }
    spec[R1206] {
        power_rating: 250mW
    }
    spec[R1210] {
        power_rating: 500mW
    }
    spec[R2010] {
        power_rating: 750mW
    }
    spec[R2512] {
        power_rating: 1W
    }
}

impl TwoTerminal for ChipResistor {}

impl Resistor for ChipResistor {}

pub device MLCC<C: Capacitance, V: Voltage = 16V, T: Tolerance = 10%> {
    variants { C0201, C0402, C0603, C0805, C1206, C1210 }

    pins[C0201] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[C0402] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[C0603] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[C0805] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[C1206] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    pins[C1210] {
        required A: 1 [passive]
        required B: 2 [passive]
    }

    spec {
        capacitance: C
        voltage_rating: V
        tolerance: T
    }
}

