pub footprint FP_MOUNTING_HOLE_NPTH_3P2 {
    mount_hole 1: non_plated at (0mm, 0mm) diameter 3.2mm
    courtyard { shape: circle, at: (0mm, 0mm), size: (6.4mm) }
}

