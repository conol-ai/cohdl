    courtyard { shape: rect, at: (0mm, 0mm), size: (7.7mm, 7.7mm) }
    silkscreen_ref { at: (0mm, -4.2mm) }
}

// RT6150B-33GQW buck-boost — real package is WDFN-10L 2.5x2.5mm, 0.50mm pitch,
// dual-row (5 leads per side), exposed pad ~1.2x2.0mm (Richtek datasheet
// DS6150AB; verified). (The earlier QFN-10 2x2mm/0.40mm footprint was the
// WRONG package family, body and pitch.)
// IPC-7351 name (RFC-021, DFN under the QFN family): 10 leads, density N,
// 0.50mm pitch, 2.50x2.50mm body, 1.20x2.00mm exposed pad.
pub footprint QFN10N50P250X250_1EP120X200 {
    pad 1: P_WDFN10_Lead at (-1.15mm, -1.0mm)
    pad 2: P_WDFN10_Lead at (-1.15mm, -0.5mm)
    pad 3: P_WDFN10_Lead at (-1.15mm, 0mm)
    pad 4: P_WDFN10_Lead at (-1.15mm, 0.5mm)
    pad 5: P_WDFN10_Lead at (-1.15mm, 1.0mm)
    pad 6: P_WDFN10_Lead at (1.15mm, 1.0mm)
    pad 7: P_WDFN10_Lead at (1.15mm, 0.5mm)
    pad 8: P_WDFN10_Lead at (1.15mm, 0mm)
    pad 9: P_WDFN10_Lead at (1.15mm, -0.5mm)
    pad 10: P_WDFN10_Lead at (1.15mm, -1.0mm)
    pad 11: P_WDFN10_EP at (0mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.9mm, 2.9mm) }
    silkscreen_ref { at: (0mm, -1.7mm) }
}

// W25Q32RVXHJQ flash — real package is 8-XSON 2.0x3.0mm, 0.50mm pitch (Winbond
// package code "XH"; datasheet-verified). Land pattern from KiCad's generic
// "Package_DFN_QFN:DFN-8-1EP_2x3mm_P0.5mm_EP0.61x2.2mm". (The earlier
// USON 1.0x1.5mm/0.40mm footprint was the WRONG package.)
// IPC-7351 name (RFC-021, SON under the QFN family): 8 leads, density N,
// 0.50mm pitch, 2.00x3.00mm body, 0.61x2.20mm exposed pad.
pub footprint QFN8N50P200X300_1EP61X220 {
    pad 1: P_DFN8_2x3_Lead at (-0.94mm, -0.75mm)
    pad 2: P_DFN8_2x3_Lead at (-0.94mm, -0.25mm)
    pad 3: P_DFN8_2x3_Lead at (-0.94mm, 0.25mm)
    pad 4: P_DFN8_2x3_Lead at (-0.94mm, 0.75mm)
    pad 5: P_DFN8_2x3_Lead at (0.94mm, 0.75mm)
    pad 6: P_DFN8_2x3_Lead at (0.94mm, 0.25mm)
    pad 7: P_DFN8_2x3_Lead at (0.94mm, -0.25mm)
    pad 8: P_DFN8_2x3_Lead at (0.94mm, -0.75mm)
    pad 9: P_DFN8_2x3_EP at (0mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.9mm, 3.4mm) }
    silkscreen_ref { at: (0mm, -1.9mm) }
}

// was: "Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm"
pub footprint FP_Crystal_SMD_3225_4Pin_3_2x2_5mm {
    pad 1: P_Crystal3225 at (-1.45mm, 1.15mm)
    pad 2: P_Crystal3225 at (1.45mm, 1.15mm)
    pad 3: P_Crystal3225 at (1.45mm, -1.15mm)
    pad 4: P_Crystal3225 at (-1.45mm, -1.15mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (5mm, 4.1mm) }
