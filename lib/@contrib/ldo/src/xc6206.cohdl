// Torex XC6206: positive voltage regulator, 250mA, 1.5V dropout, 6.0V max
// (datasheet ETR0305_004b). 3-pin LDO; pin numbers differ per package
// (SOT-23 / SOT-89 / USP-6B / TO-92). XC6206P182MR = SOT-23, 1.8V output.

#[doc("docs/xc6206.pdf")]
pub device XC6206 {
    variants { SOT23, SOT89, USP6B, TO92 }
    pins[SOT23] {
        required VSS: 1 [power_in] // ground (p2)
        required VIN: 3 [power_in] // power input (p2)
        required VOUT: 2 [power_out] // regulator output (p2)
    }
    pins[SOT89] {
        required VSS: 1 [power_in]
        required VIN: 2 [power_in]
        required VOUT: 3 [power_out]
    }
    pins[USP6B] {
        required VSS: 2 [power_in]
        required VIN: 4 [power_in]
        required VOUT: 6 [power_out]
        // pins 1, 3, 5 are NC for this package (p2 table)
        optional NC1: 1 [passive]
        optional NC3: 3 [passive]
        optional NC5: 5 [passive]
    }
    pins[TO92] {
        required VSS: 1 [power_in]
        required VIN: 2 [power_in]
        required VOUT: 3 [power_out]
    }
}

impl IC for XC6206 {}

#[doc("docs/xc6206.pdf")]
pub part LDO_XC6206P182MR: XC6206[SOT23] {
    primary { mfr: "Torex Semiconductor", mpn: "XC6206P182MR-G", footprint: SOT3P190X290X160N }
}

// Torex p13 publishes the complete SOT-23 component envelope, not a
// recommended PCB land. This conservative nominal-density derivation records
// its tolerance goals explicitly: a 0.90mm radial land spans from 0.70mm
// (half the 1.50mm minimum body width minus a 0.05mm heel) to 1.60mm (half
// the 3.10mm maximum lead-tip span plus a 0.05mm toe). The two same-side lead
// centres may be 1.70..2.10mm apart. A 0.75mm tangential land retains at
// least 0.025mm beyond each 0.50mm-wide lead even at that pitch extreme.
pub pad P_XC6206_SOT23_LEAD {
    shape: rect
    size: (0.9mm, 0.75mm)
    layer: top_copper
    plating: smd
}

// Manufacturer top view rotated 90 degrees: pins 1/2 form the left row and
// pin 3 is opposite. Pin 1 remains the upper-left terminal in CoHDL top view.
pub footprint SOT3P190X290X160N {
    pad 1: P_XC6206_SOT23_LEAD at (-1.15mm, -0.95mm)
    pad 2: P_XC6206_SOT23_LEAD at (-1.15mm, 0.95mm)
    pad 3: P_XC6206_SOT23_LEAD at (1.15mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.7mm, 3.6mm) }
    silkscreen_ref { at: (0mm, -2.1mm) }
}
