#[doc("docs/ti-tlv755p.pdf")]
pub part LDO_TLV75533PDRVR: TLV75533P_DRV {
    primary { mfr: "Texas Instruments", mpn: "TLV75533PDRVR", footprint: son::TI_DRV0006A }
}

