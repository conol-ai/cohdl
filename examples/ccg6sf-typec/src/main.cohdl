// A single-port USB Type-C / USB-PD sample board built around the Infineon
// EZ-PD CCG6SF (std) port controller, following the datasheet's 48-QFN single-
// port application (002-27161, Figure 7). The CCG6SF terminates a USB-C
// receptacle (CC1/CC2 detection + Rp/Rd, SBU, USB 2.0 DP/DM), meters the VBUS
// provider path through a 5-mOhm sense resistor (CSP/CSN) and its integrated
// provider load switch, and drives an EXTERNAL consumer-path N-FET from
// VBUS_C_CTRL (NGDO). It talks to an embedded controller and a host SoC over two
// I2C buses (SCB0/SCB1), with USB 2.0 data, HPD, SWD, and reset broken out.

design Ccg6sfTypec {
    // ---- controller + Type-C receptacle + VBUS power path ----
    inst ctrl: TYPEC_CCG6SF
    inst usbc: USB_C_HRO_TYPE_C_31_M_12
    inst q_cons: FET_CONSUMER
    inst r_sense: R_SENSE_5M
    inst j1: J_IFACE

    // ---- supply decoupling ----
    inst c_vddd: MLCC_1uF_10V_0402
    inst c_vccd: MLCC_1uF_10V_0402
    inst c_vsys: MLCC_1uF_10V_0402
    inst c_v5v: MLCC_1uF_10V_0402
    inst c_vbusc: MLCC_10uF_10V_0603
    inst c_vbusp: MLCC_10uF_10V_0603
    inst c_in: MLCC_10uF_10V_0603
    inst c_cc1: MLCC_100nF_16V_0402
    inst c_cc2: MLCC_100nF_16V_0402
    inst c_xres: MLCC_100nF_16V_0402

    // ---- I2C pull-ups + reset ----
    inst r_scl_ec: RES_5K1_0402
    inst r_sda_ec: RES_5K1_0402
    inst r_scl_soc: RES_5K1_0402
    inst r_sda_soc: RES_5K1_0402
    inst r_xres: RES_10K_0402

    // ---- VBUS: 5V provider in -> Rsense -> chip provider FET -> Type-C VBUS
    //      -> external consumer NFET -> system ----
    net VBUS_IN: j1.VBUS_IN, r_sense.A, ctrl.CSN, c_in.A
    net VBUS_P: r_sense.B, ctrl.VBUS_P, ctrl.CSP, c_vbusp.A
    net VBUS_C: ctrl.VBUS_C, usbc.VBUS, q_cons.D, c_vbusc.A
    net VBUS_SYS: q_cons.S, j1.VBUS_SYS
    net NGDO: ctrl.VBUS_C_CTRL, q_cons.G

    // ---- chip supplies ----
    net VSYS: j1.VSYS, ctrl.VSYS, c_vsys.A
    net V5V: j1.V5V, ctrl.V5V, c_v5v.A
    // VDDD is the chip's own regulator output, shorted to VDDIO; also biases the
    // I2C and reset pull-ups.
    net VDDD: ctrl.VDDD, ctrl.VDDIO, c_vddd.A, r_scl_ec.A, r_sda_ec.A, r_scl_soc.A, r_sda_soc.A,
              r_xres.A
    net VCCD: ctrl.VCCD, c_vccd.A
    net GND: usbc.GND, usbc.SHIELD, ctrl.EP, j1.GND, c_vddd.B, c_vccd.B, c_vsys.B, c_v5v.B,
             c_vbusc.B, c_vbusp.B, c_in.B, c_cc1.B, c_cc2.B, c_xres.B

    // ---- Type-C CC + SBU ----
    net CC1: usbc.CC1, ctrl.CC1, c_cc1.A
    net CC2: usbc.CC2, ctrl.CC2, c_cc2.A
    net SBU1: usbc.SBU1, ctrl.SBU1
    net SBU2: usbc.SBU2, ctrl.SBU2

    // ---- USB 2.0 data: Type-C connector (top+bottom, flip) and system side ----
    net USB_DP_C: usbc.DP, ctrl.DP_TOP, ctrl.DP_BOT
    net USB_DM_C: usbc.DN, ctrl.DM_TOP, ctrl.DM_BOT
    net USB_DP_SYS: ctrl.DP_SYS, j1.DP_SYS
    net USB_DM_SYS: ctrl.DM_SYS, j1.DM_SYS

    // ---- I2C to the embedded controller (SCB0) and the host SoC (SCB1) ----
    net EC_SCL: ctrl.SCL_SCB0, j1.EC_SCL, r_scl_ec.B
    net EC_SDA: ctrl.SDA_SCB0, j1.EC_SDA, r_sda_ec.B
    net SOC_SCL: ctrl.SCL_SCB1, j1.SOC_SCL, r_scl_soc.B
    net SOC_SDA: ctrl.SDA_SCB1, j1.SOC_SDA, r_sda_soc.B
    net INT_EC: ctrl.INT_EC, j1.INT_EC
    net HPD: ctrl.HPD, j1.HPD

    // ---- SWD debug + reset ----
    net SWDIO: ctrl.SWDIO, j1.SWDIO
    net SWDCLK: ctrl.SWDCLK, j1.SWDCLK
    net XRES: ctrl.XRES, r_xres.B, c_xres.A, j1.XRES

    // ---- unused GPIO / alt-function pins ----
    nc: ctrl.P3_3, ctrl.INT_TBT, ctrl.UART_TX, ctrl.UART_RX, ctrl.SDA_SCB2, ctrl.SCL_SCB2,
        ctrl.P2_3, ctrl.P2_4, ctrl.P3_0, ctrl.SDA_SCB3, ctrl.SCL_SCB3, ctrl.SBU1_SYS, ctrl.SBU2_SYS

    // ---- layout: controller + Type-C connector + VBUS path + header ----
    layout {
        net_class HighSpeed { USB_DP_C, USB_DM_C, USB_DP_SYS, USB_DM_SYS }
        diff_pair(USB_DP_C, USB_DM_C)
        net_class CC { CC1, CC2 }
        board_outline: "mechanical/ccg6sf-typec-outline.dxf"
        // USB-C receptacle at the top edge (mouth off the -y edge)
        place usbc at (0mm, -16mm) rotate 180
        place ctrl at (-8mm, 4mm)
        place r_sense at (8mm, 0mm)
        place q_cons at (8mm, 8mm)
        place j1 at (0mm, 19mm)
    }
}
