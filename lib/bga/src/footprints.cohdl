    pad H7: P_UFBGA_LAND_028 at (1.25mm, 1.75mm)
    pad H8: P_UFBGA_LAND_028 at (1.75mm, 1.75mm)
    silkscreen {
        pin_1_marker near pad A1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (5.65mm, 5.65mm) }
    silkscreen_ref { at: (0mm, -3.3mm) }
}

// UFBGA100, sparse 100-ball array on a 12x12 grid, 7x7mm nominal body,
// 0.50mm pitch and 0.60mm maximum height. The exact populated map follows
// Figures 35 and 36 and is checked against the pinned STM32F072V(8-B)Hx ST
// pinout. Top-view A1 is upper-left; row I is skipped by the ball designators.
pub footprint BGA100C50P12X12_700X700X60N {
    pad A1: P_UFBGA_LAND_028 at (-2.75mm, -2.75mm)
