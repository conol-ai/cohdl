// LAILAN 31-contact, 0.30 mm pitch, bottom-contact flip-lock FPC connector.
// The manufacturer recommended PCB layout uses staggered odd/even rows.
#[doc("docs/lailan-fpc-cx01-31p0.3-gw.pdf")]
pub device LAILAN_FPC_CX01_31P {
    pins {
        optional P1: 1 [passive]
        optional P2: 2 [passive]
        optional P3: 3 [passive]
        optional P4: 4 [passive]
        optional P5: 5 [passive]
        optional P6: 6 [passive]
        optional P7: 7 [passive]
        optional P8: 8 [passive]
        optional P9: 9 [passive]
        optional P10: 10 [passive]
        optional P11: 11 [passive]
        optional P12: 12 [passive]
        optional P13: 13 [passive]
        optional P14: 14 [passive]
        optional P15: 15 [passive]
        optional P16: 16 [passive]
        optional P17: 17 [passive]
        optional P18: 18 [passive]
        optional P19: 19 [passive]
        optional P20: 20 [passive]
        optional P21: 21 [passive]
        optional P22: 22 [passive]
        optional P23: 23 [passive]
        optional P24: 24 [passive]
        optional P25: 25 [passive]
        optional P26: 26 [passive]
        optional P27: 27 [passive]
        optional P28: 28 [passive]
        optional P29: 29 [passive]
        optional P30: 30 [passive]
        optional P31: 31 [passive]
        required SHELL32: 32 [passive]
        required SHELL33: 33 [passive]
    }
}
impl Connector for LAILAN_FPC_CX01_31P {}

#[doc("docs/lailan-fpc-cx01-31p0.3-gw.pdf")]
pub part CON_LAILAN_FPC_CX01_31P0_3_GW: LAILAN_FPC_CX01_31P {
    primary { mfr: "LAILAN", mpn: "LAIL-FPC-CX01-31P0.3-GW",
              footprint: FP_LAILAN_FPC_CX01_31P0_3_GW }
}

pub pad P_LAILAN_FPC_CX01_ODD {
    shape: rect
    size: (0.3mm, 0.8mm)
    layer: top_copper
    plating: smd
}

pub pad P_LAILAN_FPC_CX01_EVEN {
    shape: rect
    size: (0.3mm, 0.65mm)
    layer: top_copper
    plating: smd
}

pub pad P_LAILAN_FPC_CX01_SHELL {
    shape: rect
    size: (0.3mm, 1.15mm)
    layer: top_copper
    plating: smd
}

// Pin centres advance by 0.30 mm. Odd contacts are on the No.1 row and even
// contacts on the No.2 row; their centre separation is
// 0.80/2 + 2.15 + 0.65/2 = 2.875 mm. Shell centres are 10.30 mm apart.
pub footprint FP_LAILAN_FPC_CX01_31P0_3_GW {
    pad 1: P_LAILAN_FPC_CX01_ODD at (-4.5mm, 1.4375mm)
