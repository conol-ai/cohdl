#[doc("docs/ti-lp5912.pdf")]
pub part LDO_LP5912_3V3: LP5912_3V3 {
    primary { mfr: "Texas Instruments", mpn: "LP5912-3.3DRVR", footprint: son::TI_DRV0006A }
}

