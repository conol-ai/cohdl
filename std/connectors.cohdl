// USB Type-C receptacle, USB 2.0 only (16 contacts, HRO TYPE-C-31-M-12).
//
// Pad names verified against the KiCad official footprint
// Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12
// (pads A1 A4 A5 A6 A7 A8 A9 A12 B1 B4 B5 B6 B7 B8 B9 B12 SH).

pub device USB_C_Receptacle_2_0 {
    pins {
        required GND: A1, A12, B1, B12 [power_in]
        required VBUS: A4, A9, B4, B9 [power_out]   // the upstream source drives VBUS
        required CC1: A5 [passive]
        required CC2: B5 [passive]
        required DP: A6, B6 [bidirectional]
        required DN: A7, B7 [bidirectional]
        optional SBU1: A8 [passive]
        optional SBU2: B8 [passive]
        required SHIELD: SH [passive]
    }
}

impl Connector for USB_C_Receptacle_2_0 {}

pub part USB_C_HRO_TYPE_C_31_M_12: USB_C_Receptacle_2_0 {
    primary { mfr: "HRO", mpn: "TYPE-C-31-M-12", footprint: "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" }
}
