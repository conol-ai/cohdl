// HPDTek HPD16A Series: 16-pin LoRa sub-GHz transceiver module based on the
// Semtech SX1262. The T-SX1262 product sheet identifies the module in its
// mechanical drawing and block diagram and establishes the pin assignment
// below. It does not give a frequency-specific orderable code or a recommended
// PCB land pattern.
//
// HPD16A is not HPB16B3. LilyGO's official T-Display-SF32 V1.0 schematic shows
// HPB16B3 as a physically distinct 12-pin module with a different pin order.

#[doc("docs/hpd16a-tsx1262.pdf")]
pub device HPD16A {
    pins {
        optional ANT: 1 [bidirectional] // RF signal I/O, 50 ohm antenna (p3)
        required GND2: 2 [power_in]
        optional DIO3: 3 [bidirectional] // SX1262 DIO3; controls internal TCXO (p3)
        optional NC4: 4 [passive] // no connection (p3)
        required VCC: 5 [power_in] // supply 1.8-3.7V (p3)
        optional NC6: 6 [passive]
        optional DIO1: 7 [bidirectional] // SX1262 DIO1, software-configured (p3)
        optional BUSY: 8 [output] // module BUSY status (p3)
        required GND9: 9 [power_in]
        optional MISO: 10 [output] // SPI MISO (p3)
        optional MOSI: 11 [input] // SPI MOSI (p3)
        optional SCK: 12 [input] // SPI SCLK (p3)
        optional NSS: 13 [input] // SPI NSS (p3)
        optional NRESET: 14 [bidirectional] // reset, active-low (p3)
        optional NC15: 15 [passive]
        required GND16: 16 [power_in]
    }
}

impl IC for HPD16A {}

// No part declaration: the product sheet gives complete component-side
// dimensions (16 x 16 mm body, eight castellations per side, 2 mm pitch), but
// no recommended PCB land pattern, and "HPD16A Series" does not distinguish
// the frequency/matching variant. Do not restore the former inferred footprint
// or equate this device with HPB16B3.
