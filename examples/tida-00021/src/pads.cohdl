// tida-00021 example pad library — the discrete power-stage lands the TPS59650
// controller drives. Controller pads live in std (P_QFN040_*, P_TPS59650_EP).

// Power SO-8 (SOIC-8) lead — Vishay/TI PowerPAK SO-8 class (KiCad SOIC-8 land).
pub pad P_SOIC_Lead {
    shape: rect
    size: (1.55mm, 0.6mm)
    layer: top_copper
    plating: smd
}

// Shielded power-inductor terminal (~5x5mm part, e.g. Coilcraft XAL50xx) —
// two large SMD lands.
pub pad P_Ind_Pwr {
    shape: rect
    size: (1.6mm, 4.6mm)
    layer: top_copper
    plating: smd
}

// 2.54mm header hole (interface to the CPU/PCH: rails, SVID, enable, status).
pub pad P_Hdr254 {
    shape: circle
    size: (1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: 1mm
}
