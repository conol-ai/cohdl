// SON / WSON land patterns shared by parts of more than one package.
//
// Frame: CoHDL's board frame (+x right, +y DOWN, top view), origin at the
// package centre. Each land keeps the manufacturer's top view as drawn:
// pin 1 at the upper left, numbering counter-clockwise. The drawings put +y
// up the page, so every drawing y is negated here.
//
// No part number has been read on these lands in an assembler preview, so
// they are not known to sit on the assembler's frame; see docs/README.md.

// TI DRV0006A, 6-pin WSON 2.0 x 2.0mm, 0.65mm pitch, drawing 4222173/D
// (09/2026), "Example Board Layout": 6X 0.45 x 0.3mm lands with R0.05mm
// corners, 4X 0.65mm pitch, 1.95mm between row centres, and a 1.0 x 1.6mm
// exposed-pad land (pad 7). TI prefers a non-solder-mask-defined opening
// with at most 0.07mm expansion all around.
pub pad P_TI_DRV0006A_LEAD {
    shape: rect
    size: (0.45mm, 0.3mm)
    layer: top_copper
    plating: smd
    corner_radius: 0.05mm
    mask_expansion: 0.07mm
}

// The exposed-pad copper suppresses its default paste. The two helper
// lands below, placed with the same pad number, add the stencil apertures
// of the drawing's "Example Stencil Design" (0.125mm stencil, 88% printed
// coverage of pad 7): two 1.0 x 0.7mm openings centred 0.45mm either side
// of the centre line. Copper and electrical terminal are unchanged.
pub pad P_TI_DRV0006A_EP_COPPER {
    shape: rect
    size: (1mm, 1.6mm)
    layer: top_copper
    plating: smd
    mask_expansion: 0.07mm
    paste: none
}

pub pad P_TI_DRV0006A_EP_PASTE {
    shape: rect
    size: (1mm, 0.7mm)
    layer: top_copper
    plating: smd
    corner_radius: 0.05mm
}

// The drawing also shows two 0.2mm vias in pad 7, 1.1mm apart, and says
// "Vias are optional depending on application". They are not part of this
// land; add them in layout where a part's datasheet asks for them.
#[doc("docs/README.md")]
pub footprint TI_DRV0006A {
    pad 1: P_TI_DRV0006A_LEAD at (-0.975mm, -0.65mm)
    pad 2: P_TI_DRV0006A_LEAD at (-0.975mm, 0mm)
    pad 3: P_TI_DRV0006A_LEAD at (-0.975mm, 0.65mm)
    pad 4: P_TI_DRV0006A_LEAD at (0.975mm, 0.65mm)
    pad 5: P_TI_DRV0006A_LEAD at (0.975mm, 0mm)
    pad 6: P_TI_DRV0006A_LEAD at (0.975mm, -0.65mm)
    pad 7: P_TI_DRV0006A_EP_COPPER at (0mm, 0mm)
    pad 7: P_TI_DRV0006A_EP_PASTE at (0mm, -0.45mm)
    pad 7: P_TI_DRV0006A_EP_PASTE at (0mm, 0.45mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    // Copper spans 2.40 x 1.60mm and the body is at most 2.1 x 2.1mm
    // (package outline). 0.25mm beyond the copper in x and beyond the body
    // in y.
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.9mm, 2.6mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}
