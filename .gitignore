/target
Cargo.lock.orig
*.orig
.DS_Store
/out
harness/runs/

# Local code-review artifacts (not part of the compiler)
.co/

# Rendered mdBook output and ad-hoc compile byproducts under tests/fixtures
docs/book/
tests/fixtures/*/out/

# On-demand build artifacts (not default `cohdl build` goldens): the IPC-2581
# document (--emit ipc2581), the tools/ visualizers' output, and KiCad session
# files created when a generated .kicad_pcb is opened in pcbnew.
examples/*/out/*.xml
examples/*/out/*.html
examples/*/out/*.svg
examples/*/out/*.kicad_pcb
examples/*/out/*.kicad_pro
examples/*/out/*.kicad_prl
examples/*/out/*.lck
examples/*/out/.history/
/registry/node_modules
/registry/dist
/site/node_modules
/ref/

# wrangler files (bot-added; covers registry/.wrangler too)
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
