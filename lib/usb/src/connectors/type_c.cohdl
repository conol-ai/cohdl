// USB Type-C receptacle, USB 2.0 only (16 contacts, HRO TYPE-C-31-M-12).
//
// Pad names verified against the KiCad official footprint
// Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12
// (pads A1 A4 A5 A6 A7 A8 A9 A12 B1 B4 B5 B6 B7 B8 B9 B12; the single KiCad
// shield pad `SH` becomes SH1..SH4 — CoHDL requires unique pad numbers, E806).

#[doc("docs/hro-type-c-31-m-12-family-drawing.pdf")]
pub device USB_C_Receptacle_2_0 {
    pins {
        required GND: A1, A12, B1, B12 [power_in]
        required VBUS: A4, A9, B4, B9 [power_out] // the upstream source drives VBUS
        required CC1: A5 [passive]
        required CC2: B5 [passive]
        required DP: A6, B6 [bidirectional]
        required DN: A7, B7 [bidirectional]
        optional SBU1: A8 [passive]
        optional SBU2: B8 [passive]
        required SHIELD: SH1, SH2, SH3, SH4 [passive]
    }
}

impl Connector for USB_C_Receptacle_2_0 {}

#[doc("docs/hro-type-c-31-m-12-family-drawing.pdf")]
pub part USB_C_HRO_TYPE_C_31_M_12: USB_C_Receptacle_2_0 {
    primary { mfr: "HRO", mpn: "TYPE-C-31-M-12", footprint: FP_USB_C_Receptacle_HRO_TYPE_C_31_M_12 }
}

// USB Type-C (HRO TYPE-C-31-M-12) power/ground contact land — the 0.6mm-wide
// SMD pads (A1/A4/A9/A12/B1/B4/B9/B12). HRO's recommended PCB layout gives a
// 1.64mm contact-land length.
pub pad P_USBC_Sig_L {
    shape: rect
    size: (0.6mm, 1.64mm)
    layer: top_copper
    plating: smd
}

// USB Type-C signal contact land — the 0.3mm-wide SMD pads
// (CC1/CC2/DP/DN/SBU1/SBU2: A5/A6/A7/A8/B5/B6/B7/B8).
pub pad P_USBC_Sig_S {
    shape: rect
    size: (0.3mm, 1.64mm)
    layer: top_copper
    plating: smd
}

// USB Type-C shield mounting tab — upper pair. The receptacle's shield legs
// are flat stampings, so the hole is a plated SLOT, not a round drill: a round
// hole large enough to clear the leg's long axis would eat the annular ring,
// and one sized to its width will not accept the leg at all.
//
// HRO TYPE-C-31-M-12 "RECOMMEND P.C.B LAYOUT (COMPONENT SIDE)", sheet 1 of 1:
// hole 0.60 wide (`4-0.60`) x 1.70 long, in a 0.90 x 2.00 copper oval — the
// 0.60/0.90 pair dimensioned at the lower left is hole width vs copper width,
// leaving a 0.15mm annular ring all round. Layout tolerance ±0.05.
pub pad P_USBC_Shield_T {
    shape: oval
    size: (0.9mm, 2mm)
    layer: through_all
    plating: plated_through_hole
    drill: (0.6mm, 1.7mm)
}

// USB Type-C shield mounting tab — lower pair. Same 0.60 slot width and the
// same 0.15mm ring; only the length differs (1.40 hole in a 1.70 copper oval).
pub pad P_USBC_Shield_B {
    shape: oval
    size: (0.9mm, 1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: (0.6mm, 1.4mm)
}

// USB Type-C receptacle, USB-2.0-only (HRO TYPE-C-31-M-12). HRO's component-side
// land pattern has 16 SMD contacts in one row at y=-4.045 (top-row A* and
// bottom-row B* contacts overlap where their nets are common), four plated
// shield/mounting slots, and two non-plated locating holes. The four equivalent
// shield lands use unique SH1..SH4 numbers because CoHDL requires unique pad
// identifiers (E806). Pad names otherwise preserve HRO's contact designators.
//
// The locating holes take the diameter from HRO's own RECOMMEND P.C.B LAYOUT
// (5.78 apart, Ø0.60) rather than KiCad's Ø0.65 for the same feature: the
// bosses are Ø0.50, so 0.60 is the vendor's stated fit. A fab that cannot hold
// NPTH to ±0.05 should open these to 0.65 — they only locate the part, and the
// four SH tabs carry the retention.
pub footprint FP_USB_C_Receptacle_HRO_TYPE_C_31_M_12 {
    pad A1: P_USBC_Sig_L at (-3.2mm, -4.045mm)
    pad A4: P_USBC_Sig_L at (-2.4mm, -4.045mm)
    pad A5: P_USBC_Sig_S at (-1.25mm, -4.045mm)
    pad A6: P_USBC_Sig_S at (-0.25mm, -4.045mm)
    pad A7: P_USBC_Sig_S at (0.25mm, -4.045mm)
    pad A8: P_USBC_Sig_S at (1.25mm, -4.045mm)
    pad A9: P_USBC_Sig_L at (2.4mm, -4.045mm)
    pad A12: P_USBC_Sig_L at (3.2mm, -4.045mm)
    pad B1: P_USBC_Sig_L at (3.2mm, -4.045mm)
    pad B4: P_USBC_Sig_L at (2.4mm, -4.045mm)
    pad B5: P_USBC_Sig_S at (1.75mm, -4.045mm)
    pad B6: P_USBC_Sig_S at (0.75mm, -4.045mm)
    pad B7: P_USBC_Sig_S at (-0.75mm, -4.045mm)
    pad B8: P_USBC_Sig_S at (-1.75mm, -4.045mm)
    pad B9: P_USBC_Sig_L at (-2.4mm, -4.045mm)
    pad B12: P_USBC_Sig_L at (-3.2mm, -4.045mm)
    pad SH1: P_USBC_Shield_T at (-4.32mm, -3.13mm)
    pad SH2: P_USBC_Shield_T at (4.32mm, -3.13mm)
    pad SH3: P_USBC_Shield_B at (-4.32mm, 1.05mm)
    pad SH4: P_USBC_Shield_B at (4.32mm, 1.05mm)
    mount_hole 1: non_plated at (-2.89mm, -2.6mm) diameter 0.6mm
    mount_hole 2: non_plated at (2.89mm, -2.6mm) diameter 0.6mm
    silkscreen {
        pin_1_marker near pad A1 shape dot
    }
    courtyard { shape: rect, at: (0mm, -0.56mm), size: (10.64mm, 9.42mm) }
    silkscreen_ref { at: (0mm, 2.5mm) }
}
