// Green user LED (reuses std ChipLED).
pub part LED_GREEN: ChipLED {
    primary { mfr: "Wurth", mpn: "150060GS75000", footprint: "LED_SMD:LED_0603_1608Metric" }
}

// ---- reusable Pico sub-circuits ----

// 4.7uF bulk/rail capacitor across a supply pin pair.
pub fn bulk_4u7(vdd: Pin, gnd: Pin) {
    inst c: C_4u7
    net _: vdd, c.A
    net _: gnd, c.B
}

// 47uF bulk capacitor across a rail.
pub fn bulk_47u(vdd: Pin, gnd: Pin) {
    inst c: C_47uF
    net _: vdd, c.A
    net _: gnd, c.B
}
