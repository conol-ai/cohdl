// Richtek RT9080: 2uA IQ, 600mA LDO with enable, 1.2-5.5V in (datasheet
// DS9080-09, December 2024). Two packages: TSOT-23-5 and ZQFN-4L 1x1.
// RT9080 = without SNS pin, RT9080N = with SNS. Pin config p4.

#[doc("docs/rt9080.pdf")]
pub device RT9080 {
    variants { TSOT235, ZQFN4L }
    pins[TSOT235] {
        required VIN: 1 [power_in] // supply input, 1uF cap close (p4)
        required GND: 2 [power_in] // ground, EP must solder to PCB (p4)
        required EN: 3 [input] // enable, high=on / <0.4V=off (p4)
        optional NC4: 4 [passive] // NC on RT9080; SNS exists only on RT9080N (p4)
        required VOUT: 5 [power_out] // regulator output (p4)
    }
    pins[ZQFN4L] {
        required VOUT: 1 [power_out]
        required GND: 2 [power_in]
        required EN: 3 [input]
        required SGND: 5 [power_in] // exposed substrate; connect to GND (p4)
        required VIN: 4 [power_in]
    }
}

impl IC for RT9080 {}

#[doc("docs/rt9080.pdf")]
pub part LDO_RT9080_33: RT9080[TSOT235] {
    primary { mfr: "Richtek", mpn: "RT9080-33GJ5", footprint: SOT5P95X290X160N }
}

#[doc("docs/rt9080.pdf")]
pub part LDO_RT9080_33_ZQFN: RT9080[ZQFN4L] {
    primary { mfr: "Richtek", mpn: "RT9080-33GQZ", footprint: FP_Richtek_ZQFN4L_1X1 }
}

// Richtek footprint table 20.1 (p19): 1.00 x 0.70 mm copper, 0.95 mm
// same-row pitch, 1.90 mm outer pin spacing and 3.60 mm row-to-row copper
// span. Rotated 90 degrees here so pin 1 is upper-left in CoHDL top view.
pub pad P_TSOT235_LEAD {
    shape: rect
    size: (1.0mm, 0.7mm)
    layer: top_copper
    plating: smd
}

pub footprint SOT5P95X290X160N {
    pad 1: P_TSOT235_LEAD at (-1.3mm, -0.95mm)
    pad 2: P_TSOT235_LEAD at (-1.3mm, 0mm)
    pad 3: P_TSOT235_LEAD at (-1.3mm, 0.95mm)
    pad 4: P_TSOT235_LEAD at (1.3mm, 0.95mm)
    pad 5: P_TSOT235_LEAD at (1.3mm, -0.95mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 3.4mm) }
    silkscreen_ref { at: (0mm, -2.0mm) }
}

// Richtek section 20.2 gives the complete ZQFN-4L 1x1 recommended land.
// Ax/Ay are 1.800/0.900mm, the inner clearances Bx/By are 0.450/0.350mm,
// and each 0.675 x 0.275mm lead has a 45-degree 0.201mm inner-corner cut
// (C-C1 = 0.675-0.474 = 0.201mm). The centre SGND diamond has 0.400mm
// horizontal and vertical diagonals, hence a 0.282843mm square rotated 45deg.
pub pad P_RT9080_ZQFN_TL {
    shape: rect
    size: (0.675mm, 0.275mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_right, 0.201mm)
}

pub pad P_RT9080_ZQFN_BL {
    shape: rect
    size: (0.675mm, 0.275mm)
    layer: top_copper
    plating: smd
    chamfer: (top_right, 0.201mm)
}

pub pad P_RT9080_ZQFN_BR {
    shape: rect
    size: (0.675mm, 0.275mm)
    layer: top_copper
    plating: smd
    chamfer: (top_left, 0.201mm)
}

pub pad P_RT9080_ZQFN_TR {
    shape: rect
    size: (0.675mm, 0.275mm)
    layer: top_copper
    plating: smd
    chamfer: (bottom_left, 0.201mm)
}

pub pad P_RT9080_ZQFN_SGND {
    shape: rect
    size: (0.282842712474619mm, 0.282842712474619mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_Richtek_ZQFN4L_1X1 {
    pad 1: P_RT9080_ZQFN_TL at (-0.5625mm, -0.3125mm)
    pad 2: P_RT9080_ZQFN_BL at (-0.5625mm, 0.3125mm)
    pad 3: P_RT9080_ZQFN_BR at (0.5625mm, 0.3125mm)
    pad 4: P_RT9080_ZQFN_TR at (0.5625mm, -0.3125mm)
    pad 5: P_RT9080_ZQFN_SGND at (0mm, 0mm) rotate 45
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.3mm, 1.4mm) }
    silkscreen_ref { at: (0mm, -1mm) }
}
