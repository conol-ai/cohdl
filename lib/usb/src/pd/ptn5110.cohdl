pub pad P_SOT1883_H {
    shape: rect
    size: (0.9mm, 0.24mm)
    layer: top_copper
    plating: smd
}

pub pad P_SOT1883_V {
    shape: rect
    size: (0.24mm, 0.9mm)
    layer: top_copper
    plating: smd
}

pub pad P_SOT1883_EP {
    shape: rect
    size: (1.1mm, 1mm)
    layer: top_copper
    plating: smd
}

// Fig. 21 p54: copper only; source drawing is marked UNRELEASED.
#[doc("docs/ptn5110-application.md")]
#[doc("docs/nxp-ptn5110.pdf")]
pub footprint HX2QFN16_SOT1883_1 {
    pad 1: P_SOT1883_H at (-1.35mm, -0.8mm)
    pad 2: P_SOT1883_H at (-1.35mm, -0.4mm)
    pad 3: P_SOT1883_H at (-1.35mm, 0mm)
    pad 4: P_SOT1883_H at (-1.35mm, 0.4mm)
    pad 5: P_SOT1883_H at (-1.35mm, 0.8mm)
    pad 6: P_SOT1883_V at (-0.4mm, 1.35mm)
    pad 7: P_SOT1883_V at (0mm, 1.35mm)
    pad 8: P_SOT1883_V at (0.4mm, 1.35mm)
    pad 9: P_SOT1883_H at (1.35mm, 0.8mm)
    pad 10: P_SOT1883_H at (1.35mm, 0.4mm)
    pad 11: P_SOT1883_H at (1.35mm, 0mm)
    pad 12: P_SOT1883_H at (1.35mm, -0.4mm)
    pad 13: P_SOT1883_H at (1.35mm, -0.8mm)
    pad 14: P_SOT1883_V at (0.4mm, -1.35mm)
    pad 15: P_SOT1883_V at (0mm, -1.35mm)
    pad 16: P_SOT1883_V at (-0.4mm, -1.35mm)
    pad 17: P_SOT1883_EP at (0mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 4.1mm) }
    silkscreen_ref { at: (0mm, -2.5mm) }
}
