// prints on its numbered SOT-23 diagram; the sheets and their checksums are
// in docs/sot23.evidence.md. Every part sits on sot::SOT3P190X290X130N, the
// audited SOT-23-3 land on the assembler's frame (pin 1 lower right, pins 1
// and 2 the +x column, pin 3 alone at -x). A polarized part carries a
// supplier binding only with its own preview reading: the clause comes from
// tools/sourcing_data/lcsc_map.json and the part number's row in
// tools/sourcing_data/jlc_frames.json, as in tools/gen_zener.py.

// N-channel MOSFET, SOT-23: pin 1 gate, 2 source, 3 drain. VDS and ID are the sheet's absolute maximum ratings.
#[doc("docs/sot23.evidence.md")]
pub device NMOS_SOT23<VDS: Voltage, ID: Current> {
    pins {
        required Gate: 1 [input]
        required Source: 2 [passive]
        required Drain: 3 [passive]
    }
}

impl Transistor for NMOS_SOT23 {}

// P-channel MOSFET, SOT-23: pin 1 gate, 2 source, 3 drain. VDS and ID are the magnitudes of the sheet's absolute maximum ratings.
#[doc("docs/sot23.evidence.md")]
pub device PMOS_SOT23<VDS: Voltage, ID: Current> {
    pins {
        required Gate: 1 [input]
        required Source: 2 [passive]
        required Drain: 3 [passive]
    }
}

impl Transistor for PMOS_SOT23 {}

