// was: "Resistor_SMD:R_0201_0603Metric" / "Capacitor_SMD:C_0201_0603Metric"
// IPC-7351 name (RFC-021): the two-terminal 0201 chip land. Resistors and
// capacitors share the one nominal CHIP-0201 land pattern, so the R_0201 and
// C_0201 footprints (identical geometry) collapse into this single named land.
pub footprint CHIP_0201 {
    pad 1: P_Chip_0201 at (-0.32mm, 0mm)
    pad 2: P_Chip_0201 at (0.32mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (0.87mm, 0.4mm) }
    silkscreen_ref { at: (0mm, -0.6mm) }
}
