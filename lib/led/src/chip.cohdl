// Status LED: red chip LED, 0603.
// Chip-LED convention: pad 1 = cathode, pad 2 = anode.

#[doc("docs/liteon-ltst-c193krkt-5a.pdf")]
#[doc("docs/wurth-150060gs75000.pdf")]
pub device ChipLED {
    pins {
        required Cathode: 1 [passive]
        required Anode: 2 [passive]
    }
}

impl Polarized for ChipLED {}
impl Diode for ChipLED {}

#[doc("docs/liteon-ltst-c193krkt-5a.pdf")]
pub part LED_RED_0603: ChipLED {
    primary { mfr: "Lite-On", mpn: "LTST-C193KRKT-5A", footprint: FP_LED_0603_1608Metric }
}

// Lite-On suggested land: two 0.8mm square pads with 2.3mm overall span
// (datasheet page 7).
pub pad P_Chip_LED0603 {
    shape: rect
    size: (0.8mm, 0.8mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_LED_0603_1608Metric {
    pad 1: P_Chip_LED0603 at (-0.75mm, 0mm)
    pad 2: P_Chip_LED0603 at (0.75mm, 0mm)
    silkscreen {
        polarity_marker cathode_pin 1 shape band
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (2.8mm, 1.4mm) }
    silkscreen_ref { at: (0mm, -1.2mm) }
}
