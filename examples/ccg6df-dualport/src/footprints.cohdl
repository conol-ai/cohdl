// ccg6df-dualport example footprints — sense resistors, consumer NFETs, header.

// 2512 current-sense resistor (5mOhm), two 1.6x3.2mm lands at +/-2.35mm.
pub footprint FP_R2512 {
    pad 1: P_R2512 at (-2.35mm, 0mm)
    pad 2: P_R2512 at (2.35mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (7.0mm, 3.6mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}

// Power SO-8 N-FET (PowerPAK SO-8). IPC-7351 name.
pub footprint SOIC8P127X600X175N {
    pad 1: P_SOIC_Lead at (-2.7mm, -1.905mm)
    pad 2: P_SOIC_Lead at (-2.7mm, -0.635mm)
    pad 3: P_SOIC_Lead at (-2.7mm, 0.635mm)
    pad 4: P_SOIC_Lead at (-2.7mm, 1.905mm)
    pad 5: P_SOIC_Lead at (2.7mm, 1.905mm)
    pad 6: P_SOIC_Lead at (2.7mm, 0.635mm)
    pad 7: P_SOIC_Lead at (2.7mm, -0.635mm)
    pad 8: P_SOIC_Lead at (2.7mm, -1.905mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.2mm, 5.4mm) }
    silkscreen_ref { at: (0mm, -3.2mm) }
}

// 1x20 2.54mm interface header: shared 5V/VSYS/GND, both system VBUS rails,
// EC + SoC I2C, both ports' USB2 data + HPD, SWD, reset.
pub footprint FP_Header_1x20 {
    pad 1: P_Hdr254 at (-24.13mm, 0mm)
    pad 2: P_Hdr254 at (-21.59mm, 0mm)
    pad 3: P_Hdr254 at (-19.05mm, 0mm)
    pad 4: P_Hdr254 at (-16.51mm, 0mm)
    pad 5: P_Hdr254 at (-13.97mm, 0mm)
    pad 6: P_Hdr254 at (-11.43mm, 0mm)
    pad 7: P_Hdr254 at (-8.89mm, 0mm)
    pad 8: P_Hdr254 at (-6.35mm, 0mm)
    pad 9: P_Hdr254 at (-3.81mm, 0mm)
    pad 10: P_Hdr254 at (-1.27mm, 0mm)
    pad 11: P_Hdr254 at (1.27mm, 0mm)
    pad 12: P_Hdr254 at (3.81mm, 0mm)
    pad 13: P_Hdr254 at (6.35mm, 0mm)
    pad 14: P_Hdr254 at (8.89mm, 0mm)
    pad 15: P_Hdr254 at (11.43mm, 0mm)
    pad 16: P_Hdr254 at (13.97mm, 0mm)
    pad 17: P_Hdr254 at (16.51mm, 0mm)
    pad 18: P_Hdr254 at (19.05mm, 0mm)
    pad 19: P_Hdr254 at (21.59mm, 0mm)
    pad 20: P_Hdr254 at (24.13mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (51.9mm, 2.6mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}
