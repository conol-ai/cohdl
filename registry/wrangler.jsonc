{
  // registry.cohdl.org — RFC-030. One Worker serves both the registry API
  // (run_worker_first routes) and the web UI (Workers Assets SPA).
  "name": "cohdl-registry",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  // Dashboard-assigned variables (RECAPTCHA_SITE_KEY) must survive CLI/CI
  // deploys — without this, wrangler deploy deletes plaintext vars it
  // doesn't know about (secrets always survive).
  "keep_vars": true,
  "assets": {
    "not_found_handling": "single-page-application",
    // The worker fronts EVERY request (not just API routes) so http->https
    // and HSTS are enforced in code, independent of zone-level settings;
    // non-API routes fall through to the ASSETS binding.
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cohdl-registry",
      "database_id": "fd0f8fda-ba4d-4f39-8fdd-a9e940ff9436"
    }
  ],
  "r2_buckets": [
    { "binding": "PKG", "bucket_name": "cohdl-registry-packages" }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "02a74c82d32241e99f45eee18a1fa1fc" }
  ],
  "workers_dev": true,
  "routes": [{ "pattern": "registry.cohdl.org", "custom_domain": true }]
}
