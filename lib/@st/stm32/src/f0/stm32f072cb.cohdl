// STM32F072CBT6 MCU — LQFP-48 7x7mm 0.5mm pitch.
//
// All 48 pads declared; PA8-PA15 (incl. USB PA11/PA12 and SWD PA13/PA14)
// are VDDIO2-powered (pin 36 tied to VDD). HSE crystal on PF0/PF1;
// crystal-less HSI48+CRS remains a fallback.
#[doc("docs/stm32f072cb-datasheet.pdf")]
pub device STM32F072CBT6 {
    pins {
        required VDD: 24, 48 [power_in]
        required VSS: 23, 35, 47 [power_in]
        required VDDA: 9 [power_in]
        required VSSA: 8 [power_in]
        required VBAT: 1 [power_in]
        required VDDIO2: 36 [power_in] // powers PA8-PA15 (USB + SWD)
        optional NRST: 7 [input] // permanent internal 25-55k pull-up
        // GPIO names follow the datasheet rather than any one board's
        // alternate-function assignment.
        optional PC13: 2 [bidirectional]
        optional PC14: 3 [bidirectional]
        optional PC15: 4 [bidirectional]
        optional PF0: 5 [bidirectional] // OSC_IN
        optional PF1: 6 [bidirectional] // OSC_OUT
        required BOOT0: 44 [input]
        optional PA0: 10 [bidirectional]
        optional PA1: 11 [bidirectional]
        optional PA2: 12 [bidirectional]
        optional PA3: 13 [bidirectional]
        optional PA4: 14 [bidirectional]
        optional PA5: 15 [bidirectional]
        optional PA6: 16 [bidirectional]
        optional PA7: 17 [bidirectional]
        optional PB0: 18 [bidirectional]
        optional PB1: 19 [bidirectional]
        optional PB2: 20 [bidirectional]
        optional PB10: 21 [bidirectional]
        optional PB11: 22 [bidirectional]
        optional PB12: 25 [bidirectional]
        optional PB13: 26 [bidirectional]
        optional PB14: 27 [bidirectional]
        optional PB15: 28 [bidirectional]
        optional PA8: 29 [bidirectional]
        optional PA9: 30 [bidirectional]
        optional PA10: 31 [bidirectional]
        optional PA11: 32 [bidirectional] // USB_DM
        optional PA12: 33 [bidirectional] // USB_DP
        optional PA13: 34 [bidirectional] // SWDIO
        optional PA14: 37 [bidirectional] // SWCLK
        optional PA15: 38 [bidirectional]
        optional PB3: 39 [bidirectional]
        optional PB4: 40 [bidirectional]
        optional PB5: 41 [bidirectional]
        optional PB6: 42 [bidirectional]
        optional PB7: 43 [bidirectional]
        optional PB8: 45 [bidirectional]
        optional PB9: 46 [bidirectional]
    }
}

impl IC for STM32F072CBT6 {}

#[doc("docs/stm32f072cb-datasheet.pdf")]
pub part MCU_STM32F072: STM32F072CBT6 {
    primary { mfr: "STMicroelectronics", mpn: "STM32F072CBT6", footprint: QFP50P900X900X160_48N }
}

// LQFP-48 0.5mm lead, left/right sides (KiCad
// Package_QFP:LQFP-48_7x7mm_P0.5mm).
pub pad P_LQFP48_Lead_H {
    shape: rect
    size: (1.2mm, 0.3mm)
    layer: top_copper
    plating: smd
}

// LQFP-48 0.5mm lead, top/bottom sides.
pub pad P_LQFP48_Lead_V {
    shape: rect
    size: (0.3mm, 1.2mm)
    layer: top_copper
    plating: smd
}

// ST DS9826 Rev 6, Figure 50: recommended LQFP-48 land pattern uses
// 1.20x0.30mm lands, 0.50mm pitch, 9.70mm land span and a 5.80mm
// tangential land-row span. Datasheet +Y is negated for CoHDL/KiCad.
pub footprint QFP50P900X900X160_48N {
    pad 1: P_LQFP48_Lead_H at (-4.25mm, -2.75mm)
    pad 2: P_LQFP48_Lead_H at (-4.25mm, -2.25mm)
    pad 3: P_LQFP48_Lead_H at (-4.25mm, -1.75mm)
    pad 4: P_LQFP48_Lead_H at (-4.25mm, -1.25mm)
    pad 5: P_LQFP48_Lead_H at (-4.25mm, -0.75mm)
    pad 6: P_LQFP48_Lead_H at (-4.25mm, -0.25mm)
    pad 7: P_LQFP48_Lead_H at (-4.25mm, 0.25mm)
    pad 8: P_LQFP48_Lead_H at (-4.25mm, 0.75mm)
    pad 9: P_LQFP48_Lead_H at (-4.25mm, 1.25mm)
    pad 10: P_LQFP48_Lead_H at (-4.25mm, 1.75mm)
    pad 11: P_LQFP48_Lead_H at (-4.25mm, 2.25mm)
    pad 12: P_LQFP48_Lead_H at (-4.25mm, 2.75mm)
    pad 13: P_LQFP48_Lead_V at (-2.75mm, 4.25mm)
    pad 14: P_LQFP48_Lead_V at (-2.25mm, 4.25mm)
    pad 15: P_LQFP48_Lead_V at (-1.75mm, 4.25mm)
    pad 16: P_LQFP48_Lead_V at (-1.25mm, 4.25mm)
    pad 17: P_LQFP48_Lead_V at (-0.75mm, 4.25mm)
    pad 18: P_LQFP48_Lead_V at (-0.25mm, 4.25mm)
    pad 19: P_LQFP48_Lead_V at (0.25mm, 4.25mm)
    pad 20: P_LQFP48_Lead_V at (0.75mm, 4.25mm)
    pad 21: P_LQFP48_Lead_V at (1.25mm, 4.25mm)
    pad 22: P_LQFP48_Lead_V at (1.75mm, 4.25mm)
    pad 23: P_LQFP48_Lead_V at (2.25mm, 4.25mm)
    pad 24: P_LQFP48_Lead_V at (2.75mm, 4.25mm)
    pad 25: P_LQFP48_Lead_H at (4.25mm, 2.75mm)
    pad 26: P_LQFP48_Lead_H at (4.25mm, 2.25mm)
    pad 27: P_LQFP48_Lead_H at (4.25mm, 1.75mm)
    pad 28: P_LQFP48_Lead_H at (4.25mm, 1.25mm)
    pad 29: P_LQFP48_Lead_H at (4.25mm, 0.75mm)
    pad 30: P_LQFP48_Lead_H at (4.25mm, 0.25mm)
    pad 31: P_LQFP48_Lead_H at (4.25mm, -0.25mm)
    pad 32: P_LQFP48_Lead_H at (4.25mm, -0.75mm)
    pad 33: P_LQFP48_Lead_H at (4.25mm, -1.25mm)
    pad 34: P_LQFP48_Lead_H at (4.25mm, -1.75mm)
    pad 35: P_LQFP48_Lead_H at (4.25mm, -2.25mm)
    pad 36: P_LQFP48_Lead_H at (4.25mm, -2.75mm)
    pad 37: P_LQFP48_Lead_V at (2.75mm, -4.25mm)
    pad 38: P_LQFP48_Lead_V at (2.25mm, -4.25mm)
    pad 39: P_LQFP48_Lead_V at (1.75mm, -4.25mm)
    pad 40: P_LQFP48_Lead_V at (1.25mm, -4.25mm)
    pad 41: P_LQFP48_Lead_V at (0.75mm, -4.25mm)
    pad 42: P_LQFP48_Lead_V at (0.25mm, -4.25mm)
    pad 43: P_LQFP48_Lead_V at (-0.25mm, -4.25mm)
    pad 44: P_LQFP48_Lead_V at (-0.75mm, -4.25mm)
    pad 45: P_LQFP48_Lead_V at (-1.25mm, -4.25mm)
    pad 46: P_LQFP48_Lead_V at (-1.75mm, -4.25mm)
    pad 47: P_LQFP48_Lead_V at (-2.25mm, -4.25mm)
    pad 48: P_LQFP48_Lead_V at (-2.75mm, -4.25mm)
    // RFC-031: pin 1 is the top of the LEFT lead column, so the dot lands
    // outboard of it — an assembler cannot orient a 48-lead QFP without it.
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (10.2mm, 10.2mm) }
    silkscreen_ref { at: (0mm, -5.2mm) }
}
