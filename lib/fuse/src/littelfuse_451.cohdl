// Littelfuse "Recommended pad layout" (p4): two 1.96 x 3.15mm lands,
// 2.95mm apart, 6.86mm overall. 2 x 1.96 + 2.95 is 6.87mm; the land keeps
// the land size and the 6.86mm overall dimension, so the centres are at
// +/-2.45mm and the gap is 2.94mm.
pub pad P_LITTELFUSE_NANO2 {
    shape: rect
    size: (1.96mm, 3.15mm)
    layer: top_copper
    plating: smd
}

// The fuse is symmetric: pad 1 at -x and pad 2 at +x are interchangeable,
// and there is no polarity or pin 1 mark. The body is 6.10 +/-0.20mm long
// and 2.69 +/-0.25mm square (p4). The courtyard is 0.25mm beyond the
// 6.86 x 3.15mm copper, which also contains the 6.30 x 2.94mm maximum body.
pub footprint FP_LITTELFUSE_NANO2 {
    pad 1: P_LITTELFUSE_NANO2 at (-2.45mm, 0mm)
    pad 2: P_LITTELFUSE_NANO2 at (2.45mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (7.4mm, 3.7mm) }
    silkscreen_ref { at: (0mm, -2.6mm) }
}
