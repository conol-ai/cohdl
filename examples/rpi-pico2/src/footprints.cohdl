// TP-1221U-K9K5325 (XKB) BOOTSEL button — SMD tactile switch, ~4.2x3.2mm body,
// 4 terminals. Land from the Panasonic EVQPU-class SMD tactile (KiCad
// Button_Switch_SMD:Panasonic_EVQPUJ_EVQPUA); demo-grade — confirm against the
// XKB drawing. Terminal A = pads 1,2 (left); terminal B = pads 3,4 (right).
pub footprint FP_SW_SPST_TP1221U {
    pad 1: P_Switch_SMD_Tact at (-2.625mm, -0.85mm)
    pad 2: P_Switch_SMD_Tact at (-2.625mm, 0.85mm)
    pad 3: P_Switch_SMD_Tact at (2.625mm, -0.85mm)
    pad 4: P_Switch_SMD_Tact at (2.625mm, 0.85mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.9mm, 3.7mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}

// PMEG6010ELR — real package is SOD-123W / SOD-123F (Nexperia CFP3, flat-lead),
