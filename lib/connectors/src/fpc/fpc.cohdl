// FPC, RF coax and magnetic pogo connectors. Exact manufacturer land patterns
// are recorded in the per-part evidence documents.

// 24-pin 0.5mm pitch FPC socket. Standard one-sided FPC: pins 1-24 are
// bidirectional signals assigned by the board author.
#[doc("docs/hirose-fh12-24s-0.5sh.evidence.md")]
pub device FPC24_0P5 {
    pins {
        optional P1: 1 [bidirectional] // fpc pin 1
        optional P2: 2 [bidirectional] // fpc pin 2
        optional P3: 3 [bidirectional] // fpc pin 3
        optional P4: 4 [bidirectional] // fpc pin 4
        optional P5: 5 [bidirectional] // fpc pin 5
        optional P6: 6 [bidirectional] // fpc pin 6
        optional P7: 7 [bidirectional] // fpc pin 7
        optional P8: 8 [bidirectional] // fpc pin 8
        optional P9: 9 [bidirectional] // fpc pin 9
        optional P10: 10 [bidirectional] // fpc pin 10
        optional P11: 11 [bidirectional] // fpc pin 11
        optional P12: 12 [bidirectional] // fpc pin 12
        optional P13: 13 [bidirectional] // fpc pin 13
        optional P14: 14 [bidirectional] // fpc pin 14
        optional P15: 15 [bidirectional] // fpc pin 15
        optional P16: 16 [bidirectional] // fpc pin 16
        optional P17: 17 [bidirectional] // fpc pin 17
        optional P18: 18 [bidirectional] // fpc pin 18
        optional P19: 19 [bidirectional] // fpc pin 19
        optional P20: 20 [bidirectional] // fpc pin 20
        optional P21: 21 [bidirectional] // fpc pin 21
        optional P22: 22 [bidirectional] // fpc pin 22
        optional P23: 23 [bidirectional] // fpc pin 23
        optional P24: 24 [bidirectional] // fpc pin 24
        optional MP: MP [passive]
    }
}

impl Connector for FPC24_0P5 {}

// 1-pin RF coax socket, IPEX MHF4 class (used for 4G/WiFi/BT antenna feeds).
#[doc("docs/conmhf4-smd-g-t.evidence.md")]
pub device IPEX_MHF4 {
    pins {
        required RF1: 1 [bidirectional] // RF signal, 50 ohm coax (center pin)
        required GND: 2 [power_in] // three outer shield lands
    }
}

impl Connector for IPEX_MHF4 {}

// 2-pin battery spring clip.
#[doc("docs/README.md")]
pub device BAT_CONN_2P {
    pins {
        required P1: 1 [power_in] // battery positive
        required P2: 2 [power_in] // battery negative
    }
}

impl Connector for BAT_CONN_2P {}

// 4-pin magnetic pogo charge connector: two power pins plus two passive
// (data / identification) pins.
#[doc("docs/yzp0048-20048-04025-03.evidence.md")]
pub device MAG_CONN_4P {
    pins {
        required P1: 1 [power_in] // charge positive
        required P2: 2 [power_in] // charge negative
        optional P3: 3 [passive] // data / ID
        optional P4: 4 [passive] // data / ID
    }
}

impl Connector for MAG_CONN_4P {}

// 2-pin analog MEMS microphone module terminal: audio output + supply.
// P1 carries the mic's analog OUT (board-side 1uF DC-block to the codec ADC,
// note 13.2); P2 is the mic VDD (board-side 100 ohm series + 100nF decouple).
// Mic module GND is on the module side.
#[doc("docs/README.md")]
pub device MIC_CONN_2P {
    pins {
        required P1: 1 [bidirectional] // analog audio out
        required P2: 2 [power_in] // mic VDD
    }
}

impl Connector for MIC_CONN_2P {}

// 10-pin debug/test FPC port (note §5 J7: 8-10pin 0.5mm FPC — SWD 4pin +
// UART 3pin + VCC/GND + BOOT). SWDIO/SWCLK go to the ESP32-S3 JTAG
// (MTDI/MTMS); UART taps the SF32 DBG_UART (PA18/19); BOOT drives the
// ESP32-S3 GPIO0 strap through the design's pull-up net; NRST is the
// ESP32-S3 EN (reset).
#[doc("docs/hirose-fh12-10s-0.5sh.evidence.md")]
pub device DEBUG_CONN_10P {
    pins {
        required SWDIO: 1 [bidirectional] // SWD data / JTAG TMS
        required SWCLK: 2 [bidirectional] // SWD clock / JTAG TCK
        required UART_TX: 3 [bidirectional] // SF32 DBG_UART TX (PA18)
        required UART_RX: 4 [bidirectional] // SF32 DBG_UART RX (PA19)
        required BOOT: 5 [input] // ESP32-S3 GPIO0 strap
        required NRST: 6 [bidirectional] // ESP32-S3 EN
        required VCC: 7 [power_out] // board 3.3V reference for the probe
        required GND: 8 [power_in] // ground
        required GND2: 9 [power_in] // ground
        required GND3: 10 [power_in] // ground
        optional MP: MP [passive]
    }
}

impl Connector for DEBUG_CONN_10P {}

// 2-pin speaker terminal for the NS4168 Class-D differential outputs
// (AMP_OUTP/AMP_OUTN → SPK.P1/P2).
#[doc("docs/README.md")]
pub device SPK_2P {
    pins {
        required P1: 1 [passive] // speaker + (amp VOP)
        required P2: 2 [passive] // speaker - (amp VON)
    }
}

impl Connector for SPK_2P {}

