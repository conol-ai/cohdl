// Linx CONMHF4-SMD recommended footprint (datasheet p.3, Figure 2), shown
// as drawn: shield lands 0.58 x 1.58 within the 2.5mm span and 1.34mm gap,
// top shield 0.5 x 0.5 spanning y -1.25..-0.75, signal 0.6 x 0.6 spanning
// y 0.65..1.25. The three shield lands are electrical pin 2.
pub footprint FP_IPEX_MHF4 {
    pad 1: P_CONMHF4_SIGNAL at (0mm, 0.95mm)
    pad 2: P_CONMHF4_GROUND_TOP at (0mm, -1.0mm)
    pad 2: P_CONMHF4_GROUND_SIDE at (-0.96mm, 0mm)
    pad 2: P_CONMHF4_GROUND_SIDE at (0.96mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.0mm, 3.0mm) }
    silkscreen_ref { at: (0mm, -2.0mm) }
}

