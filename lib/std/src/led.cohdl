// Status LED: red chip LED, 0603.
// Chip-LED convention: pad 1 = cathode, pad 2 = anode.

pub device ChipLED {
    pins {
        required Cathode: 1 [passive]
        required Anode: 2 [passive]
    }
}

impl Polarized for ChipLED {}
impl Diode for ChipLED {}

pub part LED_RED_0603: ChipLED {
    primary { mfr: "Lite-On", mpn: "LTST-C193KRKT-5A", footprint: FP_LED_0603_1608Metric }
}
