// Semtech SX1280: 2.4GHz LoRa/FLRC transceiver, SPI (datasheet Rev 3.2,
// March 2020). QFN 4x4 24L + EP. Pin location p18. It uses the same
// manufacturer-recommended MLPQ24 land pattern as SX1262.

#[doc("docs/sx1280.pdf")]
pub device SX1280 {
    pins {
        optional VR_PA: 1 [power_out] // PA regulator output (Figure 2-1)
        required VDD_IN: 2 [power_in] // regulator input
        optional NRESET: 3 [input] // reset, active-low
        optional XTA: 4 [passive] // crystal input
        required GND5: 5 [power_in]
        optional XTB: 6 [passive] // crystal output
        optional BUSY: 7 [output] // busy status
        optional DIO1: 8 [bidirectional] // digital I/O / interrupt
        optional DIO2: 9 [bidirectional]
        optional DIO3: 10 [bidirectional]
        required VBAT_IO: 11 [power_in] // I/O supply
        optional DCC_FB: 12 [power_out] // regulated internal-regulator output (Table 7-1)
        required GND13: 13 [power_in]
        optional DCC_SW: 14 [output] // DC-DC switcher output (Table 7-1)
        required VBAT: 15 [power_in] // main supply
        optional MISO_TX: 16 [output] // SPI MISO / UART TX
        optional MOSI_RX: 17 [input] // SPI MOSI / UART RX
        optional SCK_RTSN: 18 [bidirectional] // SPI clock input / UART RTS output (sections 9.2, 9.5)
        optional NSS_CTSN: 19 [input] // SPI NSS / UART CTS
        required GND20: 20 [power_in]
        required GND21: 21 [power_in]
        optional RFIO: 22 [bidirectional] // RF input/output
        required GND23: 23 [power_in]
        required GND24: 24 [power_in]
        required EP: 0 [power_in] // exposed pad ground
    }
}

impl IC for SX1280 {}

#[doc("docs/sx1280.pdf")]
pub part LORA_SX1280: SX1280 {
    primary { mfr: "Semtech", mpn: "SX1280IMLTRT", footprint: QFN24N50P400X400_1EP270X270 }
}
