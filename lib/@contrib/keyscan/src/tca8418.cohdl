// Texas Instruments TCA8418: 80-key keypad scanner, I2C, 1.65-3.6V
// (datasheet SCPS215G, Sep 2009 rev Jun 2018). RTW 24-pin WQFN 4x4mm
// 0.5 pitch + thermal pad (p50-52). Pin functions p3.

#[doc("docs/tca8418.pdf")]
pub device TCA8418 {
    pins {
        optional ROW7: 1 [bidirectional] // GPIO or keypad row 7 (p3)
        optional ROW6: 2 [bidirectional]
        optional ROW5: 3 [bidirectional]
        optional ROW4: 4 [bidirectional]
        optional ROW3: 5 [bidirectional]
        optional ROW2: 6 [bidirectional]
        optional ROW1: 7 [bidirectional]
        optional ROW0: 8 [bidirectional]
        optional COL0: 9 [bidirectional] // GPIO or keypad col 0 (p3)
        optional COL1: 10 [bidirectional]
        optional COL2: 11 [bidirectional]
        optional COL3: 12 [bidirectional]
        optional COL4: 13 [bidirectional]
        optional COL5: 14 [bidirectional]
        optional COL6: 15 [bidirectional]
        optional COL7: 16 [bidirectional]
        optional COL8: 17 [bidirectional]
        optional COL9: 18 [bidirectional]
        required GND: 19 [power_in]
        required RESET: 20 [input] // active-low reset, pull-up to VCC (p3)
        required VCC: 21 [power_in] // 1.65-3.6V (p3)
        optional SDA: 22 [bidirectional] // I2C data, pull-up (p3)
        optional SCL: 23 [input] // I2C clock, pull-up (p3)
        optional INT: 24 [output] // active-low interrupt, open-drain, pull-up (p3)
        // Exposed thermal pad — must be soldered to GND.
        required EPAD: 25 [power_in]
    }
}

impl IC for TCA8418 {}

#[doc("docs/tca8418.pdf")]
pub part KEYSCAN_TCA8418: TCA8418 {
    primary { mfr: "Texas Instruments", mpn: "TCA8418RTWR", footprint: QFN24N50P400X400_1EP245X245 }
}

// TI RTW0024B example board layout (datasheet p51): 0.60 x 0.24 mm
// perimeter copper, 0.50 mm pitch, opposing row centres 3.80 mm apart, and
// a 2.45 mm square exposed-pad land. The five 0.20 mm thermal vias and the
// four-window paste stencil shown on p51-52 remain board-fabrication
// requirements because CoHDL does not yet model footprint paste apertures or
// electrically-netted thermal vias.
pub pad P_TCA8418_RTW24_LEAD_H {
    shape: rect
    size: (0.6mm, 0.24mm)
    layer: top_copper
    plating: smd
}

pub pad P_TCA8418_RTW24_LEAD_V {
    shape: rect
    size: (0.24mm, 0.6mm)
    layer: top_copper
    plating: smd
}

pub pad P_TCA8418_RTW24_EP245 {
    shape: rect
    size: (2.45mm, 2.45mm)
    layer: top_copper
    plating: smd
}

pub footprint QFN24N50P400X400_1EP245X245 {
    pad 1: P_TCA8418_RTW24_LEAD_H at (-1.9mm, -1.25mm)
    pad 2: P_TCA8418_RTW24_LEAD_H at (-1.9mm, -0.75mm)
    pad 3: P_TCA8418_RTW24_LEAD_H at (-1.9mm, -0.25mm)
    pad 4: P_TCA8418_RTW24_LEAD_H at (-1.9mm, 0.25mm)
    pad 5: P_TCA8418_RTW24_LEAD_H at (-1.9mm, 0.75mm)
    pad 6: P_TCA8418_RTW24_LEAD_H at (-1.9mm, 1.25mm)
    pad 7: P_TCA8418_RTW24_LEAD_V at (-1.25mm, 1.9mm)
    pad 8: P_TCA8418_RTW24_LEAD_V at (-0.75mm, 1.9mm)
    pad 9: P_TCA8418_RTW24_LEAD_V at (-0.25mm, 1.9mm)
    pad 10: P_TCA8418_RTW24_LEAD_V at (0.25mm, 1.9mm)
    pad 11: P_TCA8418_RTW24_LEAD_V at (0.75mm, 1.9mm)
    pad 12: P_TCA8418_RTW24_LEAD_V at (1.25mm, 1.9mm)
    pad 13: P_TCA8418_RTW24_LEAD_H at (1.9mm, 1.25mm)
    pad 14: P_TCA8418_RTW24_LEAD_H at (1.9mm, 0.75mm)
    pad 15: P_TCA8418_RTW24_LEAD_H at (1.9mm, 0.25mm)
    pad 16: P_TCA8418_RTW24_LEAD_H at (1.9mm, -0.25mm)
    pad 17: P_TCA8418_RTW24_LEAD_H at (1.9mm, -0.75mm)
    pad 18: P_TCA8418_RTW24_LEAD_H at (1.9mm, -1.25mm)
    pad 19: P_TCA8418_RTW24_LEAD_V at (1.25mm, -1.9mm)
    pad 20: P_TCA8418_RTW24_LEAD_V at (0.75mm, -1.9mm)
    pad 21: P_TCA8418_RTW24_LEAD_V at (0.25mm, -1.9mm)
    pad 22: P_TCA8418_RTW24_LEAD_V at (-0.25mm, -1.9mm)
    pad 23: P_TCA8418_RTW24_LEAD_V at (-0.75mm, -1.9mm)
    pad 24: P_TCA8418_RTW24_LEAD_V at (-1.25mm, -1.9mm)
    pad 25: P_TCA8418_RTW24_EP245 at (0mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    // Contains the 4.40 mm copper span and 4.15 mm maximum body.
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.9mm, 4.9mm) }
    silkscreen_ref { at: (0mm, -2.7mm) }
}
