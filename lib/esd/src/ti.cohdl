// Board-level transient suppressors use a diode designator even when their
// internal topology is bidirectional or has more than two terminals.
pub trait ESD_Protector {
    designator_prefix: "D"
}

// TPD1E05U06: one unidirectional low-capacitance protected channel.
#[doc("docs/tpd1e05u06.pdf")]
pub device TPD1E05U06 {
    pins {
        required IO: 1 [bidirectional]
        required GND: 2 [power_in]
    }
}

impl ESD_Protector for TPD1E05U06 {}

#[doc("docs/tpd1e05u06.pdf")]
pub part ESD_TPD1E05U06DPYR: TPD1E05U06 {
    primary { mfr: "Texas Instruments", mpn: "TPD1E05U06DPYR", footprint: FP_X1SON_DPY_2 }
}

// TPD1E1B04: bidirectional two-terminal ESD suppressor. Both terminals are
// equivalent signal I/O pins; neither one is a dedicated ground terminal.
#[doc("docs/tpd1e1b04.pdf")]
pub device TPD1E1B04 {
    pins {
        required IO1: 1 [bidirectional]
        required IO2: 2 [bidirectional]
    }
}

impl ESD_Protector for TPD1E1B04 {}

#[doc("docs/tpd1e1b04.pdf")]
pub part ESD_TPD1E1B04DPYR: TPD1E1B04 {
    primary { mfr: "Texas Instruments", mpn: "TPD1E1B04DPYR", footprint: FP_X1SON_DPY_2 }
}

// TI DPY0002A land-pattern example: two 0.30 x 0.50mm lands on 0.70mm pitch.
pub pad P_X1SON_DPY_Lead {
    shape: rect
    size: (0.3mm, 0.5mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_X1SON_DPY_2 {
    pad 1: P_X1SON_DPY_Lead at (-0.35mm, 0mm)
    pad 2: P_X1SON_DPY_Lead at (0.35mm, 0mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.5mm, 1mm) }
    silkscreen_ref { at: (0mm, -0.85mm) }
}

// ESD122 DMY: two protected channels with a common ground.
#[doc("docs/esd122.pdf")]
pub device ESD122 {
    pins {
        required GND: 1 [power_in]
        required IO1: 2 [bidirectional]
        required IO2: 3 [bidirectional]
    }
}

impl ESD_Protector for ESD122 {}

#[doc("docs/esd122.pdf")]
pub part ESD_ESD122DMYR: ESD122 {
    primary { mfr: "Texas Instruments", mpn: "ESD122DMYR", footprint: FP_X2SON_DMY_3 }
}

// TI DMY0003A land-pattern example: three circular 0.20mm lands. Pin 1 is
// centered on the left; pins 3 and 2 are the upper- and lower-right lands.
pub pad P_X2SON_DMY_Land {
    shape: circle
    size: (0.2mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_X2SON_DMY_3 {
    pad 1: P_X2SON_DMY_Land at (-0.25mm, 0mm)
    pad 2: P_X2SON_DMY_Land at (0.25mm, 0.5mm)
    pad 3: P_X2SON_DMY_Land at (0.25mm, -0.5mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.2mm, 1.9mm) }
    silkscreen_ref { at: (0mm, -1.3mm) }
}
