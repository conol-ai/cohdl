// Awinic AW86224A/B: low-power F0-detect-and-tracking LRA haptic driver,
// I2C, integrated 3K memory (datasheet V1.7, November 2021). WLCSP-9
// 1.37 x 1.37 mm, 0.4 mm ball pitch (package p39, land pattern p40).
// Pin definition p2 Table; A/B variants share pinout.

#[doc("docs/aw86224.pdf")]
pub device AW86224 {
    pins {
        // Multi-mode pin: input trigger (pulse) or output interrupt. Default
        // INTN — needs pull-up when used as interrupt output (p2).
        optional TRIG_INTN: A1 [bidirectional]
        optional SDA: B1 [bidirectional] // I2C data, open-drain (p2)
        optional SCL: C1 [input] // I2C clock (p2)
        // Internal LDO output — needs external cap (p2: "Output of LDO").
        required VREG: A2 [power_out]
        required RSTN: B2 [input] // active-low hardware reset (p2)
        required VDD: C2 [power_in] // chip supply, 3.0-5.5V (p1)
        required HDP: A3 [output] // positive haptic driver output (p2)
        required GND: B3 [power_in]
        required HDN: C3 [output] // negative haptic driver output (p2)
    }
}

impl IC for AW86224 {}

#[doc("docs/aw86224.pdf")]
pub part HAPTIC_AW86224: AW86224 {
    primary { mfr: "Awinic", mpn: "AW86224FCR", footprint: BGA9C40P3X3_137X137X40N }
}

// WLCSP-9 land pattern (datasheet p40): pitch 0.40 TYP, pad diameter 0.22
// (ball diameter, p39), outer pad edge-to-edge span 1.02 REF (= 0.8 pitch
// span + 0.22 pad). Ball centres at +/-0.4 mm; A1 corner upper-left.
pub pad P_AW86224_BALL {
    shape: circle
    size: (0.22mm)
    layer: top_copper
    plating: smd
}

pub footprint BGA9C40P3X3_137X137X40N {
    pad A1: P_AW86224_BALL at (-0.4mm, -0.4mm)
    pad B1: P_AW86224_BALL at (0mm, -0.4mm)
    pad C1: P_AW86224_BALL at (0.4mm, -0.4mm)
    pad A2: P_AW86224_BALL at (-0.4mm, 0mm)
    pad B2: P_AW86224_BALL at (0mm, 0mm)
    pad C2: P_AW86224_BALL at (0.4mm, 0mm)
    pad A3: P_AW86224_BALL at (-0.4mm, 0.4mm)
    pad B3: P_AW86224_BALL at (0mm, 0.4mm)
    pad C3: P_AW86224_BALL at (0.4mm, 0.4mm)
    silkscreen {
        pin_1_marker near pad A1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.8mm, 1.8mm) }
    silkscreen_ref { at: (0mm, -1.1mm) }
}
