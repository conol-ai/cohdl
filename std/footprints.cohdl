// Footprint declarations, one per KiCad footprint the std library's
// parts previously named as a string. Each `was:` comment records the
// original KiCad footprint id. RFC-018 stage-two migration is underway:
// footprints with authored pad geometry (from std/pads.cohdl) get the
// full build-time pad-consistency check (E807) and project into
// .kicad_mod / IPC-2581; the rest are still RFC-017 stage-one
// placeholders (empty body = resolvable name only, exempt from E807)
// pending real datasheet-derived authoring.
//
// Filled (stage two): the chip passives (0402/0603), LED 0603, SOT-23-5.
// Still stage-one placeholders: the large multi-pad modules/connectors
// (ESP32-S3-WROOM-1, InvenSense ICS-43434, USB-C receptacle) — not used by
// any current example board, so their real land patterns are deferred until
// a board needs them.

// was: "Capacitor_SMD:C_0402_1005Metric" (geometry from that footprint)
pub footprint FP_C_0402_1005Metric {
    ipc_name: "CHIP-0402"
    pad 1: P_Chip_C0402 at (-0.48mm, 0mm)
    pad 2: P_Chip_C0402 at (0.48mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (1.82mm, 1.12mm) }
    silkscreen_ref { at: (0mm, -1.16mm) }
}

// was: "Capacitor_SMD:C_0603_1608Metric"
pub footprint FP_C_0603_1608Metric {
    ipc_name: "CHIP-0603"
    pad 1: P_Chip_0603 at (-0.775mm, 0mm)
    pad 2: P_Chip_0603 at (0.775mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (2mm, 0.95mm) }
    silkscreen_ref { at: (0mm, -1.2mm) }
}

