// Littelfuse 451 series NANO2 very fast-acting surface-mount fuses.
// Datasheet "NANO2 > Very Fast-Acting Fuse > 451/453 Series", revised
// 09/10/15 (docs/littelfuse-451.evidence.md). Ratings table on p2;
// dimensions, recommended pad layout and part numbering on p4.
//
// Family model: every 451 fuse is the same two-terminal body on the same
// land. The members differ in the ampere rating, which is the function of
// the part, so each rating is its own device with its own
// `current_rating`; a fuse of one rating is never an alternate of
// another. A part is one orderable code: series 0451, the amp code of p2,
// M (1000 pieces), R (tape and reel), L (RoHS, halogen free; p4).
// docs/README.md ("451 family") lists the members carried and left out.

// A fuse is a non-polar two-terminal part with its own designator.
pub trait Fuse: TwoTerminal {
    designator_prefix: "F"
}

// 0.500A: 125V, interrupting 50A at 125VAC/VDC, nominal cold resistance
// 0.4200 ohm, nominal melting I2t 0.0824 A2s (p2).
#[doc("docs/littelfuse-451.evidence.md")]
pub device Fuse_451_0A5 {
    pins {
        required A: 1 [passive]
        required B: 2 [passive]
    }
    spec {
        current_rating: 500mA
        voltage_rating: 125V
    }
}

impl TwoTerminal for Fuse_451_0A5 {}
impl Fuse for Fuse_451_0A5 {}

#[doc("docs/littelfuse-451.evidence.md")]
pub part FUSE_451_0A5: Fuse_451_0A5 {
    primary { mfr: "Littelfuse", mpn: "0451.500MRL", footprint: FP_LITTELFUSE_NANO2 }
}

