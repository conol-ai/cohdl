// Xinluda XL9555: 16-bit I2C-bus/SMBus I/O port expander with interrupt
// output, 2.3-5.5V (datasheet Rev 2.4, p1). Pin functions Table 2 (p3) —
// NOTE: pin numbers differ between SOP/SSOP/TSSOP and QFN packages, so this
// device uses package variants. XL9555 vs XL9535: identical pinout; XL9555
// adds a weak internal pull-up to VCC on each I/O (Table 2 note 1) — only
// XL9555 parts are modeled here.

#[doc("docs/xl9535-xl9555.pdf")]
pub device XL9555 {
    variants { SOP24, SSOP24, TSSOP24, QFN24 }
    pins[SOP24] {
        optional INT: 1 [output] // interrupt out, open-drain, needs pull-up (p3)
        required A1: 2 [input] // address strap — tie directly to VCC or GND (p3)
        required A2: 3 [input]
        optional P00: 4 [bidirectional]
        optional P01: 5 [bidirectional]
        optional P02: 6 [bidirectional]
        optional P03: 7 [bidirectional]
        optional P04: 8 [bidirectional]
        optional P05: 9 [bidirectional]
        optional P06: 10 [bidirectional]
        optional P07: 11 [bidirectional]
        required GND: 12 [power_in]
        optional P10: 13 [bidirectional]
        optional P11: 14 [bidirectional]
        optional P12: 15 [bidirectional]
        optional P13: 16 [bidirectional]
        optional P14: 17 [bidirectional]
        optional P15: 18 [bidirectional]
        optional P16: 19 [bidirectional]
        optional P17: 20 [bidirectional]
        required A0: 21 [input]
        required SCL: 22 [input] // I2C clock, pull-up to VCC (p3)
        required SDA: 23 [bidirectional] // I2C data, pull-up to VCC (p3)
        required VCC: 24 [power_in]
    }
    pins[SSOP24] {
        optional INT: 1 [output]
        required A1: 2 [input]
        required A2: 3 [input]
        optional P00: 4 [bidirectional]
        optional P01: 5 [bidirectional]
        optional P02: 6 [bidirectional]
        optional P03: 7 [bidirectional]
        optional P04: 8 [bidirectional]
        optional P05: 9 [bidirectional]
        optional P06: 10 [bidirectional]
        optional P07: 11 [bidirectional]
        required GND: 12 [power_in]
        optional P10: 13 [bidirectional]
        optional P11: 14 [bidirectional]
        optional P12: 15 [bidirectional]
        optional P13: 16 [bidirectional]
        optional P14: 17 [bidirectional]
        optional P15: 18 [bidirectional]
        optional P16: 19 [bidirectional]
        optional P17: 20 [bidirectional]
        required A0: 21 [input]
        required SCL: 22 [input]
        required SDA: 23 [bidirectional]
        required VCC: 24 [power_in]
    }
    pins[TSSOP24] {
        optional INT: 1 [output]
        required A1: 2 [input]
        required A2: 3 [input]
        optional P00: 4 [bidirectional]
        optional P01: 5 [bidirectional]
        optional P02: 6 [bidirectional]
        optional P03: 7 [bidirectional]
        optional P04: 8 [bidirectional]
        optional P05: 9 [bidirectional]
        optional P06: 10 [bidirectional]
        optional P07: 11 [bidirectional]
        required GND: 12 [power_in]
        optional P10: 13 [bidirectional]
        optional P11: 14 [bidirectional]
        optional P12: 15 [bidirectional]
        optional P13: 16 [bidirectional]
        optional P14: 17 [bidirectional]
        optional P15: 18 [bidirectional]
        optional P16: 19 [bidirectional]
        optional P17: 20 [bidirectional]
        required A0: 21 [input]
        required SCL: 22 [input]
        required SDA: 23 [bidirectional]
        required VCC: 24 [power_in]
    }
    pins[QFN24] {
        // QFN24 numbering (Table 2 QFN column) + exposed thermal pad.
        optional P00: 1 [bidirectional]
        optional P01: 2 [bidirectional]
        optional P02: 3 [bidirectional]
        optional P03: 4 [bidirectional]
        optional P04: 5 [bidirectional]
        optional P05: 6 [bidirectional]
        optional P06: 7 [bidirectional]
        optional P07: 8 [bidirectional]
        required GND: 9 [power_in] // must connect (Table 2 note 2)
        optional P10: 10 [bidirectional]
        optional P11: 11 [bidirectional]
        optional P12: 12 [bidirectional]
        optional P13: 13 [bidirectional]
        optional P14: 14 [bidirectional]
        optional P15: 15 [bidirectional]
        optional P16: 16 [bidirectional]
        optional P17: 17 [bidirectional]
        required A0: 18 [input]
        required SCL: 19 [input]
        required SDA: 20 [bidirectional]
        required VCC: 21 [power_in]
        optional INT: 22 [output]
        required A1: 23 [input]
        required A2: 24 [input]
        // Exposed thermal pad — must be soldered to board ground (note 2).
        required EPAD: Y [power_in]
    }
}

impl IC for XL9555 {}

// Device-only: the datasheet gives package outlines but no recommended PCB
// lands for any package. The former TSSOP and QFN parts were inferred from
// those outlines; do not publish purchasable bindings until Xinluda supplies
// authoritative land/paste/via data or a separately reviewed IPC derivation.
