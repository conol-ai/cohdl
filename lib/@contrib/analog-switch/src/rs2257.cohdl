// Run-IC RS2257: ultra-low ON-resistance (0.6ohm typ), low-voltage SPDT
// analog switch, 1.8-5.5V, break-before-make, 30MHz bandwidth (datasheet
// RevC.1). Pin definition p1 (vision-verified); package outlines p10-11.
// SOT363(SC70-6) and SOT23-6 share the same pin numbering.

#[doc("docs/rs2257.pdf")]
pub device RS2257 {
    pins {
        required NO: 1 [passive] // normally-open terminal (p1 pin table)
        required GND: 2 [power_in]
        required NC: 3 [passive] // normally-closed terminal (p1)
        required COM: 4 [passive] // common terminal (p1)
        required VPLUS: 5 [power_in] // positive supply, 1.8-5.5V (p1)
        required IN: 6 [input] // digital control: 0=NC ON, 1=NO ON (p1 function table)
    }
}

impl IC for RS2257 {}

#[doc("docs/rs2257.pdf")]
pub part SW_RS2257XH: RS2257 {
    primary { mfr: "Run-IC", mpn: "RS2257XH", footprint: SOT6P95X290X160N }
}

#[doc("docs/rs2257.pdf")]
pub part SW_RS2257XC6: RS2257 {
    primary { mfr: "Run-IC", mpn: "RS2257XC6", footprint: SOT6P65X210X125N }
}

// SOT23-6 manufacturer-recommended land pattern (datasheet p11), rotated
// 90 degrees here: 0.99 x 0.69 mm lands, 0.95 mm pitch, and 2.59 mm
// between opposing row centres. Pin 1 is upper-left in top view, CCW.
pub pad P_RS2257_SOT236_LEAD {
    shape: rect
    size: (0.99mm, 0.69mm)
    layer: top_copper
    plating: smd
}

pub footprint SOT6P95X290X160N {
    pad 1: P_RS2257_SOT236_LEAD at (-1.295mm, -0.95mm)
    pad 2: P_RS2257_SOT236_LEAD at (-1.295mm, 0mm)
    pad 3: P_RS2257_SOT236_LEAD at (-1.295mm, 0.95mm)
    pad 4: P_RS2257_SOT236_LEAD at (1.295mm, 0.95mm)
    pad 5: P_RS2257_SOT236_LEAD at (1.295mm, 0mm)
    pad 6: P_RS2257_SOT236_LEAD at (1.295mm, -0.95mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 3.6mm) }
    silkscreen_ref { at: (0mm, -2.2mm) }
}

// SOT363 (SC70-6) manufacturer-recommended land pattern (datasheet p10),
// rotated 90 degrees here: 0.75 x 0.40 mm lands, 0.65 mm pitch, and
// 1.90 mm between opposing row centres.
pub pad P_RS2257_SC706_LEAD {
    shape: rect
    size: (0.75mm, 0.4mm)
    layer: top_copper
    plating: smd
}

pub footprint SOT6P65X210X125N {
    pad 1: P_RS2257_SC706_LEAD at (-0.95mm, -0.65mm)
    pad 2: P_RS2257_SC706_LEAD at (-0.95mm, 0mm)
    pad 3: P_RS2257_SC706_LEAD at (-0.95mm, 0.65mm)
    pad 4: P_RS2257_SC706_LEAD at (0.95mm, 0.65mm)
    pad 5: P_RS2257_SC706_LEAD at (0.95mm, 0mm)
    pad 6: P_RS2257_SC706_LEAD at (0.95mm, -0.65mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (3.2mm, 2.7mm) }
    silkscreen_ref { at: (0mm, -1.7mm) }
}
