// Winbond W25Q128JV: 128Mbit serial flash, SPI/QSPI, 2.7-3.6V (datasheet
// rev G, April 2019). SOIC-8 208-mil (package code S, p68). Pin config p6.

#[doc("docs/w25q128jv.pdf")]
pub device W25Q128JV {
    pins {
        optional CS: 1 [input] // chip select, active-low (p6)
        optional DO: 2 [bidirectional] // data out / IO1 (p6)
        optional WP: 3 [bidirectional] // write-protect / IO2, active-low (p6)
        required GND: 4 [power_in]
        optional DI: 5 [bidirectional] // data in / IO0 (p6)
        optional HOLD: 6 [bidirectional] // hold-or-reset / IO3, active-low (p6)
        optional CLK: 7 [input] // serial clock (p6)
        required VCC: 8 [power_in] // 2.7-3.6V (p6)
    }
}

impl IC for W25Q128JV {}

#[doc("docs/w25q128jv.pdf")]
pub part FLASH_W25Q128JVSIQ: W25Q128JV {
    primary { mfr: "Winbond", mpn: "W25Q128JVSIQ", footprint: SOIC8P127X528X195N }
}

// SOIC-8 208-mil land (datasheet p68): body D/E 5.28, pitch 1.27, lead b
// 0.42, A 1.95. Standard SOIC-8 gull-wing land.
pub pad P_SOIC8_LEAD {
    shape: rect
    size: (1.5mm, 0.55mm)
    layer: top_copper
    plating: smd
}

pub footprint SOIC8P127X528X195N {
    pad 1: P_SOIC8_LEAD at (-3.81mm, -1.905mm)
    pad 2: P_SOIC8_LEAD at (-3.81mm, -0.635mm)
    pad 3: P_SOIC8_LEAD at (-3.81mm, 0.635mm)
    pad 4: P_SOIC8_LEAD at (-3.81mm, 1.905mm)
    pad 5: P_SOIC8_LEAD at (3.81mm, 1.905mm)
    pad 6: P_SOIC8_LEAD at (3.81mm, 0.635mm)
    pad 7: P_SOIC8_LEAD at (3.81mm, -0.635mm)
    pad 8: P_SOIC8_LEAD at (3.81mm, -1.905mm)
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    courtyard { shape: rect, at: (0mm, 0mm), size: (7.4mm, 6.0mm) }
    silkscreen_ref { at: (0mm, -3.4mm) }
}
