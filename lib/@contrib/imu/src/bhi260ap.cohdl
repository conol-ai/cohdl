// Bosch Sensortec BHI260AP: 9-axis smart IMU (Fuser2 core + BMI260 6-axis),
// LGA-44 3.6 x 4.1 x 0.83 mm (datasheet p2). Pin table: p19-21 Table 1.
// Datasheet: BST-BHI260AP-DS000-02 rev 1.1, 2021-04-15.

#[doc("docs/bst-bhi260ap-ds000.pdf")]
pub device BHI260AP {
    pins {
        // Supplies (p19-21). VDD is the analog sensor supply (p20 pad 28);
        // VDDIO powers digital IO and the Fuser2 core (pads 7/12/42).
        required VDD: 28 [power_in]
        required VDDIO: 7, 12, 42 [power_in]
        required GND: 25, 26, 27 [power_in] // analog sensor ground
        required GNDIO: 17, 36 [power_in] // digital IO / Fuser2 ground
        // Voltage regulator output, needs external capacitor (p21 Figure 2
        // "Ext Cap" on pad 6).
        required VREG: 6 [power_out]
        // System control (p19-20)
        required RESETN: 9 [input] // reset, active low
        required HOSTBOOT: 3 [input] // boot mode select (host / standalone)
        // Host interface (p19-20). SPI: HSCX=SCK HSDX=MOSI HSDO=MISO HCSB=CS.
        // I2C: HSCX=SCL HSDX=SDA, HSDO=address select strap, HCSB must be
        // held high (p20 pad 34 note).
        required HSCX: 33 [input]
        required HSDX: 11 [bidirectional]
        required HSDO: 32 [bidirectional]
        required HCSB: 34 [input]
        optional HIRQ: 10 [output] // host interrupt (p19: "Output")
        // Master interface 1 (internal use with BMI260 per p21 note 1 wiring;
        // still bonded out, p20-21)
        optional M1SCX: 29 [output] // SPI SCK / I2C SCL, reset: output low
        optional M1SDX: 44 [bidirectional] // SPI MOSI / I2C SDA, reset: output low
        optional M1SDI: 43 [input] // SPI MISO
        // Master interface 2 (p19-20)
        optional M2SCX: 13 [output]
        optional M2SDX: 35 [bidirectional]
        optional M2SDI: 37 [input]
        // Master interface 3, I2C only (p19)
        optional M3SCL: 2 [output]
        optional M3SDA: 1 [bidirectional]
        // External QSPI flash interface (p19-20)
        optional QSPI_CLK: 5 [output]
        optional QSPI_CSN: 14 [output]
        optional QSPI_D0: 4 [bidirectional]
        optional QSPI_D1: 15 [bidirectional]
        optional QSPI_D2: 20 [bidirectional]
        optional QSPI_D3: 8 [bidirectional]
        // Master chip selects / GPIO (p20)
        optional MCSB1: 38 [bidirectional]
        optional MCSB2: 18 [bidirectional]
        optional MCSB3: 16 [bidirectional]
        optional MCSB4: 19 [bidirectional]
        // Sensor auxiliary (OIS) interface (p20-21), reset Hi-Z
        optional ASCX: 22 [output] // OIS clock / I2C SCL
        optional ASDX: 30 [bidirectional] // OIS MOSI / I2C SDA
        optional OCSB: 21 [output] // OIS chip select
        optional OSDO: 39 [input] // OIS MISO
        // Fuser2 debug (p20)
        optional JTAG_CLK: 23 [input]
        optional JTAG_DIO: 24 [bidirectional]
        // Reserved, internal sensor<->Fuser2 connections; do not connect
        // (p21 Table 1 note 1). Leave unconnected in designs (`nc`).
        optional RESV1: 41 [input] // internal IMU interrupt
        optional RESV2: 40 [input] // internal IMU interrupt
        optional RESV3: 31 [output] // internal IMU chip select, reset: output high
    }
}

impl IC for BHI260AP {}

#[doc("docs/bst-bhi260ap-ds000.pdf")]
pub part IMU_BHI260AP: BHI260AP {
    primary { mfr: "Bosch Sensortec", mpn: "BHI260AP",
              footprint: FP_Bosch_BHI260AP_LGA44_3_6x4_1mm }
}

// LGA-44 land, Figure 37 (p162): outer/inner ring pads are 0.35 x 0.20 mm
// rectangles ("0.35" and "0.2" chained dims, p162); left/right columns use
// this orientation directly, top/bottom rows rotate it by 90 degrees.
// Figure 37 additionally requires a 50 um soldermask frame around each of
// the 44 pads and shows 0.05 x 45 deg corner chamfers on selected pads;
// CoHDL cannot express either, so apply the mask expansion (and treat the
// 50 um chamfers as cosmetic) during layout.
pub pad P_BHI260AP_LGA_LAND {
    shape: rect
    size: (0.35mm, 0.2mm)
    layer: top_copper
    plating: smd
}

// BHI260AP LGA-44, 3.6 x 4.1 mm body (p159 Figure 33). Origin is the package
// centre; top view, numbering counter-clockwise from pad 1 at the upper left
// (p162 Figure 37; cross-checked against the p19 Figure 1 bottom view).
// Figure 37 is drawn +Y-up; Y is negated here for CoHDL/KiCad.
//
// Source dimensions (p162 unless noted): column centre spacing 3.17 mm,
// row centre spacing 3.67 mm, pad pitch 0.40 mm, pad 0.35 x 0.20 mm,
// inner-to-outer column edge gap 0.45 mm (=> inner columns at +/-0.785 mm),
// inner-to-outer row edge gap 0.30 mm (=> inner rows at +/-1.185 mm).
// The centre gap of the outer columns (pads 4-5 and 18-19) carries no
// printed dimension; it was measured from the figure raster against the
// four printed reference spans (129.9 px/mm, agreement +/-1%) as 0.47 mm
// centre-to-centre (pads at +/-0.235 mm).
pub footprint FP_Bosch_BHI260AP_LGA44_3_6x4_1mm {
    pad 1: P_BHI260AP_LGA_LAND at (-1.585mm, -1.435mm)
    pad 2: P_BHI260AP_LGA_LAND at (-1.585mm, -1.035mm)
    pad 3: P_BHI260AP_LGA_LAND at (-1.585mm, -0.635mm)
    pad 4: P_BHI260AP_LGA_LAND at (-1.585mm, -0.235mm)
    pad 5: P_BHI260AP_LGA_LAND at (-1.585mm, 0.235mm)
    pad 6: P_BHI260AP_LGA_LAND at (-1.585mm, 0.635mm)
    pad 7: P_BHI260AP_LGA_LAND at (-1.585mm, 1.035mm)
    pad 8: P_BHI260AP_LGA_LAND at (-1.585mm, 1.435mm)
    pad 9: P_BHI260AP_LGA_LAND at (-1mm, 1.835mm) rotate 90
    pad 10: P_BHI260AP_LGA_LAND at (-0.6mm, 1.835mm) rotate 90
    pad 11: P_BHI260AP_LGA_LAND at (-0.2mm, 1.835mm) rotate 90
    pad 12: P_BHI260AP_LGA_LAND at (0.2mm, 1.835mm) rotate 90
    pad 13: P_BHI260AP_LGA_LAND at (0.6mm, 1.835mm) rotate 90
    pad 14: P_BHI260AP_LGA_LAND at (1mm, 1.835mm) rotate 90
    pad 15: P_BHI260AP_LGA_LAND at (1.585mm, 1.435mm)
    pad 16: P_BHI260AP_LGA_LAND at (1.585mm, 1.035mm)
    pad 17: P_BHI260AP_LGA_LAND at (1.585mm, 0.635mm)
    pad 18: P_BHI260AP_LGA_LAND at (1.585mm, 0.235mm)
    pad 19: P_BHI260AP_LGA_LAND at (1.585mm, -0.235mm)
    pad 20: P_BHI260AP_LGA_LAND at (1.585mm, -0.635mm)
    pad 21: P_BHI260AP_LGA_LAND at (1.585mm, -1.035mm)
    pad 22: P_BHI260AP_LGA_LAND at (1.585mm, -1.435mm)
    pad 23: P_BHI260AP_LGA_LAND at (1mm, -1.835mm) rotate 90
    pad 24: P_BHI260AP_LGA_LAND at (0.6mm, -1.835mm) rotate 90
    pad 25: P_BHI260AP_LGA_LAND at (0.2mm, -1.835mm) rotate 90
    pad 26: P_BHI260AP_LGA_LAND at (-0.2mm, -1.835mm) rotate 90
    pad 27: P_BHI260AP_LGA_LAND at (-0.6mm, -1.835mm) rotate 90
    pad 28: P_BHI260AP_LGA_LAND at (-1mm, -1.835mm) rotate 90
    pad 29: P_BHI260AP_LGA_LAND at (-0.785mm, -0.8mm)
    pad 30: P_BHI260AP_LGA_LAND at (-0.785mm, -0.4mm)
    pad 31: P_BHI260AP_LGA_LAND at (-0.785mm, 0mm)
    pad 32: P_BHI260AP_LGA_LAND at (-0.785mm, 0.4mm)
    pad 33: P_BHI260AP_LGA_LAND at (-0.785mm, 0.8mm)
    pad 34: P_BHI260AP_LGA_LAND at (-0.4mm, 1.185mm) rotate 90
    pad 35: P_BHI260AP_LGA_LAND at (0mm, 1.185mm) rotate 90
    pad 36: P_BHI260AP_LGA_LAND at (0.4mm, 1.185mm) rotate 90
    pad 37: P_BHI260AP_LGA_LAND at (0.785mm, 0.8mm)
    pad 38: P_BHI260AP_LGA_LAND at (0.785mm, 0.4mm)
    pad 39: P_BHI260AP_LGA_LAND at (0.785mm, 0mm)
    pad 40: P_BHI260AP_LGA_LAND at (0.785mm, -0.4mm)
    pad 41: P_BHI260AP_LGA_LAND at (0.785mm, -0.8mm)
    pad 42: P_BHI260AP_LGA_LAND at (0.4mm, -1.185mm) rotate 90
    pad 43: P_BHI260AP_LGA_LAND at (0mm, -1.185mm) rotate 90
    pad 44: P_BHI260AP_LGA_LAND at (-0.4mm, -1.185mm) rotate 90
    silkscreen {
        pin_1_marker near pad 1 shape dot
    }
    // Body max 3.6 x 4.1 mm (+/-0.05, p159) plus 0.25 mm excess per side;
    // the datasheet prints no courtyard.
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 4.6mm) }
    silkscreen_ref { at: (0mm, -2.6mm) }
}
