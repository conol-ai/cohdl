// Vishay VSMY14940: 940nm high-speed IR emitting diode, GaAlAs surface
// emitter, side-view SMD 3.0 x 2.51 mm (datasheet doc 84209, Rev 1.6).
// 2 terminals: anode (+) and cathode (-). Package dims p5.

#[doc("docs/vsmy14940.pdf")]
pub device VSMY14940 {
    pins {
        required Cathode: 1 [passive] // repository diode convention; cathode mark, p5
        required Anode: 2 [passive] // opposite terminal, p5 polarity drawing
    }
}

impl Polarized for VSMY14940 {
    pins {
        Anode: Anode
        Cathode: Cathode
    }
}

impl Diode for VSMY14940 {}

#[doc("docs/vsmy14940.pdf")]
pub part IR_VSMY14940: VSMY14940 {
    primary { mfr: "Vishay", mpn: "VSMY14940", footprint: FP_VSMY14940_3P0X2P51mm }
}

// Side-view SMD land (datasheet p5): body 3.0 x 2.51, two terminals at
// bottom edges. Recommended copper is 0.90 mm tangential x 1.40 mm wide,
// with a 1.80 mm inner gap, hence pad centres at +/-1.35 mm.
pub pad P_VSMY14940_PAD {
    shape: rect
    size: (0.9mm, 1.4mm)
    layer: top_copper
    plating: smd
}

pub footprint FP_VSMY14940_3P0X2P51mm {
    pad 1: P_VSMY14940_PAD at (-1.35mm, 0mm)
    pad 2: P_VSMY14940_PAD at (1.35mm, 0mm)
    silkscreen {
        polarity_marker cathode_pin 1 shape band
    }
    // Contains both the 3.60 x 1.40 mm copper and 3.00 x 2.51 mm body,
    // with at least 0.25 mm excess on every side.
    courtyard { shape: rect, at: (0mm, 0mm), size: (4.1mm, 3.1mm) }
    silkscreen_ref { at: (0mm, -1.8mm) }
}
