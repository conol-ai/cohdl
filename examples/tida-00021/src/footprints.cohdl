// tida-00021 example footprints — the discrete power stage + interface header.

// Power SO-8 N-FET (Vishay/TI PowerPAK SO-8 class). IPC-7351 name: 8 leads,
// 1.27mm pitch, 6.0mm lead span, 1.75mm height, density N.
pub footprint SOIC8P127X600X175N {
    pad 1: P_SOIC_Lead at (-2.7mm, -1.905mm)
    pad 2: P_SOIC_Lead at (-2.7mm, -0.635mm)
    pad 3: P_SOIC_Lead at (-2.7mm, 0.635mm)
    pad 4: P_SOIC_Lead at (-2.7mm, 1.905mm)
    pad 5: P_SOIC_Lead at (2.7mm, 1.905mm)
    pad 6: P_SOIC_Lead at (2.7mm, 0.635mm)
    pad 7: P_SOIC_Lead at (2.7mm, -0.635mm)
    pad 8: P_SOIC_Lead at (2.7mm, -1.905mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (6.2mm, 5.4mm) }
    silkscreen_ref { at: (0mm, -3.2mm) }
}

// Shielded power inductor (~5x5mm), two lands at +/-2.0mm.
pub footprint FP_Ind_Pwr_5040 {
    pad 1: P_Ind_Pwr at (-2mm, 0mm)
    pad 2: P_Ind_Pwr at (2mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (5.6mm, 5.4mm) }
}

// 1x12 2.54mm header: VBAT, V5, V3R3, V5DRV, GND, VR_ON, VCLK, VDIO, ALERT,
// CPGOOD, VR_HOT, VCORE — the interface to the CPU/PCH and the input supply.
pub footprint FP_Header_1x12 {
    pad 1: P_Hdr254 at (-13.97mm, 0mm)
    pad 2: P_Hdr254 at (-11.43mm, 0mm)
    pad 3: P_Hdr254 at (-8.89mm, 0mm)
    pad 4: P_Hdr254 at (-6.35mm, 0mm)
    pad 5: P_Hdr254 at (-3.81mm, 0mm)
    pad 6: P_Hdr254 at (-1.27mm, 0mm)
    pad 7: P_Hdr254 at (1.27mm, 0mm)
    pad 8: P_Hdr254 at (3.81mm, 0mm)
    pad 9: P_Hdr254 at (6.35mm, 0mm)
    pad 10: P_Hdr254 at (8.89mm, 0mm)
    pad 11: P_Hdr254 at (11.43mm, 0mm)
    pad 12: P_Hdr254 at (13.97mm, 0mm)
    courtyard { shape: rect, at: (0mm, 0mm), size: (31.5mm, 2.6mm) }
    silkscreen_ref { at: (0mm, -2mm) }
}
