// USB Type-C receptacle, USB 2.0 only (16 contacts, HRO TYPE-C-31-M-12).
//
// Pad names verified against the KiCad official footprint
// Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12
// (pads A1 A4 A5 A6 A7 A8 A9 A12 B1 B4 B5 B6 B7 B8 B9 B12; the single KiCad
// shield pad `SH` becomes SH1..SH4 — CoHDL requires unique pad numbers, E806).

pub device USB_C_Receptacle_2_0 {
    pins {
        required GND: A1, A12, B1, B12 [power_in]
        required VBUS: A4, A9, B4, B9 [power_out] // the upstream source drives VBUS
        required CC1: A5 [passive]
        required CC2: B5 [passive]
        required DP: A6, B6 [bidirectional]
        required DN: A7, B7 [bidirectional]
        optional SBU1: A8 [passive]
        optional SBU2: B8 [passive]
        required SHIELD: SH1, SH2, SH3, SH4 [passive]
    }
}

impl Connector for USB_C_Receptacle_2_0 {}

pub part USB_C_HRO_TYPE_C_31_M_12: USB_C_Receptacle_2_0 {
    primary { mfr: "HRO", mpn: "TYPE-C-31-M-12", footprint: FP_USB_C_Receptacle_HRO_TYPE_C_31_M_12 }
}

// Infineon EZ-PD CCG6SF — single-port USB Type-C / USB-PD 3.0 port controller
// (Arm Cortex-M0, integrated CC Rp/Rd, VCONN FETs, VBUS provider load switch +
// protections, SBU/HS mux). 48-pin QFN. Pinout from datasheet 002-27161 Table 3.
pub device CCG6SF {
    pins {
        required VBUS_C: 1, 2, 3, 48 [power_in] // Type-C VBUS connector input
        required VBUS_P: 4, 5, 6, 7 [power_in] // VBUS provider input
        required VSYS: 8 [power_in]
        required VCCD: 9 [power_out]
        required VDDIO: 10 [power_in]
        required VDDD: 11 [power_out]
        required P3_3: 12 [bidirectional]
        required SCL_SCB1: 13 [bidirectional]
        required SWDIO: 14 [bidirectional]
        required SWDCLK: 15 [bidirectional]
        required SDA_SCB1: 16 [bidirectional]
        required INT_TBT: 17 [bidirectional]
        required DP_TOP: 18 [bidirectional]
        required DM_TOP: 19 [bidirectional]
        required DP_BOT: 20 [bidirectional]
        required DM_BOT: 21 [bidirectional]
        required DM_SYS: 22 [bidirectional]
        required DP_SYS: 23 [bidirectional]
        required UART_TX: 24 [bidirectional]
        required UART_RX: 25 [bidirectional]
        required INT_EC: 26 [bidirectional]
        required HPD: 27 [bidirectional]
        required SDA_SCB2: 28 [bidirectional]
        required SCL_SCB2: 29 [bidirectional]
        required P2_3: 30 [bidirectional]
        required P2_4: 31 [bidirectional]
        required SCL_SCB0: 32 [bidirectional]
        required SDA_SCB0: 33 [bidirectional]
        required XRES: 34 [input]
        required P3_0: 35 [bidirectional]
        required SDA_SCB3: 36 [bidirectional]
        required SCL_SCB3: 37 [bidirectional]
        required CSN: 38 [input]
        required CSP: 39 [input]
        required SBU2_SYS: 40 [bidirectional]
        required SBU1_SYS: 41 [bidirectional]
        required SBU1: 42 [bidirectional]
        required SBU2: 43 [bidirectional]
        required CC2: 44 [bidirectional]
        required V5V: 45 [power_in]
        required CC1: 46 [bidirectional]
        required VBUS_C_CTRL: 47 [output]
        required EP: 49 [passive] // exposed GND/thermal pad
    }
}

impl IC for CCG6SF {}

pub part TYPEC_CCG6SF: CCG6SF {
    primary { mfr: "Infineon", mpn: "CYPD6127-48LQXI", footprint: QFN48N40P600X600_1EP460X460 }
}
