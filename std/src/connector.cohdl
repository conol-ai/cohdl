// std/connector — Generic connectors, test points, and mounting holes.

use traits::{Connector, TestPoint, MountingHole}

// ── Pin headers ─────────────────────────────────────────────────────────────

// Generic 1xN pin header (2.54mm pitch)
pub device PinHeader1xN<N: int, pkg: Package = "HDR_254_1xN">: impl Connector {
    package: pkg
    pins {
        pin_bus!(P, 1, N)    // P[1]..P[N]
    }
}

// Generic 2xN dual-row header (2.54mm pitch)
pub device PinHeader2xN<N: int, pkg: Package = "HDR_254_2xN">: impl Connector {
    package: pkg
    pins {
        pin_bus!(P, 1, N * 2)
    }
}

// 1xN header at 1.27mm pitch (common for compact debug headers)
pub device PinHeader1xN_127<N: int, pkg: Package = "HDR_127_1xN">: impl Connector {
    package: pkg
    pins {
        pin_bus!(P, 1, N)
    }
}

// ── Test points ─────────────────────────────────────────────────────────────

// SMD test point
pub device TestPoint_SMD<pkg: Package = "TP_1MM">: impl TestPoint {
    package: pkg
    pins { TP: 1 }
}

// Through-hole test point loop
pub device TestPoint_TH<pkg: Package = "TP_TH_1MM">: impl TestPoint {
    package: pkg
    pins { TP: 1 }
}

// ── Mounting holes ──────────────────────────────────────────────────────────

// Non-plated mounting hole (no electrical net)
pub device MountingHole_NPTH<pkg: Package = "MH_3_2MM">: impl MountingHole {
    package: pkg
}

// Plated mounting hole (tied to ground)
pub device MountingHole_PTH<pkg: Package = "MH_PTH_3_2MM">: impl MountingHole {
    package: pkg
    pins { GND: 1 }
}

// ── Sub-circuits ────────────────────────────────────────────────────────────

// ARM 10-pin SWD header (standard Cortex Debug pinout)
// Pinout: 1=VCC, 2=SWDIO, 3=GND, 4=SWDCLK, 5=GND,
//         6=NC, 7=NC, 8=NC, 9=GND_DETECT, 10=RESET
pub fn swd_header_10pin(
    vcc:    Net,
    swdio:  Net,
    swdclk: Net,
    reset:  Net,
    gnd:    Net
) {
    inst hdr: PinHeader2xN<N: 5>
    net vcc:    hdr.P[1]
    net swdio:  hdr.P[2]
    net gnd:    hdr.P[3], hdr.P[5], hdr.P[9]
    net swdclk: hdr.P[4]
    // P[6], P[7], P[8] left unconnected (NC by standard)
    net reset:  hdr.P[10]
}

// UART 4-pin header (VCC, TX, RX, GND) — 2.54mm
pub fn uart_header(
    vcc: Net,
    tx:  Net,
    rx:  Net,
    gnd: Net
) {
    inst hdr: PinHeader1xN<N: 4>
    net vcc: hdr.P[1]
    net tx:  hdr.P[2]
    net rx:  hdr.P[3]
    net gnd: hdr.P[4]
}
