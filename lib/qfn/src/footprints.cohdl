// Richtek RT6150A/B datasheet and official V/W/U/XDFN2.5x2.5-10
// footprint drawing:
// https://www.richtek.com/assets/product_file/RT6150A=RT6150B/DS6150AB-04.pdf
//
// The official pattern uses 0.50mm pitch, 0.85x0.30mm perimeter lands,
// 3.30mm overall land span, and a 2.00x1.20mm exposed pad. The vendor
// pattern is rotated 90 degrees to match the datasheet pin view; vendor +Y
// is negated for CoHDL/KiCad.
pub pad P_QFN10N50P250X250_LEAD {
    shape: rect
    size: (0.85mm, 0.3mm)
    layer: top_copper
    plating: smd
}

pub pad P_QFN10N50P250X250_EP120X200 {
