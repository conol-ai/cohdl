// InvenSense T3902: bottom-port PDM digital MEMS microphone, multi-mode
// (low-power / standard / high-performance), 1.62-3.63V (datasheet
// DS-000357 rev 1.0). 3.5 x 2.65 x 0.98 mm surface-mount, 5 terminals +
// sound port. Pin config p10; land pattern p18.

#[doc("docs/t3902.pdf")]
pub device T3902 {
    pins {
        optional DATA: 1 [output] // PDM digital output (p10)
        optional SELECT: 2 [input] // L/R channel select: GND=right, VDD=left (p10)
        required GND: 3 [power_in]
        optional CLK: 4 [input] // PDM clock input (p10)
        required VDD: 5 [power_in] // 1.62-3.63V, 0.1uF close (p10)
    }
}

impl IC for T3902 {}

// No part declaration. The exact orderable code is MMICT3902-00-012, but its
// recommended footprint requires pin 3 to be a 1.625/1.025 mm annular GND land
// around a 0.5-1.0 mm acoustic hole, with no paste over that hole (Figures
// 14-16). CoHDL cannot yet express an SMD annulus or a per-pad paste exclusion;
// approximating it as a solid circular SMD pad would emit unsafe paste.
