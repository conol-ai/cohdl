// Infineon CCG6DF USB Type-C dual-port controller — 96-ball BGA, 6x6mm, 0.5mm
// pitch, 11x11 grid (datasheet 002-27161). RFC-021 IPC-7351 name. Ball
// designators A1..L11 (row I skipped). 90 signal/power/ground balls (Table 2)
// plus the 6 DNU balls D4/D5/E4/H4/H5/H6 (Fig 4) — physically present pads that
// carry no net (their device pins are optional, left unconnected). The 25
// unpopulated 11x11 positions have no ball and no pad.
pub footprint BGA96C50P11X11_600X600X100N {
    pad A1: P_BGA_Ball at (-2.5mm, -2.5mm)
    pad A2: P_BGA_Ball at (-2mm, -2.5mm)
