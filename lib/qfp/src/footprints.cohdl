}

// QFP50P1600X1600X160_100N is transcribed from STMicroelectronics DS9826 Rev 6,
// Figure 39, "Recommended footprint for LQFP100 package".
// The official land is 1.20x0.30mm at 0.50mm pitch.
pub pad P_LQFP100_Lead_H {
    shape: rect
    size: (1.2mm, 0.3mm)
    layer: top_copper
    plating: smd
}

pub pad P_LQFP100_Lead_V {
    shape: rect
    size: (0.3mm, 1.2mm)
    layer: top_copper
    plating: smd
}

