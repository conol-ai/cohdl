// ccg6sf-typec example pads — the discrete parts around the std::CCG6SF
// controller (the controller land + USB-C receptacle land live in std).

// 2512 (6.35x3.2mm) VBUS current-sense resistor terminal (5mOhm Rsense).
pub pad P_R2512 {
    shape: rect
    size: (1.6mm, 3.2mm)
    layer: top_copper
    plating: smd
}

// Power SO-8 (PowerPAK SO-8) N-FET lead — the external VBUS consumer NFET.
pub pad P_SOIC_Lead {
    shape: rect
    size: (1.55mm, 0.6mm)
    layer: top_copper
    plating: smd
}

// 2.54mm interface-header hole.
pub pad P_Hdr254 {
    shape: circle
    size: (1.7mm)
    layer: through_all
    plating: plated_through_hole
    drill: 1mm
}
