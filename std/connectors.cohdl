// USB Type-C receptacle, USB 2.0 only (16 contacts, HRO TYPE-C-31-M-12).
//
// Pad names verified against the KiCad official footprint
// Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12
// (pads A1 A4 A5 A6 A7 A8 A9 A12 B1 B4 B5 B6 B7 B8 B9 B12; the single KiCad
// shield pad `SH` becomes SH1..SH4 — CoHDL requires unique pad numbers, E806).

pub device USB_C_Receptacle_2_0 {
    pins {
        required GND: A1, A12, B1, B12 [power_in]
        required VBUS: A4, A9, B4, B9 [power_out] // the upstream source drives VBUS
        required CC1: A5 [passive]
        required CC2: B5 [passive]
        required DP: A6, B6 [bidirectional]
        required DN: A7, B7 [bidirectional]
        optional SBU1: A8 [passive]
        optional SBU2: B8 [passive]
        required SHIELD: SH1, SH2, SH3, SH4 [passive]
    }
}

impl Connector for USB_C_Receptacle_2_0 {}

pub part USB_C_HRO_TYPE_C_31_M_12: USB_C_Receptacle_2_0 {
    primary { mfr: "HRO", mpn: "TYPE-C-31-M-12", footprint: FP_USB_C_Receptacle_HRO_TYPE_C_31_M_12 }
}

// Infineon EZ-PD CCG6DF — DUAL-port USB Type-C / USB-PD 3.0 port controller
// (Arm Cortex-M0; two full Type-C ports, each with CC Rp/Rd, VCONN FETs, VBUS
// provider load switch + protections, SBU/HS mux). 96-ball BGA. Pinout from
// datasheet 002-27161 Table 2 (90 documented balls; the four VBUS_C/VBUS_P
// power groups and VSSD are multi-ball pins).
pub device CCG6DF {
    pins {
        required CC1_P0: B3 [bidirectional]
        required CC2_P0: B5 [bidirectional]
        required DP_SYS_P0: K11 [bidirectional]
        required DM_SYS_P0: J11 [bidirectional]
        required UART_TX_P0: H10 [bidirectional]
        required UART_RX_P0: G10 [bidirectional]
        required DP_BOT_P0: K10 [bidirectional]
        required DM_BOT_P0: J10 [bidirectional]
        required DM_TOP_P0: H11 [bidirectional]
        required DP_TOP_P0: G11 [bidirectional]
        required SBU2_P0: A4 [bidirectional]
        required SBU1_P0: A5 [bidirectional]
        required SBU1_SYS_P0: B6 [bidirectional]
        required SBU2_SYS_P0: A6 [bidirectional]
        required VBUS_C_CTRL_P0: A3 [output]
        required CSP_P0: A11 [input]
        required CSN_P0: A10 [input]
        required V5V_P0: B4 [power_in]
        required HPD_P0: F8 [bidirectional]
        required INT_TBT_P0: L9 [bidirectional]
        required CC1_P1: K5 [bidirectional]
        required CC2_P1: K3 [bidirectional]
        required DP_SYS_P1: L6 [bidirectional]
        required DM_SYS_P1: L5 [bidirectional]
        required UART_TX_P1: L4 [bidirectional]
        required UART_RX_P1: K6 [bidirectional]
        required DP_BOT_P1: K8 [bidirectional]
        required DM_BOT_P1: K7 [bidirectional]
        required DM_TOP_P1: L7 [bidirectional]
        required DP_TOP_P1: L8 [bidirectional]
        required SBU2_P1: A9 [bidirectional]
        required SBU1_P1: A8 [bidirectional]
        required SBU1_SYS_P1: B7 [bidirectional]
        required SBU2_SYS_P1: A7 [bidirectional]
        required VBUS_C_CTRL_P1: L3 [output]
        required CSP_P1: L11 [input]
        required CSN_P1: L10 [input]
        required V5V_P1: K4 [power_in]
        required HPD_P1: B8 [bidirectional]
        required INT_TBT_P1: H8 [bidirectional]
        required SDA_SCB1: K9 [bidirectional]
        required SCL_SCB1: H7 [bidirectional]
        required INT_EC: F11 [bidirectional]
        required P2_4: D10 [bidirectional]
        required SWDIO: G8 [bidirectional]
        required SWDCLK: F10 [bidirectional]
        required SDA_SCB2: E11 [bidirectional]
        required SCL_SCB2: E10 [bidirectional]
        required P2_3: E8 [bidirectional]
        required P2_5: D8 [bidirectional]
        required SCL_SCB0: D11 [bidirectional]
        required SDA_SCB0: C11 [bidirectional]
        required P3_0: B10 [bidirectional]
        required SDA_SCB3: B11 [bidirectional]
        required SCL_SCB3: B9 [bidirectional]
        required XRES: C10 [input]
        required VSYS: F4 [power_in]
        required VDDD: G7 [power_out]
        required VDDIO: F7 [power_in]
        required VCCD: E7 [power_out]
        required VBUS_C_P0: A1, A2, B1, B2, C1 [power_in]
        required VBUS_C_P1: J1, K1, K2, L1, L2 [power_in]
        required VBUS_P_P0: C2, D1, D2, E1, E2 [power_in]
        required VBUS_P_P1: G1, G2, H1, H2, J2 [power_in]
        required VSSD: D7, E5, E6, F1, F2, F5, F6, G4, G5, G6 [passive]
        // DNU balls (Fig 4): present pads, internally unconnected (leave nc).
        optional DNU_D5: D5 [passive]
        optional DNU_D6: D6 [passive]
        optional DNU_E4: E4 [passive]
        optional DNU_H4: H4 [passive]
        optional DNU_H5: H5 [passive]
        optional DNU_H6: H6 [passive]
    }
}

impl IC for CCG6DF {}

pub part TYPEC_CCG6DF: CCG6DF {
    primary { mfr: "Infineon", mpn: "CYPD6227-96BZXI", footprint: BGA96C50P11X11_600X600X100N }
}
