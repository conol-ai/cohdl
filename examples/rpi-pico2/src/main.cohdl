// Raspberry Pi Pico 2 — a CoHDL implementation of the RP2350A board.
//
// Transcribed from the Raspberry Pi Pico 2 datasheet (Appendix B, Figure 11):
// USB-C power/data (HRO TYPE-C-31-M-12, UFP with 5.1k CC pulldowns,
// USBLC6 ESD — the same front-end as the openmicro board), RT6150 buck-boost 3V3 rail, RP2350A with its on-chip
// core regulator, 4 MiB QSPI flash, 12 MHz crystal, BOOTSEL button, user LED,
// SWD header, and the 40-pin castellated GPIO edge. Device pinouts and part
// bindings live in pico_parts.cohdl.

design Pico2 {
    // ---- major devices ----
    inst mcu: RP2350A_QFN60
    inst reg: BUCKBOOST_RT6150B
    inst flash: FLASH_W25Q32
    #[placement_hint("close to XIN/XOUT with short, guarded traces")]
    inst xtal: XTAL_12MHZ
    #[placement_hint("board edge, USB-C cutout")]
    inst usb: USB_C_HRO_TYPE_C_31_M_12
    inst esd: ESD_USBLC6
    inst hdr: HEADER_40W
    inst swd: HEADER_SWD_3W
    inst boot: BOOTSEL_SW
    inst led: LED_GREEN
    inst d_vbus: SCHOTTKY_PMEG6010
    inst q_vsys: FET_DMG1012T
    inst l_reg: IND_2U2
    inst l_core: IND_3U3

    // ---- discrete R/C ----
    inst r_led: passive::R_470R_F_0201
    inst r_dp: passive::R_27R_F_0201
    inst rcc1: passive::R_5K1_F_0402
    inst rcc2: passive::R_5K1_F_0402
    inst r_dm: passive::R_27R_F_0201
    inst r_xosc: passive::R_1K_F_0402
    inst r_boot: passive::R_1K_F_0402
    inst r_swclk: passive::R_100R_F_0201
    inst r_swdio: passive::R_100R_F_0201
    inst r_en: passive::R_100K_F_0201
    inst r_ps: passive::R_100K_F_0201
    inst r_vbus_top: passive::R_5K6_F_0201
    inst r_vbus_bot: passive::R_10K_F_0402
    inst r_vsys_top: passive::R_100K_F_0201
    inst r_vsys_mid: passive::R_100K_F_0201
    inst r_gpio29: passive::R_100K_F_0201
    inst r_vreg_avdd: passive::R_33R_F_0402
    inst r_vref: passive::R_200R_F_0402
    inst r_avdd: passive::R_1R_F_0201
    inst c_xin: passive::C_15p_25V_C0G_0201
    inst c_xout: passive::C_15p_25V_C0G_0201
    inst c_vsysdiv: passive::C_1n_25V_X7R_0201
    inst c_adc: passive::C_4u7_6V3_X5R_0402
    inst c_vreg_avdd: passive::C_4u7_6V3_X5R_0402

    // ---- power in: USB VBUS -> Schottky -> VSYS -> RT6150 buck-boost -> 3V3 ----
    #[intent("USB-C VBUS is 5V (5.1k Rd pulldowns advertise a UFP sink); the Schottky reverse-blocks so an external VSYS supply cannot backfeed the host")]
    #[high_current(500mA)]
    net VBUS [5V]: usb.VBUS, esd.VBUS, d_vbus.Anode, r_vbus_top.A, hdr.VBUS
    net VBUS_SENSE: r_vbus_top.B, r_vbus_bot.A, mcu.GPIO24
    net VSYS [5V]: d_vbus.Cathode, reg.VIN, r_en.A, r_vsys_top.A, hdr.VSYS

    #[intent("RT6150 buck-boost: any VSYS from 1.8-5.5V yields a stable 3.3V, so the board runs off USB or a single Li-ion cell")]
    net V3V3_EN: reg.EN, r_en.B, hdr.V3V3_EN
    net REG_LX1: reg.LX1, l_reg.A
    net REG_LX2: reg.LX2, l_reg.B
    net REG_PS: reg.PS, mcu.GPIO23, r_ps.A
    net V3V3 [3.3V]: reg.VOUT, reg.FB, mcu.IOVDD, mcu.QSPI_IOVDD, mcu.USB_OTP_VDD, mcu.VREG_VIN,
                     flash.VCC, hdr.V3V3, q_vsys.Gate, r_vreg_avdd.A, r_vref.A

    // ---- RP2350 on-chip core regulator: 3V3 -> switched 1V1 core rail ----
    net CORE_LX: mcu.VREG_LX, l_core.A
    net V1V1 [1.1V]: l_core.B, mcu.DVDD, mcu.VREG_FB

    // ---- USB 1.1 data: receptacle -> ESD array -> 27R series -> RP2350 ----
    net USBC_DP: usb.DP, esd.IO1_A
    net USB_DP: esd.IO1_B, r_dp.A
    net USB_DPX: r_dp.B, mcu.USB_DP
    net USBC_DM: usb.DN, esd.IO2_A
    net USB_DM: esd.IO2_B, r_dm.A
    net USB_DMX: r_dm.B, mcu.USB_DM
    // USB-C CC pulldowns (5.1k Rd — advertise a UFP/device sink)
    net CC1: usb.CC1, rcc1.A
    net CC2: usb.CC2, rcc2.A
    nc: usb.SBU1, usb.SBU2

    // ---- 12 MHz crystal with 15pF loads and a 1k XOUT series resistor ----
    net XIN: mcu.XIN, xtal.XIN, c_xin.A
    net XOUT: mcu.XOUT, r_xosc.A
    net XR: r_xosc.B, xtal.XOUT, c_xout.A

    // ---- QSPI to the XIP flash; QSPI_SS is also the BOOTSEL strap ----
    net QSPI_SS: mcu.QSPI_SS, flash.CS, r_boot.A
    net QSPI_SCLK: mcu.QSPI_SCLK, flash.SCLK
    net QSPI_SD0: mcu.QSPI_SD0, flash.SD0
    net QSPI_SD1: mcu.QSPI_SD1, flash.SD1
    net QSPI_SD2: mcu.QSPI_SD2, flash.SD2
    net QSPI_SD3: mcu.QSPI_SD3, flash.SD3
    #[intent("holding BOOTSEL at power-up pulls QSPI_SS low, so the RP2350 enters USB mass-storage bootloader instead of running flash")]
    net BOOTSEL: r_boot.B, boot.A

    // ---- SWD debug (100R series) + RUN reset on the header ----
    net SWCLK: mcu.SWCLK, r_swclk.A
    net SWCLK_H: r_swclk.B, swd.SWCLK
    net SWDIO: mcu.SWDIO, r_swdio.A
    net SWDIO_H: r_swdio.B, swd.SWDIO
    net RUN: mcu.RUN, hdr.RUN

    // ---- user LED on GPIO25 ----
    net LED_A: mcu.GPIO25, r_led.A
    net LED_K: r_led.B, led.Anode

    // ---- VSYS/3 ADC monitor, isolated by Q1 when 3V3 is off ----
    net VSYS_DIV: r_vsys_top.B, r_vsys_mid.A, c_vsysdiv.A, q_vsys.Drain
    net GPIO29_MON: q_vsys.Source, mcu.GPIO29, r_gpio29.A

    // ---- ADC reference filter: 3V3 -> 200R -> ADC_VREF -> 1R -> ADC_AVDD ----
    net ADC_VREF: r_vref.B, r_avdd.A, hdr.ADC_VREF
    net ADC_AVDD: r_avdd.B, mcu.ADC_AVDD, c_adc.A
    net VREG_AVDD: r_vreg_avdd.B, mcu.VREG_AVDD, c_vreg_avdd.A

    // ---- ground (analog ground ties to the digital plane at the header) ----
    #[ground(primary)]
    net GND [gnd]: mcu.GND, mcu.VREG_PGND, reg.GND, flash.GND, xtal.GND, usb.GND, usb.SHIELD,
                   esd.GND, rcc1.B, rcc2.B, swd.GND, boot.B, led.Cathode, hdr.GND, hdr.AGND,
                   r_vbus_bot.B, r_ps.B, r_vsys_mid.B, r_gpio29.B, c_xin.B, c_xout.B, c_vsysdiv.B,
                   c_adc.B, c_vreg_avdd.B

    // ---- GPIO breakout to the 40-pin castellated header ----
    net GP0: mcu.GPIO0, hdr.GP0
    net GP1: mcu.GPIO1, hdr.GP1
    net GP2: mcu.GPIO2, hdr.GP2
    net GP3: mcu.GPIO3, hdr.GP3
    net GP4: mcu.GPIO4, hdr.GP4
    net GP5: mcu.GPIO5, hdr.GP5
    net GP6: mcu.GPIO6, hdr.GP6
    net GP7: mcu.GPIO7, hdr.GP7
    net GP8: mcu.GPIO8, hdr.GP8
    net GP9: mcu.GPIO9, hdr.GP9
    net GP10: mcu.GPIO10, hdr.GP10
    net GP11: mcu.GPIO11, hdr.GP11
    net GP12: mcu.GPIO12, hdr.GP12
    net GP13: mcu.GPIO13, hdr.GP13
    net GP14: mcu.GPIO14, hdr.GP14
    net GP15: mcu.GPIO15, hdr.GP15
    net GP16: mcu.GPIO16, hdr.GP16
    net GP17: mcu.GPIO17, hdr.GP17
    net GP18: mcu.GPIO18, hdr.GP18
    net GP19: mcu.GPIO19, hdr.GP19
    net GP20: mcu.GPIO20, hdr.GP20
    net GP21: mcu.GPIO21, hdr.GP21
    net GP22: mcu.GPIO22, hdr.GP22
    net GP26: mcu.GPIO26, hdr.GP26
    net GP27: mcu.GPIO27, hdr.GP27
    net GP28: mcu.GPIO28, hdr.GP28

    // ---- decoupling: 100nF at each supply pin, 4.7uF/47uF bulk on the rails ----
    bulk_47u(reg.VIN, reg.GND)
    bulk_47u(reg.VOUT, reg.GND)
    bulk_4u7(mcu.DVDD, mcu.GND)
    bulk_4u7(flash.VCC, flash.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.QSPI_IOVDD, mcu.GND)
    passive::decoupling_100n(mcu.DVDD, mcu.GND)
    passive::decoupling_100n(mcu.DVDD, mcu.GND)
    passive::decoupling_100n(flash.VCC, flash.GND)

    // ---- layout constraints for the partner layout tool (RFC-013) ----
    layout {
        net_class HighSpeed { USBC_DP, USBC_DM, USB_DP, USB_DM, USB_DPX, USB_DMX }
        diff_pair(USBC_DP,
                  USBC_DM) [differential_impedance: 100ohm, single_ended_impedance: 50ohm, frequency: 1GHz]
        diff_pair(USB_DPX,
                  USB_DMX) [differential_impedance: 100ohm, single_ended_impedance: 50ohm, frequency: 1GHz]
        length_match(USB_DPX, USB_DMX) [tolerance: 0.15mm]
        net_class Clock { XIN, XR }
        // Raspberry Pi Pico 2 board outline (51 x 21 mm rounded rectangle),
        // extracted from the DXF's Edge.Cuts layer (RFC-020) — the single
        // closed perimeter the layout partner (Quilter) seeds placement against.
        board_outline: "mechanical/pico2-outline.dxf"
        // Interface ports are pre-positioned (locked) at their board-edge
        // locations, oriented; the layout partner places the rest around them.
        // The 40-pin castellated header IS the board edge — centered.
        place hdr at (0mm, 0mm)
        // USB-C at the left short edge, mouth facing OUTWARD (-x). Per the
        // HRO datasheet's recommended layout, the PCB EDGE line sits 1.86mm
        // from the footprint origin on the mouth side (positioning holes
        // 4.46mm from the edge; the shell front overhangs the edge by ~1.8mm
        // so a plug seats fully). rotate 270 turns that +y edge side to -x:
        // origin at -25.5 + 1.86 = -23.64.
        place usb at (-23.64mm, 0mm) rotate 270
        // ESD array tight to the receptacle, on the USB2 path to the MCU.
        place esd at (-13mm, 0mm)
        // 3-pin SWD debug header at the right short edge.
        place swd at (22mm, 0mm) rotate 90

        // The oscillator is timing-critical: its placement determines whether
        // the 12 MHz clock starts and stays clean, so we seed the MCU and its
        // crystal + load caps as a locked cluster rather than let the layout
        // partner scatter them. The RP2350A's XIN/XOUT (pins 21/22) sit on the
        // QFN's +y edge, so the crystal group sits just above the MCU with the
        // shortest reach to those pins; c_xin/c_xout flank the crystal (each is
        // one 15 pF load-cap terminal to GND) and are rotated vertical so their
        // terminals face the crystal's XIN/XOUT pads for a short, direct join.
        // The two caps sit on opposite sides of the crystal, so they are
        // mirrored (90 vs 270) — same orientation would leave the right cap
        // upside-down relative to the left. The series resistor r_xosc stays
        // partner-placed, guided by `net_class Clock { XIN, XR }` above.
        place mcu at (0mm, -2mm)
        place xtal at (0mm, 5mm)
        place c_xin at (-4mm, 5mm) rotate 90
        place c_xout at (4mm, 5mm) rotate 270
    }
}
